#!/usr/bin/env python3
"""Generate the Codex skill copies in .agents/skills/ from upstream/claude-workforce.

Each skill gets the cwf- prefix so it stays apart from claude-workforce's copies. Claude-only
frontmatter keys are dropped, and listed text replacements are applied. A replacement whose
source text is no longer in upstream fails the build, so a re-sync can't silently leave Claude
terms behind.

Usage: scripts/build-skills        (run after scripts/sync-upstream)
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UP = os.path.join(ROOT, "upstream", "claude-workforce", "workforce", "skills")
OUT = os.path.join(ROOT, ".agents", "skills")

# Frontmatter keys the agentskills.io standard defines; everything else is dropped.
KEEP_KEYS = {"name", "description", "license", "compatibility", "metadata"}

SKILLS = {
    "blueprint": [
        ("plan/  docs/plans/  .claude/plans/  notes/plans/  docs/plan/",
         "plan/  docs/plans/  .codex-workforce/plans/  notes/plans/  docs/plan/"),
    ],
}


def build(name, replacements):
    with open(os.path.join(UP, name, "SKILL.md"), encoding="utf-8") as fh:
        text = fh.read()
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        raise SystemExit(f"{name}: no frontmatter")
    lines = []
    for line in m.group(1).splitlines():
        key = line.split(":", 1)[0].strip()
        if key == "name":
            lines.append(f"name: cwf-{name}")
        elif key in KEEP_KEYS:
            lines.append(line)
    body = text[m.end():]
    for old, new in replacements:
        if old not in body:
            raise SystemExit(f"{name}: upstream no longer contains {old[:50]!r}; update scripts/build-skills")
        body = body.replace(old, new)
    note = (f"\n<!-- Generated by scripts/build-skills from upstream/claude-workforce/workforce/"
            f"skills/{name}/SKILL.md. Edit the generator, not this file. -->\n")
    dest = os.path.join(OUT, f"cwf-{name}")
    os.makedirs(dest, exist_ok=True)
    with open(os.path.join(dest, "SKILL.md"), "w", encoding="utf-8") as fh:
        fh.write("---\n" + "\n".join(lines) + "\n---\n" + note + body)
    return os.path.join(dest, "SKILL.md")


def main():
    for name, reps in SKILLS.items():
        print("built", os.path.relpath(build(name, reps), ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
