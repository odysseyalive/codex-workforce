#!/usr/bin/env python3
"""cwf-model-catalog — make the shipped OpenRouter models selectable in Codex.

    cwf-model-catalog install [--config DIR] [--dry-run]
    cwf-model-catalog default MODEL [--config DIR] [--dry-run]
    cwf-model-catalog status  [--config DIR]
    cwf-model-catalog verify  [--config DIR]

`default` is the one command here that changes what sessions run on, so it is separate from
`install` and never runs automatically: a reinstall must not silently move a user's default
model. It sets `model` and `model_provider` together, because a model that only exists on
OpenRouter needs the provider that can reach it.

WHY A PROFILE, NOT THE MAIN CONFIG. Codex's `model_catalog_json` REPLACES the model
catalog rather than extending it, and `model_provider` sends every request for every model
to one provider. Writing either into `~/.codex/config.toml` would change how the user's
whole Codex install works — including models that need OpenAI sign-in. So this writes

    <config>/cwf-model-catalog.json      the shipped models, merged with any catalog the
                                         user already had, so nothing they had is lost
    <config>/openrouter.config.toml      a profile that selects OpenRouter and that catalog

and the models appear with `codex --profile openrouter`. Nothing is selected for them and
no default is changed. The one exception is a user who already routes to OpenRouter: there
the merged catalog is also pointed at from their main config, because that is what they
already chose.

THE API KEY IS NEVER WRITTEN. The provider entry names `OPENROUTER_API_KEY`; each user
exports their own. `verify` says so when the variable is unset rather than pretending.

Exit: 0 ok / 1 verify found a problem / 2 usage or unreadable input.
"""
import argparse
import json
import os
import shutil
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
SHIPPED = os.path.join(os.path.dirname(HERE), "model-catalog.json")
PROFILE = "openrouter"
PROFILE_FILE = PROFILE + ".config.toml"
MERGED = "cwf-model-catalog.json"
ENV_KEY = "OPENROUTER_API_KEY"
ALLOWED_MODALITIES = {"text", "image", "audio"}

PROVIDER_BLOCK = f"""[model_providers.openrouter]
name = "OpenRouter"
base_url = "https://openrouter.ai/api/v1"
env_key = "{ENV_KEY}"
wire_api = "responses"
"""

PROFILE_HEADER = f"""# Generated by cwf-model-catalog (codex-workforce). Re-run `cwf-model-catalog install`.
# Use with:  codex --profile {PROFILE}
# Set your own key first:  export {ENV_KEY}=sk-or-...
model_provider = "openrouter"
model_catalog_json = {{catalog}}
"""


def die(msg, code=2):
    print(f"cwf-model-catalog: {msg}", file=sys.stderr)
    sys.exit(code)


def config_dir(arg):
    return os.path.abspath(arg or os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex")))


def load_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        die(f"cannot read {path}: {exc}")


def validate(models):
    """Refuse to ship a catalog Codex would reject at startup."""
    problems = []
    seen = set()
    for m in models:
        mid = m.get("id")
        if not mid:
            problems.append("an entry has no id")
            continue
        if mid in seen:
            problems.append(f"{mid}: duplicate id")
        seen.add(mid)
        bad = set(m.get("input_modalities") or []) - ALLOWED_MODALITIES
        if bad:
            problems.append(f"{mid}: invalid input modalities {sorted(bad)}")
        for key in ("model", "slug", "displayName", "context_window"):
            if key not in m:
                problems.append(f"{mid}: missing {key}")
    if problems:
        die("shipped catalog is invalid:\n  " + "\n  ".join(problems))
    return models


# Models a previous version shipped that cannot work in Codex. Listed here so a reinstall
# retires them instead of leaving them selectable and broken. Each needs its reason.
RETIRED = {
    # Codex sends `apply_patch` as a Responses tool of type "custom"; xAI's endpoint rejects
    # that with 422 "unknown variant `custom`" before the first token. The model itself
    # answers fine on /chat/completions and on a hand-built /responses body, so this is a
    # gap between the two sides, not a dead model.
    "x-ai/grok-4.6": "Codex sends a `custom` apply_patch tool xAI rejects (422)",
}


def merge(existing, shipped):
    """Shipped entries win on id; the user's other entries are kept.

    A retired id is dropped even if the user's catalog still carries it, because leaving it
    selectable would offer a model every request fails on.
    """
    out = {m.get("id"): m for m in existing if m.get("id") not in RETIRED}
    for m in shipped:
        out[m["id"]] = m
    ranked = sorted(out.values(), key=lambda m: (m.get("priority", 10_000), str(m.get("id"))))
    return ranked


def existing_catalog(paths):
    for p in paths:
        if p and os.path.isfile(p):
            data = load_json(p)
            if isinstance(data, dict) and isinstance(data.get("models"), list):
                return p, data["models"]
    return None, []


def current_catalog_path(config_dir_path):
    """The path the user's config already points at, if any."""
    cfg = os.path.join(config_dir_path, "config.toml")
    if not os.path.isfile(cfg):
        return None
    import re
    with open(cfg, encoding="utf-8") as fh:
        for line in fh:
            m = re.match(r'\s*model_catalog_json\s*=\s*"([^"]+)"', line)
            if m:
                return os.path.expanduser(m.group(1))
    return None


def routes_to_openrouter(config_dir_path):
    cfg = os.path.join(config_dir_path, "config.toml")
    if not os.path.isfile(cfg):
        return False
    with open(cfg, encoding="utf-8") as fh:
        for line in fh:
            if line.strip().replace(" ", "") in ('model_provider="openrouter"',):
                return True
    return False


def has_provider(config_dir_path):
    cfg = os.path.join(config_dir_path, "config.toml")
    if not os.path.isfile(cfg):
        return False
    with open(cfg, encoding="utf-8") as fh:
        text = fh.read()
    return "[model_providers.openrouter]" in text


def backup(path):
    if not os.path.exists(path):
        return None
    stamp = time.strftime("%Y%m%dT%H%M%S")
    dst = f"{path}.bak-{stamp}"
    shutil.copy2(path, dst)
    return dst


def install(args):
    conf = config_dir(args.config)
    os.makedirs(conf, exist_ok=True)
    shipped = validate(load_json(SHIPPED)["models"])

    active = current_catalog_path(conf)
    source, previous = existing_catalog([active, os.path.join(conf, MERGED)])
    models = merge(previous, shipped)

    merged_path = os.path.join(conf, MERGED)
    changed = True
    if os.path.isfile(merged_path):
        changed = load_json(merged_path).get("models") != models
    if args.dry_run:
        print(f"would write {merged_path}: {len(models)} models "
              f"(shipped {len(shipped)}, kept from {source or 'nothing'})")
    else:
        if changed:
            b = backup(merged_path)
            if b:
                print(f"backup: {b}")
            with open(merged_path, "w") as fh:
                json.dump({"models": models}, fh, indent=2)
                fh.write("\n")
        print(f"catalog: {merged_path} ({len(models)} models)")

    profile_path = os.path.join(conf, PROFILE_FILE)
    body = PROFILE_HEADER.format(catalog=json.dumps(merged_path))
    if not args.dry_run:
        if os.path.isfile(profile_path) and open(profile_path).read() != body:
            b = backup(profile_path)
            if b:
                print(f"backup: {b}")
        with open(profile_path, "w") as fh:
            fh.write(body)
        print(f"profile: {profile_path} (codex --profile {PROFILE})")

    cfg = os.path.join(conf, "config.toml")
    if routes_to_openrouter(conf):
        if not args.dry_run:
            _point_main_config_at(cfg, merged_path)
        print("main config already routes to OpenRouter: catalog pointed at the merged file")
    else:
        print(f"main config left alone; models are available with --profile {PROFILE}")

    if not has_provider(conf):
        if not args.dry_run:
            _append_provider(cfg)
        print(f"added [model_providers.openrouter] naming ${ENV_KEY}")
    if not os.environ.get(ENV_KEY):
        print(f"note: ${ENV_KEY} is not set in this shell; export your own key to use these models")
    return 0


def _append_provider(cfg):
    b = backup(cfg)
    if b:
        print(f"backup: {b}")
    existing = open(cfg, encoding="utf-8").read() if os.path.isfile(cfg) else ""
    with open(cfg, "w", encoding="utf-8") as fh:
        fh.write(existing)
        if existing and not existing.endswith("\n"):
            fh.write("\n")
        fh.write("\n" + PROVIDER_BLOCK)


def _point_main_config_at(cfg, merged_path):
    import re
    text = open(cfg, encoding="utf-8").read()
    line = f'model_catalog_json = {json.dumps(merged_path)}'
    if re.search(r'^\s*model_catalog_json\s*=', text, re.M):
        new = re.sub(r'^\s*model_catalog_json\s*=.*$', line, text, count=1, flags=re.M)
    else:
        # insert after the model_provider line so the top block stays together
        new = re.sub(r'^(\s*model_provider\s*=.*)$', r'\1\n' + line.replace('\\', r'\\'),
                     text, count=1, flags=re.M)
        if new == text:
            new = line + "\n" + text
    if new != text:
        b = backup(cfg)
        if b:
            print(f"backup: {b}")
        open(cfg, "w", encoding="utf-8").write(new)


def default(args):
    """Set the session's default model. Explicit and reversible; never run by install."""
    conf = config_dir(args.config)
    cfg = os.path.join(conf, "config.toml")
    if not os.path.isfile(cfg):
        die(f"no config.toml at {cfg}")
    if not os.path.isfile(SHIPPED):
        die(f"shipped catalog missing: {SHIPPED}")
    shipped = validate(load_json(SHIPPED)["models"])
    model = args.model
    if model not in {m["id"] for m in shipped}:
        die(f"{model} is not one of the shipped models; run `status` to see the set")
    if not has_provider(conf):
        die("no [model_providers.openrouter] block; run `install` first")

    text = open(cfg, encoding="utf-8").read()
    import re
    changes = []
    for key, value in (("model", model), ("model_provider", "openrouter")):
        line = f'{key} = {json.dumps(value)}'
        rx = re.compile(rf"^\s*{key}\s*=.*$", re.M)
        if rx.search(text):
            new_text = rx.sub(line, text, count=1)
        else:
            new_text = line + "\n" + text
        if new_text != text:
            changes.append(line)
            text = new_text
    if not changes:
        print(f"default already {model} via openrouter; nothing changed")
        return 0
    if args.dry_run:
        print("would set:\n  " + "\n  ".join(changes))
        return 0
    b = backup(cfg)
    if b:
        print(f"backup: {b}")
    open(cfg, "w", encoding="utf-8").write(text)
    print(f"default model: {model} (provider openrouter)")
    print(f"undo with: cwf-model-catalog default <previous-model>")
    return 0


def status(args):
    conf = config_dir(args.config)
    merged = os.path.join(conf, MERGED)
    profile = os.path.join(conf, PROFILE_FILE)
    print(f"config dir: {conf}")
    print(f"merged catalog: {'present' if os.path.isfile(merged) else 'MISSING'} ({merged})")
    print(f"profile: {'present' if os.path.isfile(profile) else 'MISSING'} ({profile})")
    print(f"main config routes to OpenRouter: {routes_to_openrouter(conf)}")
    cfg = os.path.join(conf, "config.toml")
    if os.path.isfile(cfg):
        import re
        for line in open(cfg, encoding="utf-8"):
            if re.match(r"\s*model\s*=", line):
                print(f"default model: {line.split('=', 1)[1].strip()}")
                break
    print(f"provider block present: {has_provider(conf)}")
    print(f"${ENV_KEY} set in this shell: {bool(os.environ.get(ENV_KEY))}")
    return 0


def verify(args):
    """Check the shipped catalog is what Codex would load, and that every id is in it."""
    conf = config_dir(args.config)
    shipped = validate(load_json(SHIPPED)["models"])
    merged = os.path.join(conf, MERGED)
    problems = []
    for mid, why in RETIRED.items():
        print(f"retired: {mid} — {why}")
    if not os.path.isfile(merged):
        problems.append(f"no merged catalog at {merged}; run install")
    else:
        ids = {m["id"] for m in load_json(merged)["models"]}
        for m in shipped:
            if m["id"] not in ids:
                problems.append(f"{m['id']} missing from the merged catalog")
    profile = os.path.join(conf, PROFILE_FILE)
    if not os.path.isfile(profile):
        problems.append(f"no profile at {profile}; run install")
    elif merged not in open(profile).read():
        problems.append("profile does not point at the merged catalog")
    if not has_provider(conf):
        problems.append("no [model_providers.openrouter] block in config.toml")
    for p in problems:
        print(f"FAIL {p}")
    if not problems:
        print(f"OK {len(shipped)} shipped models present; profile and provider configured")
    if os.environ.get(ENV_KEY):
        print(f"OK ${ENV_KEY} is set")
    else:
        print(f"note: ${ENV_KEY} is not set here — models will not answer until it is")
    return 1 if problems else 0


def main():
    ap = argparse.ArgumentParser(description="Expose the shipped OpenRouter models to Codex.")
    ap.add_argument("command", choices=("install", "default", "status", "verify"))
    ap.add_argument("model", nargs="?", help="the model id, for `default`")
    ap.add_argument("--config", help="Codex config dir (default: $CODEX_HOME or ~/.codex)")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    if not os.path.isfile(SHIPPED):
        die(f"shipped catalog missing: {SHIPPED}")
    if args.command == "default" and not args.model:
        die("usage: cwf-model-catalog default MODEL")
    return {"install": install, "default": default,
            "status": status, "verify": verify}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
