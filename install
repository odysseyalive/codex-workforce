#!/usr/bin/env bash
#
# codex-workforce installer (Linux / macOS)
#
# One command installs, and the same command updates:
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/odysseyalive/codex-workforce/main/install)"
#
# Scope (default: personal):
#   --user      one copy in ${CODEX_HOME:-~/.codex}/codex-workforce, hooks in ~/.codex/hooks.json,
#               skills in ~/.agents/skills. Serves every project on this machine.
#   --project   a copy inside the current git repository (.codex/codex-workforce), hooks in
#               .codex/hooks.json, skills in .agents/skills. Travels with the repo.
# Other flags:
#   --uninstall remove codex-workforce from the chosen scope (other hooks are kept)
#   --force     allow installing an older version over a newer one
#
# Windows: use install.ps1 instead:
#   irm https://raw.githubusercontent.com/odysseyalive/codex-workforce/main/install.ps1 | iex
#
# The shipped files are listed in manifest.txt (shared with install.ps1). Nothing is ever
# written under ~/.claude or .claude, so this installs beside claude-workforce safely.
#
# Test seam: install from a local checkout with no network:
#   CWF_REPO_URL="file://$PWD" ./install --user
set -euo pipefail

REPO_URL="${CWF_REPO_URL:-https://raw.githubusercontent.com/odysseyalive/codex-workforce/main}"
SCOPE="${CWF_SCOPE:-user}"
ACTION=install
FORCE=0

for arg in "$@"; do
  case "$arg" in
    --user) SCOPE=user ;;
    --project) SCOPE=project ;;
    --uninstall) ACTION=uninstall ;;
    --force) FORCE=1 ;;
    -h|--help) sed -n '2,25p' "$0" 2>/dev/null || true; exit 0 ;;
    *) echo "codex-workforce: unknown option: $arg" >&2; exit 2 ;;
  esac
done

say() { printf 'codex-workforce: %s\n' "$*"; }
die() { printf 'codex-workforce: %s\n' "$*" >&2; exit 1; }

# ── requirements ──────────────────────────────────────────────────────────────
PY="$(command -v python3 || true)"
[ -n "$PY" ] || die "python3 is required (the senses are Python 3 scripts)."
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' \
  || die "python3 3.8 or newer is required."
command -v git >/dev/null || die "git is required."
command -v curl >/dev/null || die "curl is required."
command -v codex >/dev/null || say "note: codex is not on PATH; install OpenAI Codex CLI to use this."

# ── where things go ───────────────────────────────────────────────────────────
if [ "$SCOPE" = project ]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "--project must be run inside a git repository."
  CONF_DIR="$ROOT/.codex"
  SKILLS_DIR="$ROOT/.agents/skills"
  INSTALL_DIR="$CONF_DIR/codex-workforce"
  # Resolved from the git root at run time, so the hook works wherever the repo is cloned.
  HOOK_BIN='$(git rev-parse --show-toplevel)/.codex/codex-workforce/cwf/bin/cwf-hook'
else
  CONF_DIR="${CODEX_HOME:-$HOME/.codex}"
  SKILLS_DIR="$HOME/.agents/skills"
  INSTALL_DIR="$CONF_DIR/codex-workforce"
  HOOK_BIN="$INSTALL_DIR/cwf/bin/cwf-hook"
fi
HOOKS_JSON="$CONF_DIR/hooks.json"

# ── hooks.json: add or remove only our own entries ───────────────────────────
# Our entries are recognised by their command running cwf-hook; every other hook in the
# file (yours, herdr's, anything) is left exactly as it was.
edit_hooks() {  # $1 = add | remove
  "$PY" - "$HOOKS_JSON" "$1" "$HOOK_BIN" <<'PYEOF'
import json, os, sys
path, mode, hook_bin = sys.argv[1], sys.argv[2], sys.argv[3]
data = {}
if os.path.exists(path):
    with open(path, encoding="utf-8") as fh:
        text = fh.read().strip()
    data = json.loads(text) if text else {}
hooks = data.setdefault("hooks", {})

def ours(handler):
    return "cwf-hook" in str(handler.get("command", ""))

for event in list(hooks):
    groups = []
    for group in hooks[event]:
        kept = [h for h in group.get("hooks", []) if not ours(h)]
        if kept:
            groups.append(dict(group, hooks=kept))
    if groups:
        hooks[event] = groups
    else:
        del hooks[event]

if mode == "add":
    win = hook_bin.replace("/", "\\")
    def handler(arg, timeout, **extra):
        h = {"type": "command",
             "command": f'python3 "{hook_bin}" {arg}',
             "commandWindows": f'py -3 "{win}" {arg}',
             "timeout": timeout}
        h.update(extra)
        return {"hooks": [h]}
    for event in ("UserPromptSubmit", "SubagentStart"):
        hooks.setdefault(event, []).append(handler("prompt", 30, additionalContextLimit=6000))
    hooks.setdefault("Stop", []).append(handler(
        "stop", 300, statusMessage="Checking the turn's claims against its evidence"))
    hooks.setdefault("SubagentStop", []).append(handler("stop", 300))

if not hooks:
    data.pop("hooks", None)
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".cwf-tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
os.replace(tmp, path)
PYEOF
}

read_version() { [ -f "$1" ] && tr -d '[:space:]' < "$1" || echo unknown; }

# Is dotted version $1 strictly older than $2?
version_is_older() {
  "$PY" -c 'import sys
a, b = ([int(x) for x in v.split(".")] for v in sys.argv[1:3])
sys.exit(0 if a < b else 1)' "$1" "$2" 2>/dev/null
}

# ── owned-path removal, shared by uninstall and the update prune ────────────
# A name must be a single plain component: a tampered list could otherwise name ../ paths
# and turn this into a recursive delete outside the skills or agents folder.
remove_skill() {
  if printf '%s' "$1" | grep -Eq '^cwf-[A-Za-z0-9._-]+$' && [ "${1#*..}" = "$1" ] \
     && [ ! -L "$SKILLS_DIR/$1" ]; then
    rm -rf "${SKILLS_DIR:?}/$1"
  fi
}
remove_agent() {
  if printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]+\.toml$' && [ "${1#*..}" = "$1" ] \
     && [ ! -L "$CONF_DIR/agents/$1" ]; then
    rm -f "${CONF_DIR:?}/agents/$1"
  fi
}
listed() { [ -f "$2" ] && grep -Fxq -- "$1" "$2"; }

# ── uninstall ────────────────────────────────────────────────────────────────
if [ "$ACTION" = uninstall ]; then
  # Only the skills and agents this installer put there, as recorded at install time.
  if [ -f "$INSTALL_DIR/installed-skills.txt" ]; then
    while IFS= read -r name; do remove_skill "$name"; done < "$INSTALL_DIR/installed-skills.txt"
  fi
  if [ -f "$INSTALL_DIR/installed-agents.txt" ]; then
    while IFS= read -r name; do remove_agent "$name"; done < "$INSTALL_DIR/installed-agents.txt"
  fi
  rm -rf "$INSTALL_DIR"
  [ -f "$HOOKS_JSON" ] && edit_hooks remove
  say "removed from $SCOPE scope ($INSTALL_DIR). Other hooks in $HOOKS_JSON were kept."
  exit 0
fi

# ── fetch ────────────────────────────────────────────────────────────────────
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
curl -fsSL "$REPO_URL/manifest.txt" -o "$STAGE/manifest.txt" || die "could not download manifest.txt from $REPO_URL"

INCOMING="unknown"
if curl -fsSL "$REPO_URL/VERSION" -o "$STAGE/VERSION.in" 2>/dev/null; then
  INCOMING="$(read_version "$STAGE/VERSION.in")"
fi
CURRENT="$(read_version "$INSTALL_DIR/VERSION")"
if [ "$FORCE" -eq 0 ] && [ "$INCOMING" != unknown ] && [ "$CURRENT" != unknown ] \
   && version_is_older "$INCOMING" "$CURRENT"; then
  die "this would downgrade $CURRENT to $INCOMING. Re-run with --force to do it anyway."
fi

while IFS= read -r path || [ -n "$path" ]; do
  case "$path" in ''|'#'*) continue ;; esac
  mkdir -p "$STAGE/files/$(dirname "$path")"
  curl -fsSL "$REPO_URL/$path" -o "$STAGE/files/$path" || die "could not download $path"
done < "$STAGE/manifest.txt"

# ── install ──────────────────────────────────────────────────────────────────
# READ THE OLD OWNERSHIP RECORDS BEFORE ANYTHING IS REPLACED (C0.9, review finding 7). The
# install dir is replaced whole below, and the records live inside it; read afterwards, they
# describe the NEW install, so a skill or agent the new manifest dropped would be orphaned
# and keep loading forever.
PRIOR_SKILLS="$STAGE/prior-skills.txt"; PRIOR_AGENTS="$STAGE/prior-agents.txt"
: > "$PRIOR_SKILLS"; : > "$PRIOR_AGENTS"
[ -f "$INSTALL_DIR/installed-skills.txt" ] && cp "$INSTALL_DIR/installed-skills.txt" "$PRIOR_SKILLS"
[ -f "$INSTALL_DIR/installed-agents.txt" ] && cp "$INSTALL_DIR/installed-agents.txt" "$PRIOR_AGENTS"

# Replace the install directory whole, so a file dropped from the manifest disappears.
# cwf/skills is not install-dir content: it is the visible SOURCE for <skills-root>/<name>/,
# and it is copied there below. Everything else under cwf/ ships into the install dir.
rm -rf "$INSTALL_DIR.cwf-new"
mkdir -p "$INSTALL_DIR.cwf-new" "$SKILLS_DIR"
for top in "$STAGE"/files/* ; do
  [ -e "$top" ] || continue
  cp -R "$top" "$INSTALL_DIR.cwf-new/"
done
rm -rf "$INSTALL_DIR.cwf-new/cwf/skills"
rm -rf "$INSTALL_DIR"
mv "$INSTALL_DIR.cwf-new" "$INSTALL_DIR"
chmod +x "$INSTALL_DIR"/cwf/bin/* "$INSTALL_DIR"/upstream/claude-workforce/workforce/bin/* 2>/dev/null || true

: > "$INSTALL_DIR/installed-skills.txt"
if [ -d "$STAGE/files/cwf/skills" ]; then
  for skill in "$STAGE"/files/cwf/skills/*; do
    name="$(basename "$skill")"
    rm -rf "${SKILLS_DIR:?}/$name"
    cp -R "$skill" "$SKILLS_DIR/$name"
    # The fetch drops file modes; a skill's documented resolver tests `[ -x ]` (C0.7).
    chmod +x "$SKILLS_DIR/$name"/bin/* 2>/dev/null || true
    echo "$name" >> "$INSTALL_DIR/installed-skills.txt"
  done
fi
# Custom agents are not skills: Codex discovers them only in .codex/agents/. Copy them
# into .codex/agents beside the hooks; they are not skills and must not be listed for
# skill uninstall.
#
# A SAME-NAMED AGENT THIS INSTALLER NEVER PLACED IS NOT OURS. Agent names carry no cwf-
# prefix on disk, so a user's own `content-classifier.toml` is possible. It is overwritten
# only when a previous install recorded placing it, or it is byte-identical to ours;
# otherwise it is left alone, not recorded, and so never deleted by an uninstall.
: > "$INSTALL_DIR/installed-agents.txt"
if [ -d "$STAGE/files/cwf/agents" ]; then
  mkdir -p "$CONF_DIR/agents"
  for agent in "$STAGE"/files/cwf/agents/*.toml; do
    [ -e "$agent" ] || continue
    name="$(basename "$agent")"
    dest="$CONF_DIR/agents/$name"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
      if [ -L "$dest" ] || { ! listed "$name" "$PRIOR_AGENTS" && ! cmp -s "$agent" "$dest"; }; then
        say "kept your own $dest; the shipped $name was not installed over it"
        continue
      fi
    fi
    cp "$agent" "$dest"
    echo "$name" >> "$INSTALL_DIR/installed-agents.txt"
  done
fi

# Prune what the previous install placed and this one no longer ships.
while IFS= read -r name; do
  listed "$name" "$INSTALL_DIR/installed-skills.txt" || remove_skill "$name"
done < "$PRIOR_SKILLS"
while IFS= read -r name; do
  if ! listed "$name" "$INSTALL_DIR/installed-agents.txt" \
     && [ ! -e "$STAGE/files/cwf/agents/$name" ]; then
    remove_agent "$name"
  fi
done < "$PRIOR_AGENTS"

edit_hooks add

# Make the shipped OpenRouter models selectable. This writes a profile and a merged catalog
# beside config.toml; it does not change the user's default model or provider. It never
# writes an API key — the provider names OPENROUTER_API_KEY and each user exports their own.
if [ -x "$INSTALL_DIR/cwf/bin/cwf-model-catalog" ]; then
  "$PY" "$INSTALL_DIR/cwf/bin/cwf-model-catalog" install --config "$CONF_DIR" \
    || say "note: the model catalog step failed; run cwf-model-catalog install by hand"
fi

if [ "$CURRENT" = unknown ]; then
  say "installed $INCOMING ($SCOPE scope) in $INSTALL_DIR"
elif [ "$CURRENT" = "$INCOMING" ]; then
  say "reinstalled $INCOMING ($SCOPE scope) in $INSTALL_DIR"
else
  say "updated $CURRENT -> $INCOMING ($SCOPE scope) in $INSTALL_DIR"
fi
say "hooks added to $HOOKS_JSON; skills in $SKILLS_DIR"
say "models: select the shipped OpenRouter set with: codex --profile openrouter"
say "        export OPENROUTER_API_KEY=sk-or-... first; the installer never writes your key"
# C0.8: say whether Codex will actually run the hooks just written. Trust is per definition
# hash, kept in the USER config.toml for both scopes, so a changed hook is skipped silently
# until it is re-trusted in /hooks.
if CODEX_HOME="${CODEX_HOME:-$HOME/.codex}" "$PY" "$INSTALL_DIR/cwf/bin/cwf-hook" trust-check "$HOOKS_JSON" >/dev/null 2>&1; then
  say "hooks: already trusted in Codex; nothing to re-trust"
else
  say "next: start codex, open /hooks and trust the codex-workforce hooks. They don't run until you do."
fi
