#!/usr/bin/env python3
"""wf-task-tag — classify the ask BEFORE the work, and name the sense that closes it.

WHY THIS EXISTS, and it is the half `wf-widen` could not do.

`wf-widen` reads the finished reply and infers a claim from prose. That is reactive and
it is a guess about what the turn was doing, made from the turn's own words — which is
the same surface the tunnel is built out of. It catches a reply that asserts something
is missing. It cannot catch a reply that reasons its way to a wrong answer without ever
asserting anything of that shape.

THE MEASURED MISS, this session. Asked to decide the fate of four scripts that live
procedures still called for, the operator read `audit-setup.md` and `invariants.md`,
saw live requirements, and concluded the scripts had to be restored. Wrong: the removal
was deliberate, on the user's explicit marks, and the record that says so had not been
read. No absence claim was made and no universal claim was made, so `wf-widen` was
silent and correct to be silent. **The TASK, though, was "decide the fate of a removed
mechanism," and that task cannot be closed without HEARING — the record's own
testimony.** A tag on the ask would have said so before a word of the answer was
written. A scan of the answer could not.

SO THE TAG IS SET AT THE FRONT. `UserPromptSubmit` fires before the prompt is
processed and can inject context, which is the only point in a turn where "which sense
does this need" arrives in time to change what the turn does rather than grade it after.

IT IS DETERMINISTIC, NOT A MODEL CALL. Every classification below is a regex over the
ask. That is the input-side discipline the rest of this distribution's newer mechanisms
follow, and it costs no tokens and no latency: a classifier that spends a model call on
every prompt to say "this one needs the web" has to be right very often to be worth it,
and nothing here has measured that it would be.

IT NAMES, IT NEVER BLOCKS. `decision: "block"` on this event erases the user's prompt.
Nothing about a sense classification justifies destroying an ask, and a tagger that can
swallow a prompt on a regex is a worse failure than every tunnel it prevents.

THE TAG IS ALSO WRITTEN TO DISK, so `wf-widen` at `Stop` scores against the tag the ask
carried rather than re-guessing from the reply. One classification, set once, read by
both ends of the turn.

EXIT CODES: 0 always. An unclassifiable ask is the common case and produces silence.
"""

import calendar
import hashlib
import json
import os
import re
import sys
import time

# ─────────────────────────────────────────────────────────────────────────────────
# TASK KINDS. Each row is (name, pattern, sense, why that sense and not another).
#
# These are the kinds whose WRONG ANSWER this project has actually produced and paid
# for. It is not a taxonomy of asks; it is a list of the ways work here has gone wrong,
# and it stays that length until another way is measured.
# TEXT THE USER DID NOT WRITE. `UserPromptSubmit` receives whatever is injected ahead of
# the turn — a skill's preamble, a continuation summary, a cross-session message, a stop
# hook's own feedback — and none of it is the ask.
#
# MEASURED 2026-09-10 over 1,909 real user prompts from this machine's transcripts:
# 586 (30.7%) are injected preamble, and 469 of them — 24.6% OF THE WHOLE CORPUS — are
# currently tagged. Tagged as: behaviour 344, existence 320, history 280, world 43. Every
# one puts a docket on a turn whose prompt the user never wrote, and the jury then judges
# the reply against a question nobody asked. A stop hook's own feedback tagging the next
# turn is the loop closing on itself.
#
# ANCHORED AT THE START, deliberately. A user who QUOTES one of these mid-message is still
# asking something, and their ask keeps its docket.
# IS THE USER ASKING, OR TELLING? Only `world` is gated on this, and the asymmetry is
# measured rather than tidy. An IMPERATIVE is exactly when `behaviour` matters most —
# "run the baseline test now" needs touch — so gating every kind on a question mark would
# suppress the sense at the moment it is most needed; 34.9% of `behaviour` fires carry no
# question and they are correct. `world` is the opposite: it asks whether the OUTSIDE
# WORLD is a certain way, and a user who states it is not asking, they are telling.
#
# MEASURED over 1,909 real prompts, after the INJECTED filter: `world` fires 13 times, 7
# ask something and 6 do not. The 6 are two error dumps and four instructions — including
# the one that produced this fix, *"those are deprecated and any vestiges should be
# completely removed"*, which sent a turn to look up a fact the user had just supplied and
# then blocked the reply for not looking it up. The 7 kept are genuine: "aren't those
# deprecated?", "wouldn't vendor be deprecated?", "weren't we deprecating verify?".
ASKING = re.compile(
    r"\?"
    r"|^\s*(?:is|are|was|were|does|do|did|can|could|should|would|has|have"
    r"|what|which|why|when|who|where|how)\b"
    r"|\b(?:check whether|find out|look up|verify (?:whether|if)|do you know"
    r"|not sure|i think|might be|i wonder)\b", re.I)

INJECTED = re.compile(
    r"^\s*(?:Base directory for this skill"
    r"|Caveat:"
    r"|This session is being continued"
    r"|Another Claude session sent a message"
    r"|Stop hook feedback"
    r"|\d+ background agents? (?:was|were) stopped"
    # A PEER SESSION GOING IDLE arrives as this bracketed line, the one injected opener here
    # that is not a tag. MEASURED 2026-10-29: it was missing, and 11 issues in this
    # machine's ledgers were opened by one — `~/Work` `4e1b090a` i4 among them,
    # left open with no items. Over 403 transcripts it is the only bracketed harness opener
    # (12 rows; the rest are image markers), and every tag-wrapped one was already matched.
    # ITS SIBLING, `[Cross-session delivery notice]`, is named by the harness's own
    # SendMessage description (57 copies across this machine's transcripts, 2026-10-30) and
    # has never been seen arriving; it is matched so that the first one opens nothing.
    r"|\[Cross-session (?:idle|delivery) notice\]"
    # A background task finishing arrives as a user row wrapped in these. MEASURED
    # 2026-09-13: the first live asks checklist opened on a task notification.
    r"|<(?:[a-z-]+-message|system-reminder|task-notification)\b)", re.I)

# THE ONE PREFIX THAT MAY LEAVE A CHECKLIST STANDING, and it is narrower than INJECTED on
# purpose. A background task finishing is the only harness text MEASURED firing this event in
# the middle of a turn (2026-09-13). Every other INJECTED prefix is also something a user can
# paste at the start of a real message ("Stop hook feedback: ...", "Caveat:", a copied
# reminder), and a real message must never inherit last turn's asks.
NOTIFICATION = re.compile(r"^\s*<task-notification\b", re.I)

# A PEER SESSION'S REQUEST IS AN ASK, though `INJECTED` matches it. MEASURED 2026-10-30 in
# odyssey-alive `de3efe49`: the save-issue session's request (transcript row 1863, a whole
# turn) and wf-dev's (row 2008, delivered into a running turn as a `queued_command`) both
# reached this event, and the tag this hook wrote holds both prompts as the bare tag,
# `<cross-session-message from="…" from-name="…" from-mode="prompting">\n…\n
# </cross-session-message>`, with no "Another Claude session sent a message" line before
# it and no trailing note after it. Those are how the transcript renders the row, and the
# line is matched as optional in case a payload ever carries it. `<[a-z-]+-message` refused
# both, so neither opened an issue; nor did five mutze-studio requests in this repository's
# `e1d85496`. THE TAG NAME DECIDES, read from the text because the payload carries no
# `origin`: a subagent's hand-back is `<agent-message`, and it and every other `INJECTED`
# opener still open nothing. THE ASK IS THE BODY between the tags, never the tag line.
PEER_REQUEST = re.compile(
    r"\A\s*(?:Another Claude session sent a message(?: while you were working)?:\s*)?"
    r"<(cross-session|teammate)-message\b([^>]*)>(.*?)</\1-message>", re.S | re.I)
# A TEAMMATE'S MESSAGE IS THE SAME ASK UNDER ITS OWN TAG, named by `teammate_id`, which is
# the attribute `wf-widen.FROM_ID` already reads. UNMEASURED AS DELIVERED: on 2026-11-09 the
# only `<teammate-message` text in this machine's transcripts was a search quoting the tag.
PEER_ATTR = re.compile(r'\b(from|from-name|teammate_id)="([^"]*)"')

# A MESSAGE FROM ANOTHER SYSTEM IS AN ASK LIKE ANY OTHER. User, 2026-11-09: "Messages from
# other systems for sure need to be part of this system because, you know, how else are they
# going to be vetted and used if they don't have the same constraints as any other ask? ...
# If a message comes in, it should be part of the work list too." ENUMERATED 2026-11-09 over
# every transcript on this machine, the envelopes an incoming message arrives in:
#   `<cross-session-message from=… from-name=…>`   188 rows behind "Another Claude session
#                                                   sent a message", ~30 delivered mid-turn
#   `[agent-msg from=NAME HH:MMZ] …`               104 typed, 20 delivered mid-turn; most are a
#                                                   pointer ("Long message, read it by running:
#                                                   agent-say show <id>"), read at Stop
#   `<agent-message from=…>` hand-back, `<task-notification>`   RESULTS of work already on
#                                                   the list (2,179 and 2,867): no new ask, and
#                                                   their docket is inherited (`served_ask`)
#   `[Cross-session idle notice]`                  18, a status line with no ask
#   `<teammate-message teammate_id=…>`             read like `<cross-session-message>`; no row
#                                                   on this machine delivered one
# The sender header is matched by its
# shape — a bracketed `…msg from=NAME` at the very start — and never by a tool's name.
PEER_HEADER = re.compile(r"\A\s*\[[a-z-]*msg from=([A-Za-z0-9_.@:-]{1,64})[^\]\n]{0,40}\]\s*")


def peer_request(prompt):
    """(body, sender) for a peer session's request, or None for any other text. `sender` is
    {"from": <the address SendMessage replies to>, "from-name": <the session's name>}, each
    flattened to one line and capped, since both are another session's words."""
    text = prompt if isinstance(prompt, str) else ""
    m = PEER_REQUEST.match(text)
    body = m.group(3).strip() if m else ""
    if not body:
        # THE SAME ASK UNDER THE OTHER ENVELOPE: a line typed into this session's prompt by a
        # peer's messenger (`[agent-msg from=cw-dev 22:08Z] …`). There is no address to reply
        # to by `SendMessage`, so `from` and `from-name` are both the sender's name.
        n = PEER_HEADER.match(text)
        body = text[n.end():].strip() if n else ""
        if not body:
            return None
        name = flat_sender(n.group(1))
        return body, {"from": name, "from-name": name}
    attrs = dict(PEER_ATTR.findall(m.group(2)))
    attrs.setdefault("from", attrs.get("teammate_id"))
    attrs.setdefault("from-name", attrs.get("teammate_id"))
    return body, {k: flat_sender(attrs.get(k)) for k in ("from", "from-name")}


def flat_sender(text):
    """One sender field, flattened to one line and capped: it is another session's words."""
    return " ".join(text.split())[:200] if isinstance(text, str) else ""


def peer_sender(peer):
    """Who a peer's request is shown as coming from: its `from-name`, else its `from` address,
    each through `flat_sender` again so a `peer` from anywhere reads the same. The ONE place
    the choice is made, so the index row and the checklist line never name it differently."""
    return flat_sender(peer.get("from-name")) or flat_sender(peer.get("from"))


# A PEER'S POINTER IS NOT AN ASK. agent-say types a long message into the pane as one of two
# sentences naming where to read it, and the ask is in the message it leads to. MEASURED
# 2026-11-11 in this repository's session `f9318dba`: the pointer was seeded as i27's only item
# and printed as the Work row and the index's `ask`, so the list read "Long message, read it by
# running: agent-say show ... To answer, run the shell command: ..." where an ask belonged. 126
# of the 340 peer deliveries in this machine's transcripts are a pointer.
PEER_POINTER = re.compile(
    r"\A(?:Long message, read it by running|A message from an agent on another computer "
    r"\(not your user\) is waiting; read it with): agent-say show (\d{14}-\d{1,10})\."
    r"(?: To answer, run the shell command: .*)?\Z", re.S)
DELIVERY_ID = re.compile(r"(\d{14})-(\d{1,10})")


def delivery_id(text):
    """`(the UTC second, the agent-say process number, the id)` for one agent-say message id,
    `<YYYYmmddHHMMSS>-<pid>`, or None."""
    m = DELIVERY_ID.fullmatch(text) if isinstance(text, str) else None
    if not m:
        return None
    try:
        at = calendar.timegm(time.strptime(m.group(1), "%Y%m%d%H%M%S"))
    except ValueError:
        return None
    return at, m.group(2), text


def pointer_id(prompt):
    """`delivery_id` of the id a peer's pointer names, or None for any other text."""
    m = PEER_POINTER.match(" ".join(str(prompt or "").split()))
    return delivery_id(m.group(1)) if m else None


def ask_text(prompt, peer=None):
    """The words an item, a row or the index shows for a message: the message flattened to one
    line, or for a peer's pointer a short label naming its sender and id, never the pointer."""
    ptr = pointer_id(prompt)
    if ptr is None:
        return " ".join(str(prompt or "").split())
    who = peer_sender(peer) if isinstance(peer, dict) else ""
    return f"message from {who} ({ptr[2]})" if who else f"peer message ({ptr[2]})"


# THE IMPERATIVE, for the `work` kind below: a sentence that OPENS on an action verb, after
# the words a speaker puts in front of one ("okay, so now add …", "- please move …"). The
# verbs are the ones a request for work uses; the sentence start is what makes one an order
# rather than a word in passing ("the add button"). `do`, `have`, `get` and `go` are left
# out on purpose: at a sentence start they open a question ("do you think …") as often as
# an order.
_WORK_LEAD = (r"(?:^|(?<=[.!?;:\n]))\s*[-*>]?\s*"
              r"(?:(?:ok(?:ay)?|so|now|then|and|also|yeah|yes|sure|alright|well|hey|but"
              r"|first|next|actually|please|just)[,!.]?\s+)*")
_WORK_VERB = (
    r"(?:add|remove|delete|drop|move|rename|make|build|create|write|rewrite|draft|fix|update"
    r"|change|replace|run|re-?run|start|finish|continue|commit|push|deploy|publish|republish"
    r"|put|set|generate|render|redo|try|use|install|research|find|look|check|test|show|send"
    r"|report|implement|process|apply|merge|wire|swap|convert|copy|clean|organi[sz]e|arrange"
    r"|break|split|list|give|bring|turn|pull|open|close|kill|stop|restart|reach|ask|tell"
    r"|save|store|keep|mark|file|record|note|draw|design|plan|outline|lay|format|edit|revise"
    r"|adjust|tweak|fill|hire|retire|audit|review|evaluate|measure|compare|pick|sync|upload"
    r"|download|fetch|import|export|migrate|port|refactor|rebuild|retry|resume|ship|release"
    r"|trim|shorten|expand|increase|reduce|lower|raise|enable|disable|switch|point|link"
    r"|connect|include|exclude|attach|insert|place|resize|crop|scale|clear|reset|undo"
    r"|revert|restore|archive|sort|group|combine|integrate|wrap|handle|address|solve"
    r"|resolve|debug|investigate|shut|queue|schedule|deliver|produce|prepare|finali[sz]e)")

KINDS = [
    ("history", re.compile(
        r"\b(why (?:was|were|did|is it)|when (?:was|were|did)|who (?:removed|changed|added)"
        r"|what happened to|deliberate|on purpose|intentional"
        r"|(?:should|do) (?:we|i|you) (?:restore|bring back|re-?add|revert))\b", re.I),
     "hearing",
     "the record is testimony and it is the only thing that knows INTENT. A tree shows "
     "what is there; only the record says whether its absence was a decision"),

    # `latest` ALONE WAS 46 OF THIS KIND'S 60 FIRES and almost all of them were wrong:
    # "pull down the latest master", "audit the latest article", "prepare the latest
    # release". It is an ordinary English word in an instruction, not a question about the
    # world. MEASURED over 1,909 real prompts, narrowing it to a lookup context takes this
    # kind from 60 fires to 13, drops 48, and loses no prompt that actually needed an
    # outside source. One residual false positive remains in the 13 and is named rather
    # than tuned away, the way 1.38.0 named what its trigger could not do.
    #
    # THE ANECDOTE BEHIND THIS ROW, kept here and out of the emitted text, because every
    # user's session reads that text and none of them can look this up: reading local
    # documents to answer a question about the world is how `vendor` was called a live
    # command in this repository, from docs that had gone stale.
    ("world", re.compile(
        r"\b(deprecat\w*"
        r"|(?:the )?(?:latest|newest|current) (?:version|release|stable|api|docs?|spec)"
        r"|current(?:ly)? (?:supported|recommended)|still (?:supported|a thing|maintained)"
        r"|best practice|state of the art|does .{0,20}still exist"
        r"|has .{0,20}changed|up to date"
        r"|what(?:'s| is) (?:the )?(?:latest|current|new))\b", re.I),
     "hearing",
     "a repository cannot know the world. Local documents go stale, so reading them to "
     "answer it gives the world as it was when they were written"),

    # THE ANECDOTE BEHIND THIS ROW, kept here and out of the emitted text for the reason
    # given above `world`: four scripts in this repository were described in working
    # detail by live procedures and existed nowhere.
    ("behaviour", re.compile(
        r"\b(does (?:it|this|that) (?:still |even |actually |really )*(?:work|run|fire|pass)"
        r"|why (?:does|is) .{0,30}(?:fail|break|error)"
        r"|is (?:it|this) working|what does .{0,30}(?:do|return|emit|print)"
        r"|test|verify|prove|reproduce)\b", re.I),
     "touch",
     "prose says what a script does; running it says what it did"),

    # THE KIND THAT WAS MISSING, and it is the one the tunnels formed in. The other four
    # ask about FACTS — what the record says, what the world says, what a script does,
    # what is in a set. A design ask proposes something, and a proposal you authored
    # cannot be judged from inside: `senses.md` measures NINE OF TEN escapes from a
    # settled wrong reading arriving from OUTSIDE the turn that formed it, and zero from
    # noticing. So the sense is hearing — the record (has this been tried, what was
    # decided before) or a reader who did not write the thing.
    #
    # MEASURED THE SAME DAY IT SHIPPED, on this session's own ten asks: two carried a
    # docket. The three that did not — "why not install them where workforce is
    # installed", "should we audit workforce itself", "how close is wf-live to the
    # intuition juror" — are exactly where the readings formed that an independent
    # evaluator later broke in one move. The jury was structurally unreachable on every
    # one of them, so the gate was working and the docket was empty.
    #
    # 2.5% of 1,323 real non-injected prompts, against 1.5% and 0.5% for the two reply
    # triggers that shipped. `should be` UNHEDGED was measured and REJECTED: it doubled
    # the rate to 3.5% by catching plain instructions — "that should be in the email",
    # "no mobile and api-only items should be there". A hedge is what separates a
    # proposal from an order.
    ("judgment", re.compile(
        r"\bshould (?:we|i|you)\b"
        r"|\bwhy (?:not|don'?t we|wouldn'?t we|shouldn'?t we)\b"
        r"|\b(?:what|how) (?:do|would) you think\b|\bdo you think\b"
        r"|\byour thoughts\b|\bthoughts\?"
        r"|\bis (?:that|this) a good idea\b|\bgood idea\?"
        r"|\bdoes (?:that|this) make sense\b"
        r"|\bwould it be (?:better|worth|wise)\b"
        r"|\bi wonder (?:if|whether)\b"
        r"|\b(?:best|right|proper) (?:way|approach|shape|design)\b"
        r"|\bhow (?:would|should) (?:you|we|i)\b"
        r"|\bwouldn'?t it\b|\bcouldn'?t we\b"
        r"|\b(?:perhaps|maybe|i think|i feel like|it feels like|i'?d say)\b"
        r"[^.\n]{0,60}\bshould\b", re.I),
     "hearing",
     "a proposal you authored cannot be judged from inside — the measurement is nine of "
     "ten escapes from a settled wrong reading arriving from outside the turn that formed "
     "it, and none from noticing. Consult the record for what was already decided, or a "
     "reader who did not write it"),

    ("existence", re.compile(
        r"\b(is there (?:a|an|any)|are there|do we have|does .{0,25} exist|what(?:'s| is) in"
        r"|how many|list (?:the|all|every)|which (?:ones|files|scripts|commands)"
        r"|any (?:other|more)|anywhere else)\b", re.I),
     "taste",
     "a claim about a SET is closed by enumerating the set. Point reads sample it, and a "
     "sample cannot show what is absent"),

    # THE INCIDENT KIND, and it is the only one here whose wrong answer the user wrote out
    # in full. User directive 2026-09-24, on a session that diagnosed a hung shell: "we
    # never ever want this type of response from you when dealing with an issue, make sure
    # that is something built into the @workforce-dev jury in the proper sense."
    #
    # WHAT THE TURN DID, from the playwright-mcp record. It stated a cause — "the IC guessed
    # the command from your project's name" — without reading that IC's OUTPUT.md or its
    # transcript, and the real cause was its OWN work order naming `web_fetch` to an agent
    # whose `tools:` did not hold it. It then proposed two bans, "never reach a missing tool
    # through the shell" and "never npx an unpinned package", either of which would also have
    # blocked the `curl` and the `npx -y n lts` that WORKED in the same incident. Its own part
    # came out only after two rounds of pushback: "are we causing more problems by using some
    # drastic rule instead of actually identifying the issue you caused?" and "Those aren't
    # two choices for me. neither one is acceptable."
    #
    # THE SENSE IS HEARING, for the reason `senses.md` gives the record: an OUTPUT.md, a
    # transcript, a `git log` and a command's own output are TESTIMONY, and they are the only
    # things that know why an agent did what it did. A cause read off this turn's own
    # reasoning is the tunnel, exactly.
    #
    # MEASURED over 1,212 real non-injected prompts from this machine's transcripts: 18
    # fires, 1.49%, against the 1.5% budget the two shipped reply triggers were held to. All
    # 18 were hand-read and all 18 are genuine — "why did the sound go silent?", "please
    # diagnose why the voice chat is not working", "we also have an issue with shell items
    # staying open", the `diagnose-crash` crash reports, and the two pushbacks quoted above.
    ("incident", re.compile(
        r"\b(?:root cause|post-?mortem)\b"
        r"|\bwhat (?:went wrong|happened here)\b"
        r"|\bwhat caused\b"
        r"|\bwhy did (?:it|this|that|you|the|we)\b"
        r"|\bwhy (?:is|are|was|were) (?:it|this|that|there|the)\b[^.\n]{0,40}"
        r"\b(?:fail\w*|broke\w*|broken|error|wrong|happening|stuck|hanging)\b"
        r"|\b(?:diagnose|troubleshoot)\b"
        r"|\b(?:it|this|that|they) (?:broke|crashed|hung|is broken|are broken|stopped working)\b"
        r"|\b(?:issue|bug|error|failure|crash|problem|defect|regression)\b[^.\n]{0,40}"
        r"\b(?:you|we|i) (?:caused|created|introduced)\b"
        r"|\bwe (?:also )?have (?:an|a) (?:issue|problem|bug)\b"
        r"|\b(?:i'?m|we'?re) (?:still )?(?:running into|hitting|getting) (?:an? )?"
        r"(?:issue|error|problem)\b"
        r"|\bcrashed\b", re.I),
     "hearing",
     "a cause is testimony before it is anything else. Every stated cause — and above all "
     "every claim about WHY an agent did something — is read off the record it came from: "
     "that agent's OUTPUT.md, its transcript, `git log`, the command's own output. A cause "
     "inferred from this turn's own reasoning is the tunnel, and a rule proposed on one "
     "bans whatever it happens to reach"),

    # THE WORK KIND, AND IT IS THE GENERAL CASE THE FIVE ABOVE LEFT OUT. User, 2026-11-09:
    # "whatever rules that you enter in need to be smart enough that they'll work in any
    # situation that's relative to the sensory data." The five kinds above ask about FACTS;
    # most of what a user types asks for WORK — "do a face replacement on X with Y's face",
    # "Let's start T7", "please report it to cw-dev" — and none of those matched anything.
    # MEASURED 2026-11-09 over mutze-studio `30e77777` and `0cb6fb41`: every user prompt
    # behind the five unchecked result claims (a face swap called done, "the face clearly
    # changed" at RMSE 0.024, a page called updated, a wrong output filed under the final
    # name) classified as NOTHING, so no juror could sit on any of them.
    #
    # THE SENSE IS TOUCH: was the result shown by something that RAN, and checked against
    # what was asked? A result is a fact about the world after the work, and prose about it
    # is the turn describing its own success.
    #
    # IT READS THE USER'S WORDS, NEVER THE REPLY. The grammar of a request: an imperative,
    # a request put to the one doing the work ("can you", "I'd like you to", "let's"), work
    # the user says is still owed ("you never did", "you didn't update"), and the state the
    # user wants the work to leave ("that body should have the face from …"). A detector
    # over the reply's outcome words was measured at 49.8% of replies and rejected; this one
    # reads the ask, before any of the answer exists, the way every kind above does.
    #
    # MEASURED 2026-11-09, head only (`HEAD_ONLY`): 217 of 482 typed mutze-studio prompts
    # (45.0%) in the 40 newest transcripts, 118 of 180 (65.6%) in this repository's own.
    # That is a large share BY DESIGN — most messages ask for work — and it is affordable
    # only because the kind is `JURY_ONLY` below: it seats the touch juror and never blocks
    # on a count of zero runs, since a draft, an answer or a plan is work no run closes.
    #
    # THE ANECDOTE BEHIND THIS ROW, kept here and out of the emitted text for the reason
    # given above `world`: in mutze-studio `30e77777` a turn called a face swap done that had
    # put the same picture in both slots, and called a second one changed at an RMSE of 0.024.
    ("work", re.compile(
        _WORK_LEAD + _WORK_VERB + r"\b(?!\s*(?:is|was|are|were|of)\b)"
        r"|\b(?:can|could|would) (?:you|we|u)\b"
        r"(?!\s+(?:tell|explain|describe|say|think|feel|imagine|recommend)\b)"
        r"|\bplease\b(?!\s+(?:tell|explain|describe)\b)"
        r"|\b(?:i'?d|i would|i) (?:like|love|want|need)(?: you| us)? to\b"
        r"(?!\s+(?:know|understand|see|be sure|ask)\b)"
        r"|\bi (?:want|need) (?!to\b)\w+ (?:to )?" + _WORK_VERB + r"\b"
        r"|\b(?:we|you) (?:also )?(?:need|have|want|ought) to\b"
        r"|\bwe'?ll (?:also )?(?:need|want|have) to\b"
        r"|\b(?:we|you|i) (?:should|may want to|might want to|'d|would) (?:also |just |now )?"
        + _WORK_VERB + r"\b"
        r"|\blet'?s\b|\bgo ahead\b|\bmake sure\b"
        r"|\byou (?:can|could|should|might|may|need to) (?:go ahead and |also |just |now )?"
        + _WORK_VERB + r"\b"
        r"|\b(?:it )?(?:would|might) be (?:nice|good|great|better) (?:to|if)\b"
        r"|\byou (?:never|didn'?t|did not|haven'?t|have not|forgot to|still haven'?t) "
        r"(?:even |actually |really )?(?:do|did|" + _WORK_VERB[3:-1] + r")\b"
        r"|\bno \w+(?: \w+)? (?:happen\w*|change\w*|appear\w*)\b"
        r"|\b(?:we'?re|we are|it'?s|is|are) (?:still )?missing\b"
        r"|\bneeds? (?:to be )?[a-z]+ed\b"
        r"|\b(?:should|needs? to|has to|must) (?:still |only |also |now |just |really |always )*"
        r"(?:be|have|go|say|read|point|show|include|use|look|appear|come|sit|stay)\b", re.I),
     "touch",
     "a result is a fact about the world after the work, and only something that RAN shows "
     "it: the command's output, the file as written, the page as published, the measurement "
     "against the input. A result described from the turn's own account of what it did is "
     "the tunnel"),
]

# THE FIRST 400 CHARACTERS ONLY, for the kinds named here.
#
# A PASTED DIFF IS NOT AN ASK, and neither is a skill's preamble, an artifact page contract,
# or a wall of log output — but each of them is long, and a long body will eventually contain
# any phrase. MEASURED over the same 1,212 prompts: `incident` fires 36 times (2.97%) unbounded
# and 18 (1.49%) on the head. Every one of the 18 dropped was a phrase buried in pasted
# material — "Errors explain what went wrong and how to fix it" inside a design brief, "don't
# cause regression" inside a quoted goal, `debug.log` inside an npm dump. None was an ask.
#
# IT IS A SET RATHER THAN A FIFTH TUPLE FIELD, so the four shipped rows keep the shape they
# were measured in and nothing has to be re-verified to add one bound.
HEAD = 400
HEAD_ONLY = frozenset({"incident", "work"})

# KINDS THAT SEAT THEIR JUROR AND NEVER BLOCK ON A CHANNEL COUNT. `wf-widen` blocks a turn
# whose tagged sense recorded zero calls; for `work` a zero is not a fact about the result.
# A request for a draft, an answer or a plan is work that no command closes, and blocking it
# for running nothing would be a known wrong fire. What only a reader can tell — whether a
# RESULT the turn claimed was shown by something that ran — is the juror's question, and
# the turn is always tried (`wf-widen`, the always-seated rule). A sense another kind or a
# claim trigger also requires is still gated on its count as it always was.
JURY_ONLY = frozenset({"work"})

# THE USER'S WORDS DECIDE, NEWEST FIRST — carried on every message, in every project.
# User directive 2026-09-16 (SKILL.md § Directives). It lives HERE, in a hook the install
# wires and `update` refreshes, and not in `/org` dispatch or the operating principles,
# because those are per-project copies that only an `audit` rewrites: a rule put there
# reaches no existing org until somebody re-audits it. This hook is already wired at user
# scope, so changing this text reaches every project on the next `update`, and it arrives
# at the head of every turn rather than decaying at the head of a conversation.
# Stated as facts, never as an instruction (see the note above the injection in `main`).
USER_WORDS = (
    "What this user wants is decided by the user's own requests and notes, weighed by date "
    "with the newest first: this message, then earlier messages in this conversation, then "
    "older requests and notes. A report, plan, summary, or record written by an AI is an "
    "interpretation of those words, not the user's evidence, however recent it is; projects "
    "mark the difference with quoted user words, `origin: user` blocks, `source: user` "
    "attributions, and the user's own notes. An older decision that a newer request "
    "contradicts is superseded by the request, so \"keep it as it was\" is not one of the "
    "choices, and an option that delivers less than the request is not the recommended one. "
    "On how code is written, precedence runs: the user's newest requests and notes decide "
    "what gets built; the project's original human-written code decides how, newest first "
    "within it; AI-written code already in the project comes next, even when it is newer "
    "than the human code; the AI's own preferences come last. Precedent covers mechanisms, "
    "helpers, error handling, naming, and comment style, not bugs. Where a project has "
    "almost no human code, the user's own words are its human precedent. Before an edit, "
    "wf-code-origin reports which lines of the file are human, AI, or unknown by git history."
)


# WHEN TO STOP AND ASK, AND IN WHAT FORM. User directive 2026-09-24, after an `/agenda
# today` run put 31 items to the user as plain markdown, asked for an answer in codes,
# buried the list under six background hand-backs and sat about fifteen minutes: "You
# shouldn't be waiting on my answer, especially if it isn't absolutely evident that you
# need my input on something. ... If there is an answer that it is needed, it needs to be
# evident in a chooser situation" — "much like we choose the budget for audit" — "and this
# functionality needs baked into the workforce process itself without org."
#
# IT LIVES HERE FOR THE SAME REASON `USER_WORDS` DOES, which is the "without org" clause
# made mechanical: this hook is wired at user scope, so the rule reaches every project on
# the next `update` and arrives at the head of every turn. A copy in the operating
# principles reaches only a project somebody re-audits. `wf-chooser` enforces the same
# rule at `Stop`; this is the half that arrives in time to change what the turn does
# rather than grading it afterwards.
#
# Stated as facts, never as an instruction (see the note above the injection in `main`).
CHOOSER_RULE = (
    "Stopping to ask this user is for a decision that genuinely needs them: anything that "
    "can be decided and reversed is decided, said in one line, and the work it unblocks is "
    "finished rather than reported as pending. When a decision does need them, it is put "
    "in an AskUserQuestion chooser in that same turn, never in prose the user has to "
    "decode and type an answer back to — a question written as plain text scrolls away the "
    "moment anything else finishes."
)


# WHAT THE TERMINAL DOES TO A LINK AND TO A DRAFT. User report 2026-10-28, odyssey-alive,
# on two slips in one session. A Sources list written as markdown links `[title](url)`:
# "none of those link sources are clickable" — the terminal makes a bare https:// URL
# clickable and does nothing with link syntax. An email draft shown as a `>` blockquote,
# which the terminal re-quoted on every wrapped line: "It's really hard to copy each line
# individually and stick them together for the correspondence." What worked was plain
# one-line paragraphs with a blank line between them, the text put on the clipboard with
# wl-copy and saved to a scratchpad .txt. The second slip in the same draft: the session's
# own sentence ran straight on from the email body, so it would have been pasted into the
# email. A draft needs a visible end.
#
# IT LIVES HERE FOR THE REASON `USER_WORDS` AND `CHOOSER_RULE` DO, and not in `/org` rung
# 13. This hook is wired at user scope, so the rule reaches every project on the next
# `update`; `/org` is a per-project copy that only an `audit` rewrites, and the user
# corrected exactly that placement on 2026-09-16: "this shouldn't live in org".
#
# UserPromptSubmit ONLY, like `CHOOSER_RULE`: a subagent writes to its caller, never to the
# user, so a format for the user's terminal is text it would pay for on every spawn and
# never use.
#
# Stated as facts, never as an instruction (see the note above the injection in `main`).
TERMINAL_TEXT_RULE = (
    "In the terminal a bare https:// URL is clickable and markdown link syntax is not, so "
    "each link that reaches the user is its title followed by the full bare URL on its own "
    "line, whatever a tool's reminder says about markdown hyperlinks. Text the user will "
    "copy out, such as an email, a message or a post, is plain paragraphs of one line each "
    "with a blank line between them and no quote markers or indentation, because the "
    "terminal repeats a > on every wrapped line. It is also saved to a .txt in the "
    "scratchpad and put on the clipboard where a clipboard command exists (wl-copy, xclip, "
    "pbcopy), and the draft is followed by a line saying it has ended, before anything "
    "else the reply says."
)


# WHAT IS LEFT RUNNING WHEN THE WORK IS DONE. User report 2026-09-24, on a real run in a
# sibling project: "we also have an issue with shell items staying open after they have
# expired and agents staying open after their work is done ... the 1 shell gives the
# impression that the work isn't done here."
#
# THREE MEASURED CAUSES, ONE RULE, because the user asked for the class and not the
# instance ("so that these type of issues also don't happen in the future").
#
#   1. FOUR ICs STILL RUNNING 7-8 HOURS AFTER HANDING BACK. They had been spawned as
#      NAMED TEAMMATES. A teammate does not end when it returns its report — it waits for
#      a `shutdown_request` — and no step in this distribution's dispatch protocol sent
#      one, at any tier. **The defect is the MISSING CLOSE-OUT, not teammates**, so the
#      rule is a preference plus a shutdown, never a ban: a teammate is the right shape
#      for work you must talk to while it runs, and one-shot work simply is not that.
#
#   2. A SHELL THAT OUTLIVED ITS SUBAGENT BY NINE HOURS. The IC ran
#      `npx -y playwright-mcp@latest web_fetch '{...}' | head -200` in Bash. Name the
#      defect precisely, because the obvious reading is wrong: **the shell was not it.**
#      The same IC fetched a README with `curl` in the same run and it worked. What
#      failed was a package name GUESSED from the tool's name and fetched at `@latest`,
#      which resolved to an MCP stdio server — so it blocked on stdin, with no timeout.
#      A blanket "never use the shell" would have banned the `curl` that worked and left
#      the guess that hung.
#
#   3. THE ORDER IS WHAT SENT IT THERE. The work order told that IC to verify commands
#      "with web_fetch" while its handbook's `tools:` was `Read, Edit, Write, Bash,
#      Skill`. Its own report says so — "`web_fetch` MCP tool is not in this tier's
#      toolset" — and it improvised rather than report the gap. Both halves are addressed
#      where each one lives: the DIRECTING node checks the name against the callee's
#      grant before dispatching, and the RUNNING one says so and works with what it has.
#
# IT LIVES HERE FOR THE REASON `USER_WORDS` AND `CHOOSER_RULE` DO. This hook is wired at
# user scope, so the rule reaches every project on the next `update` with no audit, and it
# is the ONE carrier that fires on both ends: `UserPromptSubmit` for the operator who
# writes the order, `SubagentStart` for the employee that runs it. The dispatch protocol
# in `procedures/org.md` and the handbook templates carry the same rule for orgs that
# re-audit; this is the half that does not wait for one.
#
# IT STAYS SHORT. It is paid on every message and on every spawn.
#
# Stated as facts, never as an instruction (see the note above the injection in `main`).
CLEANUP_RULE = (
    "One-shot work is spawned as a plain subagent by preference: a named teammate outlives "
    "its own hand-back until something sends it a shutdown_request, so an order reported "
    "done still shows a running agent. A teammate that was spawned is sent a "
    "shutdown_request once its report has been read. A work order names only tools the "
    "agent running it holds — its `tools:` minus its `disallowedTools:`, checked before the "
    "order is sent — and an order naming a tool the runner lacks is answered by saying so in "
    "the report and doing the work with what is there. Before a package is run through npx, "
    "what that name resolves to is known: the project's own package, a pinned dependency, or "
    "a package the task names. A package name is never guessed from a tool's or a project's "
    "name, and an MCP server is reached through its tools rather than started from the "
    "shell. A command that might wait on input or on the network is worth wrapping in "
    "`timeout`, and no background shell or process is left running once the work is done. "
    "A wait on a long job polls the job's own progress, prints it, and carries a timeout, "
    "with one waiter at a time; the job's own queue or the Monitor tool is preferred over a "
    "sleep loop."
)


# `hearing` named `workforce/changes/` as its record until 2026-11-10. That is this
# repository's change-record directory and exists in no other project, so the emitted text
# names the project's own change notes instead.
SENSE_HOW = {
    "hearing": "read the record that decided it (`git log`, the project's own changelog or "
               "decision notes), or ask a source outside this turn's own reasoning",
    "touch": "run it and read what came back, rather than reading a description of it",
    "taste": "enumerate the set — Glob, find, ls, grep -l — before saying what is in it "
             "or missing from it",
    "sight": "read the file itself",
}

# WHERE THE SENSES ARE WRITTEN UP, as a path that exists on the reader's machine. It was the
# bare `references/senses.md`, which resolves only inside this repository; the file ships
# beside `bin/` in every install (manifest), so it is found from this hook's own location
# and the line is left out when it is not there.
SENSES_DOC = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                           os.pardir, "references", "senses.md"))


# Explicit enumeration only, and that restraint is the design. Segmenting free-flowing
# natural language into distinct requests is a judgment task, and a regex that guessed at
# it would report `asks: 3` on one long sentence and `asks: 1` on three short ones — a
# number that is wrong in both directions is worse than no number, because the reply gets
# sectioned against it. So this fires on the shapes a user uses when they MEAN to
# enumerate, and returns 1 otherwise.
#
# WHY IT EXISTS. `classify` already returns an array, deliberately — an ask can be two
# KINDS at once. But the flag carries `ask.prompt` as ONE string, so nothing anywhere
# counted how many THINGS were asked. MEASURED 2026-09-11: a user sent three numbered
# issues in one message, got one smeared answer, and had to say so — "if I'm confusing
# you and causing you to mix up the different issues, let me know that too." The
# dissection was real and ran along the wrong axis.
ENUM_PATTERNS = (
    # "there's three things", "two issues", "3 questions"
    re.compile(r"\b(two|three|four|five|\d+)\s+(things?|issues?|questions?|parts?|items?|points?)\b", re.I),
    # "number two", "second thing", "and third"
    re.compile(r"\b(number\s+(two|three|four|2|3|4)|second(ly)?\b|third(ly)?\b)", re.I),
    # a numbered or bulleted list on its own lines
    re.compile(r"^\s{0,3}(\d+[.)]|[-*])\s+\S", re.M),
)

# The count itself, when the user states it. "three things" is a better answer than any
# inference, so it is read literally and preferred over every other signal.
WORD_NUM = {"two": 2, "three": 3, "four": 4, "five": 5}
STATED_COUNT = re.compile(
    r"\b(two|three|four|five|\d+)\s+(?:things?|issues?|questions?|parts?|items?|points?)\b", re.I)


def count_asks(prompt):
    """How many DISTINCT requests this prompt makes, when it says so. 1 otherwise.

    Returns (n, how) — `how` names the evidence, because a bare number gives a reader
    nothing to check and this one drives how a reply is shaped.
    """
    text = prompt or ""
    if INJECTED.search(text):
        return (1, "injected preamble — not the user's ask")

    m = STATED_COUNT.search(text)
    if m:
        raw = m.group(1).lower()
        n = WORD_NUM.get(raw)
        if n is None:
            try:
                n = int(raw)
            except ValueError:
                n = None
        # A stated count is authority, but not an unbounded one: "a hundred things" is
        # exasperation, not a docket.
        if n and 2 <= n <= 9:
            return (n, f"the user stated it: {m.group(0)!r}")

    listed = len(ENUM_PATTERNS[2].findall(text))
    if listed >= 2:
        return (listed, f"{listed} enumerated lines")

    if ENUM_PATTERNS[1].search(text):
        return (2, "ordinal marker present; count not stated, so this is a FLOOR")

    return (1, "no explicit enumeration")


def classify(prompt):
    """Every kind the ask matches, in the order the list declares them.

    NOT first-match. An ask can be two kinds at once — "why was this removed and does it
    still work" is history AND behaviour — and answering it needs both channels. Taking
    only the first would name one and silently drop the other, which is the narrowing
    this whole mechanism exists against.
    """
    # The ask is what the USER typed. Injected preamble is not it, and tagging it puts a
    # docket on a turn whose prompt nobody wrote (see INJECTED, measured).
    if INJECTED.search(prompt or ""):
        return []

    hits = []
    for name, pat, sense, why in KINDS:
        subject = (prompt or "")[:HEAD] if name in HEAD_ONLY else (prompt or "")
        if pat.search(subject):
            # `world` only: a statement about the world is not a question about it.
            if name == "world" and not ASKING.search(prompt or ""):
                continue
            hits.append({"kind": name, "sense": sense, "why": why})
    return hits


_UNSAFE_SID = re.compile(r"[^A-Za-z0-9_-]")


def session_component(payload):
    """The session id as ONE filename component, for every per-session path the hooks build.

    These paths are written and removed. A raw id of `x/../../escaped` walked out of the
    scratchpad whenever an intermediate directory existed. A real id is a UUID and passes
    through unchanged. `wf-widen` imports this rather than restate it.
    """
    sid = str(payload.get("session_id") or "")
    sid = _UNSAFE_SID.sub("_", sid)
    return sid[:64] or "nosession"


def agent_component(payload):
    """The subagent's id as ONE filename component, or "" when there is no subagent.

    MEASURED 2026-10-12 on 2.1.296 (platform.md fact 22b): `agent_id` is present only in a
    subagent's payloads — `SubagentStart`, its `PostToolUse` calls and `SubagentStop` — and
    absent from the main thread's, even in an `--agent` session. It is therefore the ONLY
    field that tells an agent apart from the session that spawned it.
    """
    aid = _UNSAFE_SID.sub("_", str(payload.get("agent_id") or ""))
    return aid[:64]


def state_component(payload):
    """The filename component EVERY per-turn hook file is keyed by: the session, and the
    agent too when one is stopping.

    WHY THE AGENT HAS TO BE IN THE NAME. Fact 22b (c): a subagent's payloads carry the
    PARENT session's `session_id`, identical on `SubagentStart`, `PostToolUse` and
    `SubagentStop`. So a file keyed by `session_id` alone is ONE slot shared by the main
    session and every concurrent agent. While agents were never judged that was harmless;
    once they are (K2, 034b5d6), it means each agent reads the tag the USER's message wrote
    and is judged against that message instead of its own work order, and two agents
    finishing at once read and write the same file. The user's ask of 2026-10-12: *"we may
    have multiple widened events that are being tracked at any one time, and so is that also
    being taken into effect?"*

    THE MAIN SESSION KEEPS TODAY'S NAMES, so a tag or checklist written before this change
    still reads, and nothing already on disk is orphaned.
    """
    aid = agent_component(payload)
    sid = session_component(payload)
    return f"{sid}.{aid}" if aid else sid


def tag_path(payload):
    """Where the tag waits for `Stop`. Keyed by session AND agent, so two sessions never
    cross and neither do two concurrent judgments inside one session.

    NOTHING HERE IS OPENED WITH A PLAIN `open()` — every reader goes through
    `read_json_nofollow` and every writer through `write_json_atomic`, for the reason the
    issue ledger uses them (see `write_json_atomic`): the LAST fallback below is `/tmp`,
    which is world-writable, and this name is predictable from a session id other accounts
    on the machine can see. A link planted at it would aim the hook's write at any file the
    user can write and hand the hook's read a file it was never given (CWE-59). The same
    rule covers `wf-asks.<sid>.json` beside it and `wf-widen`'s flag and closeout: one
    pattern, `wf-turn-budget`'s (3c7431c), never a second design.
    """
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = state_component(payload)
    return os.path.join(d, f"wf-task-tag.{sid}.json")


def open_agent_tag(payload):
    """Open the starting agent's OWN tag, under its own name, and record nothing else.

    THE ASK IS EMPTY HERE AND IS NOT GUESSABLE. Fact 22b (d), measured: `SubagentStart`
    carries no `prompt`, and the agent's transcript does not exist yet at that event
    (`derived_exists: False`), so the order the agent was given cannot be read. `wf-widen`
    fills it in at `SubagentStop` from the first `isSidechain` `user` row of
    `agent_transcript_path`, the first event where that file exists.

    SO THIS EVENT'S WHOLE JOB IS TO CLAIM THE SLOT. An opened slot is what says the state
    under that name belongs to the agent: a stop with no slot is an agent this installation
    never saw start, and `wf-widen` judges it on its reply alone rather than against an ask
    reconstructed from whatever file happened to be under the session's name.

    Never without an `agent_id`: that would resolve to the session's own tag and erase the
    user's ask mid-turn.
    """
    if not agent_component(payload):
        return
    write_json_atomic(tag_path(payload),
                      {"hits": [], "prompt": "", "senses": [], "asks": None,
                       "asks_why": "", "checklist": None,
                       "agent": str(payload.get("agent_type") or "")})


# WHAT AN ITEM IS, defined beside the list it belongs to. `wf-widen` counts these toward the
# hand-off to the widening agent. The status is the session's to word; only the ask decides
# whether an entry is an item.
def checklist_title(cl):
    """The short title the session gave this message's issue, made safe for one line."""
    return plain_text(cl.get("title") if isinstance(cl, dict) else None, TITLE_MAX)


def checklist_titles(cl):
    """The `"titles"` map the session wrote for EARLIER open issues, as `{id: title}`.

    Each id must be one bare name and each title is made safe the way `checklist_title`
    makes its one; an entry that is neither is dropped. The valid entries are then kept to
    `MAX_ISSUES`, because the ledger never holds more issues than that, so junk ahead of a
    real entry cannot push it out.
    """
    raw = cl.get("titles") if isinstance(cl, dict) else None
    if not isinstance(raw, dict):
        return {}
    out = {}
    for iid, title in raw.items():
        title = plain_text(title, TITLE_MAX)
        if bare_name(iid) and title:
            out[iid] = title
            if len(out) >= MAX_ISSUES:
                break
    return out


def checklist_items(cl):
    """The items on a checklist: JSON objects with a non-empty string `ask`. An `items` that is
    not a list holds no items, so a malformed file reads as an empty checklist."""
    items = cl.get("items") if isinstance(cl, dict) else None
    if not isinstance(items, list):
        return []
    return [i for i in items
            if isinstance(i, dict) and isinstance(i.get("ask"), str) and i["ask"].strip()]


# ─────────────────────────────────────────────────────────────────────────────────
# THE ISSUE LEDGER (K2c, K2d — user direction 2026-10-12).
#
# WHY IT EXISTS, in the user's words: *"the reason why we need to track multiple widening
# events is because you may actually be dealing with multiple issues at the same time, and
# you might have different sets of agents working on those different issues."*
#
# THE DEFECT IT REPLACES. `start_checklist` below removes last turn's checklist on every
# user message. That is correct for a per-TURN artifact and wrong for the work: MEASURED in
# this project's own session of 2026-10-12, the skul-dev fix and the turn-limit work were
# open at the same time and each new message erased the other's items. Worse, an agent
# dispatched for an issue hands back AFTER the turn that sent it has ended, so its result
# arrived with nothing left to judge it against.
#
# SO THE WIPE IS NO LONGER A LOSS, which is the whole of the fix. The outgoing checklist's
# items are ABSORBED onto their issue before the file is removed (`absorb_items`), and the
# issue stays open across every later message until its items are done and its agents are
# back. The per-turn checklist keeps its per-turn life; the ledger is what remembers.
#
# WHERE IT LIVES, and the user decided this too: *"if the issue tracker is going to be
# installed with the workforce, that's perfect, but the actual indexing of the issue tracker
# should be within the project that it's running from"*, and *"each project should have their
# own Issue Tracking Index"*. The code ships in the install; the DATA lives in the project,
# at `<project>/.claude/workforce/issues/`. One file per session, so two sessions in one
# project never share a file, plus `index.json` listing that project's open issues across
# its sessions. There is NEVER a user-level or machine-wide index, and a project's index
# never lists another project's issues: the only root this module will write under is the
# one the harness named.
ISSUES = "issues"

# THE IGNORE RULE'S WHOLE BODY: every file in the issues directory, and no path outside it.
# Named here rather than spelled at the write, so the one thing a reader has to check about
# it — that it is `*` and not a broader pattern aimed a level up — is checkable in one
# place. `bin/check` pinned this constant until it was retired on 2026-10-14; `issues_dir` is the
# only writer.
IGNORE_RULE = "*\n"

# THE THREE STATES AN AGENT ENTRY CAN BE IN, declared here because the ledger is the only
# file that carries them and a reader needs the set.
#
#   running    linked at `SubagentStart`; the issue holding one is a HOLD, never a failure.
#              A RESUMED agent returns to it at its next tool call (`agent_resumed`), and a
#              background agent's resume fires `SubagentStart` again, linking it anew on
#              the current issue (measured 2026-10-28; `agents_finished`).
#   returned   it handed back HAVING DELIVERED, and `wf-widen` recorded its judgment on the
#              issue. The only two ways in are a stop that delivered the report its order
#              asked for with nothing UNMET in it, and the issue closing.
#   handoff    it stopped at its TURN CAP with work left. SET BY `wf-turn-budget` at the
#              final threshold (K8), through `agent_handoff` below — the hook knows the
#              `agent_id` and the count, so the mark does not wait on `SubagentStop`
#              firing at a cap, which is unmeasured. An agent in this state has STOPPED:
#              the main `Stop` asks for it to be RESUMED, never replaced. THE STOP THAT
#              FOLLOWS THE CUT DOES NOT CLEAR IT (`agent_returned`, measured 2026-10-13):
#              it did, and the resume line never reached one real session.
#
# SO THE CYCLE IS `running` → `handoff` → `running` → … → `returned`, and every arrow is
# written by one event: the final threshold, the first tool call after a resume, and a stop
# that delivered.
AGENT_STATES = ("running", "returned", "handoff")

# A LEDGER NOBODY CAN READ IS A LEDGER NOBODY READS. A session that genuinely opened 200
# issues has a different problem than this file can fix.
MAX_ISSUES = 40

# THE WORDS A FINISHED ASK IS ACTUALLY GIVEN, declared once because two readers need the
# same set: `item_done`, which decides whether an issue can close, and the context line that
# tells the session which words to write.
#
# MEASURED 2026-10-13 in odyssey-alive's session `37f162e1`: six issues were reported open on
# every Stop and the list only grew. Three of i4's items were marked `answered` — the session
# had answered the question, which IS the work for a question — and `answered` was not in this
# set, so the issue could never close and the kickback repeated forever.
#
# THE SECOND HALF IS THE ASK THE USER TOOK BACK. A question withdrawn, sent by mistake or
# overtaken has no "done" to reach, and with no word for it the item stayed open for the life
# of the session. `dropped`, `withdrawn`, `cancelled`/`canceled`, `n/a`, `not needed` and
# `superseded` are the words a session actually writes for one.
#
# ANYTHING ELSE IS STILL OPEN, which is the direction that keeps work visible: the set is an
# ALLOWLIST, so an unrecognised status never closes an issue by accident.
DONE_STATUSES = ("done", "complete", "completed", "closed", "fixed", "shipped",
                 "answered", "dropped", "withdrawn", "cancelled", "canceled",
                 "n/a", "not needed", "superseded")

# HOW MANY EARLIER OPEN ITEMS ONE TURN CARRIES, newest issue first. The carried list rides in
# the checklist FILE, so it costs the prompt one sentence rather than its own length — but
# the file is read and rewritten by the session on every turn, and an unbounded list on a
# long-lived session is a chore that grows without end. Twenty is the same order as
# `MAX_ISSUES` and well above any turn's real set.
MAX_CARRIED = 20

# EACH CARRIED ASK IS CUT TO THE SAME LENGTH ON BOTH SIDES OF THE TRIP, which is what lets
# the write-back find its item by the ask it was given. The cap is applied where the row is
# built (`carry_forward`) and again where the item is matched (`absorb_carried`), so a long
# ask matches itself rather than nothing.
CARRY_ASK = 200

# HOW MANY STATED INTENTIONS ONE ISSUE KEEPS UNDER `noted`, newest last (`note_intentions`).
# They are advisory and nothing judges them, so the bound only keeps the file readable.
MAX_NOTED = 10


def project_root(payload):
    """The project this hook fired for, as the HARNESS names it, or None.

    `${CLAUDE_PROJECT_DIR}` first, the payload's `cwd` second, and NO `os.getcwd()`
    fallback — `wf-heal.project_root`'s rule too, restated here for the reason that rule
    exists. Both sources above are supplied by the harness and name the project this
    hook was fired for. `os.getcwd()` names wherever the process happens to be, so falling
    back to it turns a hand-run or a test from an unrelated directory into a confident
    write at `<cwd>/.claude/workforce/issues/`, a path nobody named. An unresolved root is
    not a root to guess at: None is the honest answer and every caller treats it as
    "record nothing".
    """
    root = os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd")
    return root if root and str(root).strip() else None


def _open_nofollow(path, flags, mode=0o600):
    """`os.open` with `O_NOFOLLOW` added, so a planted symlink at `path` is refused.

    THIS LEDGER LIVES IN A REPOSITORY, which is what makes the flag load-bearing rather
    than decorative: the path is predictable, a checkout is shared, and a link planted at
    `issues/<session>.json` would otherwise aim this hook's write at whatever it points to.
    The pattern is `wf-turn-budget`'s (3c7431c) and is deliberately not a second design.

    The flag is absent on some platforms; `getattr` keeps this importable there.
    """
    return os.open(path, flags | getattr(os, "O_NOFOLLOW", 0), mode)


def read_json_nofollow(path, default=None):
    """Parse a JSON object at `path`, never through a link. `default` on anything else.

    Unparsable state is DISCARDED rather than raised on. A hook that raised on a file
    somebody else can write would print a traceback on every message afterwards, and the
    cost of discarding is one forgotten issue against a hook that never runs again.

    A REGULAR FILE THIS ACCOUNT OWNS, OR NOTHING — asked of the OPEN FD, not of the name.
    `O_NOFOLLOW` refuses a LINK at the name and says nothing about what else can be there,
    and this reader is also pointed at the scratchpad fallback under `TMPDIR`, a directory
    every account on the host can write: a REGULAR file planted there is read and its
    contents become this session's own state — the ask count a turn is judged against.
    `os.fstat` answers about the file that was actually opened rather than about the name,
    and THE OWNER CHECK IS THE HALF THAT CARRIES THE CASE: a plausible-looking regular file
    somebody else put there first is read and believed, and nothing else here would notice.
    S_ISREG is defence in depth beside it and is not claimed as more than that — MEASURED
    2026-10-12 by deleting it, with the owner check left in place, and nothing changed. A
    FIFO IS NOT WHAT IT STOPS: `os.open` on a fifo blocks before any `fstat` can run, so
    that one is out of reach of this function entirely. A directory and a socket fail in
    `os.fdopen` on their own. What is left for S_ISREG is a device, which on this host
    needs root to create and is therefore already refused by the owner check — it is kept
    because it is free and correct, not because a test can tell it apart.

    `os.getuid` does not exist on Windows, where this ownership model does not apply, so
    its absence skips the owner half rather than failing the import.
    """
    import stat
    try:
        fd = _open_nofollow(path, os.O_RDONLY)
    except OSError:
        return default
    try:
        # `with` owns the fd from here, so the early return below closes it too.
        with os.fdopen(fd, encoding="utf-8") as fh:
            st = os.fstat(fh.fileno())
            uid = getattr(os, "getuid", None)
            if not stat.S_ISREG(st.st_mode) or (uid is not None and st.st_uid != uid()):
                return default
            d = json.load(fh)
    except (OSError, ValueError):
        return default
    return d if isinstance(d, dict) else default


def write_json_atomic(path, obj):
    """Replace `path` atomically, and never through a link. True when it landed.

    THE TEMPORARY NAME IS RANDOM AND CREATED `O_EXCL`, which is `tempfile.mkstemp`'s whole
    contract and the same call `wf-ledger.atomic_write` makes. It was `<path>.<pid>` until
    2026-10-12, and a pid is a five-digit number anybody can enumerate: one file sitting on
    that name made every save here return False — the ledger stops recording and says
    nothing — and in a directory other accounts can write it is a name somebody else can
    create first and keep. A random name created `O_EXCL` leaves nothing to squat and
    nothing to clobber, and `mkstemp` creates it 0600.

    `os.replace` then renames over the real name: rename acts on the NAME, so a symlink
    sitting at that name is REPLACED rather than written through, and its target is never
    opened. Those two together are why no file outside this directory can be reached by
    writing here.

    ATOMIC ALSO MEANS NO HALF-LEDGER. Two concurrent agents stop at once; a plain
    open-and-write would let one read a file the other had truncated.
    """
    import tempfile
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                                   prefix=os.path.basename(path) + ".")
    except OSError:
        return False
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def issues_dir(payload, create=False):
    """`<project>/.claude/workforce/issues`, or None when the harness named no project.

    ON FIRST CREATE IT WRITES ITS OWN `.gitignore` HOLDING `*`, and the hook does that
    rather than an audit: the ledger holds the user's prompts, which do not belong in a
    repository, and a rule only an audit adds reaches no project until somebody re-audits
    it. The precedent is measured — the retired commitments ledger at
    `.claude/workforce/commitments.json` was git-TRACKED in nsayka-wawa and odyssey-alive,
    and on 2026-10-10 a local edit to it on a live server would have made a
    `git pull --ff-only` conflict.

    THE RULE COVERS `issues/` ONLY, never `.claude/` and never `.claude/workforce/`. The
    user, 2026-10-12: *"some projects actually do ship their Claude directory with the
    repository. I think as long as the index [widen] uses is in the [Claude] directory on
    the project we're good."* A project that commits its `.claude` keeps committing
    everything else in it; an ignore rule one level up would silently un-commit a tree
    somebody chose to ship.

    A LINKED DIRECTORY IS REFUSED OUTRIGHT, which is the half `O_NOFOLLOW` on the files
    cannot reach: `os.makedirs(d, exist_ok=True)` succeeds when `d` is a symlink to a
    directory, and every file below it is then created inside the link's TARGET under a
    name that is not a link and that no flag can object to. So the directory itself is
    checked with `os.path.islink`, for `issues/` and for the `.claude/workforce` holding
    it. `.claude` ITSELF IS NOT CHECKED, deliberately: a dotfiles install that symlinks
    `.claude` into a managed tree is an ordinary setup, and refusing it would take the
    ledger away from a project that did nothing wrong.
    """
    root = project_root(payload)
    if not root:
        return None
    wf = os.path.join(root, ".claude", "workforce")
    d = os.path.join(wf, ISSUES)
    # sec-eval: this is a check-then-use (CWE-367). A directory swapped for a link in the
    # window between this test and the write still wins; closing that window means holding
    # an `O_DIRECTORY | O_NOFOLLOW` handle and threading `dir_fd` through every path this
    # module joins, which is a redesign of the ledger's addressing rather than a guard.
    # Ceiling accepted: this refuses the PLANTED link, which is the reachable case — winning
    # the race needs write access to `.claude/workforce`, and whoever has that can plant the
    # link in advance instead. Upgrade path: `dir_fd` on every open under `issues/`.
    if os.path.islink(d) or os.path.islink(wf):
        return None
    if not create:
        return d if os.path.isdir(d) else None
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        return None
    ignore = os.path.join(d, ".gitignore")
    if not os.path.exists(ignore):
        try:
            fd = _open_nofollow(ignore, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except OSError:
            return d
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(IGNORE_RULE)
        except OSError:
            pass
    return d


def ledger_path(payload, create=False):
    """This SESSION's ledger file inside the project's issues directory, or None.

    Keyed by `session_component`, so the id arrives as ONE filename component: a raw id of
    `x/../../escaped` would otherwise walk out of the project directory, and this is a path
    the hook creates and writes.
    """
    d = issues_dir(payload, create=create)
    if not d:
        return None
    return os.path.join(d, f"{session_component(payload)}.json")


def load_ledger(payload):
    """This session's ledger, or an empty one. Never None, so no caller branches on it."""
    p = ledger_path(payload)
    led = read_json_nofollow(p) if p else None
    if not isinstance(led, dict) or not isinstance(led.get("issues"), list):
        return {"session": session_component(payload), "issues": []}
    return led


def save_ledger(payload, led):
    """Write this session's ledger and refresh the project's index. True when it landed."""
    p = ledger_path(payload, create=True)
    if not p:
        return False
    led["issues"] = [i for i in led.get("issues", []) if isinstance(i, dict)][-MAX_ISSUES:]
    if not write_json_atomic(p, led):
        return False
    refresh_index(payload, led)
    return True


def refresh_index(payload, led):
    """Rewrite THIS PROJECT's `index.json` row for this session.

    PER PROJECT AND PER SESSION, which is the user's rule made mechanical: the index is a
    map from session id to that session's open issues, it is written inside the project
    whose work those issues are, and it is only ever reached through `project_root`. No
    other project's sessions are read and none are written, so there is nothing here that
    could become a machine-wide list.
    """
    d = issues_dir(payload, create=True)
    if not d:
        return
    p = os.path.join(d, "index.json")
    idx = read_json_nofollow(p) or {}
    sessions = idx.get("sessions")
    if not isinstance(sessions, dict):
        sessions = {}
    sid = session_component(payload)
    # THE REGISTRY IS READ ONLY WHEN ANOTHER SESSION IS LISTED, since only its rows need it.
    prune_dead_rows(d, sessions, sid,
                    live_sessions(sid) if any(k != sid for k in sessions) else None)
    rows = []
    for iss in open_issues(led):
        rows.append({"id": iss.get("id"),
                     # THE ASK IN SHORT, so the index is readable without opening the
                     # ledger. The full prompt stays in the session's own file.
                     # A PEER'S POINTER IS ITS LABEL (`ask_text`); any other prompt as it was.
                     "ask": (ask_text(iss.get("prompt"), iss.get("peer"))
                             if pointer_id(iss.get("prompt"))
                             else str(iss.get("prompt") or ""))[:120],
                     # WHO ASKED, when it was a peer session and not the user here.
                     **({"from": peer_sender(iss["peer"])}
                        if isinstance(iss.get("peer"), dict) else {}),
                     # THE HOOK'S FALLBACK IS COUNTED, deliberately. It is the only record
                     # of a message the session never itemized, and the index is read by
                     # somebody who cannot see the session's file: leaving it out would show
                     # `items_open: 0, agents_running: 0` for `/agenda today` two hours into
                     # its work, the shape of a finished issue. A follow-up that only adds
                     # context is not hidden here; its one `answered` item closes its own
                     # issue at the next submit (`start_checklist`), and the row goes.
                     "items_open": len([x for x in issue_items(iss)
                                        if not item_done(x)]),
                     "agents_running": len([a for a in issue_agents(iss)
                                            if a.get("state") == "running"])})
    if rows:
        sessions[sid] = {"file": f"{sid}.json", "open": rows}
    else:
        sessions.pop(sid, None)
    write_json_atomic(p, {"sessions": sessions})


# THE HARNESS'S LIVE-SESSION REGISTRY: `<config>/sessions/<pid>.json`, one record per running
# session, carrying `pid`, `sessionId`, `procStart` and `cwd`. HARNESS STATE, MEASURED on this
# host on 2026-10-29: three sessions running, each with a record, and each record's
# `procStart` equal to field 22 of `/proc/<pid>/stat` for its pid. The directory also holds
# `<pid>.<hash>.key` files, which are not records. The cap bounds a directory somebody else
# filled; a real one holds one record per open terminal.
SESSIONS_DIR = "sessions"
MAX_SESSION_RECORDS = 64


def _proc_start(pid):
    """Field 22 of `/proc/<pid>/stat` (start time, in clock ticks since boot), or None when
    the process does not exist or the file cannot be read. Counted after the LAST `)`,
    because field 2 is the command name in parentheses and a name can hold spaces."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            raw = fh.read()
    except OSError:
        return None
    rest = raw[raw.rfind(")") + 2:].split()
    return rest[19] if len(rest) > 19 else None


def live_sessions(sid):
    """The ids of the sessions the harness's registry shows running, or None when it cannot
    say (`SESSIONS_DIR` above).

    A RECORD IS LIVE when its `pid` is a running process and, when it names a `procStart`,
    that process started then — a pid reused after the session exited is a different process.
    Liveness is read from `/proc` and nowhere else: no signal is ever sent, so a pid this file
    did not choose is never acted on, and a host without `/proc` gets None.

    NONE ALSO WHEN THE REGISTRY DOES NOT LIST `sid`. The session writing the index is running
    by definition, so a registry with no live record for it was read from the wrong config
    directory or across a pid namespace, and nothing it says about other sessions is
    believed. Every None leaves the index exactly as it was before this registry was read.
    """
    if not os.path.isfile("/proc/self/stat"):
        return None
    d = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"),
                     SESSIONS_DIR)
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json"))[:MAX_SESSION_RECORDS]
    except OSError:
        return None
    live = set()
    for n in names:
        rec = read_json_nofollow(os.path.join(d, n)) or {}
        pid, key = rec.get("pid"), rec.get("sessionId")
        if type(pid) is not int or pid <= 0 or not bare_name(key):
            continue
        started = _proc_start(pid)
        want = rec.get("procStart")
        if started is not None and (want is None or str(want) == started):
            live.add(key)
    return live if sid in live else None


def prune_dead_rows(d, sessions, sid, live=None):
    """Drop from OTHER sessions' index rows every issue their own file shows `stale`.

    A SESSION THAT NEVER RUNS AGAIN NEVER REACHES `heal_empty`: `~/Work`
    `e7dcb602` ended mid-turn on 2026-10-15 and was still listed open on 2026-10-29. So the
    session that is writing the index anyway reads that session's file and leaves out what
    it holds empty. THE FILE DECIDES, NOT THE ROW: `items_open: 0, agents_running: 0` is also
    what an issue holding only a cut agent shows, and that one is a handoff and stays listed.

    AN ISSUE INJECTED TEXT OPENED (`stale_notice`) is dropped too. Its row reads
    `items_open: 1`, the notice as its fallback, so its `ask`, the prompt's first 120
    characters, is what `INJECTED` is asked about. The file still decides.

    A SESSION THE REGISTRY SHOWS GONE (`live`, from `live_sessions`) has its finished issues
    dropped too, though their agents still read `running`. MEASURED 2026-10-29 in
    mutze-studio: `0555de28`, last written 2026-10-18, its transcript and agent meta files no
    longer on disk, was listed with eight issues whose every item was done and whose agents
    read `running` (i53 had eight). `agents_finished` and `agents_stopped` run only in the
    owning session, and a subagent cannot outlive the session that spawned it, so for a
    session not in the registry every `running` entry is over (`over_when_dead`). Its file is
    read whatever its rows show, because a row cannot tell a fallback from a written item.
    `live` None — no registry, an unreadable one, or one that does not list the writer —
    leaves every row as the two rules above alone would.

    READ-ONLY, and for a live session only for a row showing an issue at zero and zero or an
    injected ask, so the cost is paid once per dead row; for a dead one, once per dead session
    still listed. The other session's file is never written — it may be live, and its own
    next save rewrites its own row from that file, so a resumed session gets back every row
    this dropped. A key that is not one filename component, or a file this account cannot
    read as its own, leaves its row exactly as it was.
    """
    for key, row in list(sessions.items()):
        rows = row.get("open") if isinstance(row, dict) else None
        if key == sid or not isinstance(rows, list) or not bare_name(key):
            continue
        dead = live is not None and key not in live
        if not dead and not any(isinstance(r, dict)
                                and ((r.get("items_open") == 0 and r.get("agents_running") == 0)
                                     or INJECTED.search(str(r.get("ask") or "")))
                                for r in rows):
            continue
        other = read_json_nofollow(os.path.join(d, f"{key}.json"))
        if not isinstance(other, dict) or not isinstance(other.get("issues"), list):
            continue
        empty = {i.get("id") for i in other["issues"]
                 if stale(i) or (dead and over_when_dead(i))}
        kept = [r for r in rows if not (isinstance(r, dict) and r.get("id") in empty)]
        if kept:
            row["open"] = kept
        else:
            sessions.pop(key, None)


def issue_items(iss):
    """The items on an issue: objects with a non-empty string `ask`. Same definition as
    `checklist_items`, applied to the issue the checklist was absorbed onto."""
    items = iss.get("items") if isinstance(iss, dict) else None
    if not isinstance(items, list):
        return []
    return [i for i in items
            if isinstance(i, dict) and isinstance(i.get("ask"), str) and i["ask"].strip()]


def session_items(iss):
    """The items THE SESSION wrote: `issue_items` without the hook's fallback. Every verdict
    that can reach the user as a failure reads these alone (`judge_issue`, `unmet_asks`),
    because a fallback is the hook's record of the message and never evidence of undone work."""
    return [i for i in issue_items(iss) if i.get("fallback") is not True]


def item_done(item):
    """Whether an item is FINISHED OR WITHDRAWN. The STATUS IS THE SESSION'S TO WORD, so this
    reads the words a session actually writes rather than demanding one token; anything
    outside `DONE_STATUSES` is open. An item with no status at all is open, which is the
    direction that keeps work visible.

    A TRAILING FULL STOP IS NOT A DIFFERENT STATUS. `"dropped."` is the same answer as
    `"dropped"`, and an item held open by a period is the defect this function already had.
    """
    s = item.get("status")
    return isinstance(s, str) and s.strip().lower().rstrip(".") in DONE_STATUSES


def issue_agents(iss):
    """The agent entries on an issue: objects carrying a non-empty string `agent_id`."""
    ags = iss.get("agents") if isinstance(iss, dict) else None
    if not isinstance(ags, list):
        return []
    return [a for a in ags
            if isinstance(a, dict) and isinstance(a.get("agent_id"), str)
            and a["agent_id"].strip()]


def utc_now():
    """The ISO UTC second, the spelling transcript rows' `timestamp` compares against."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def close_issue(iss):
    """Close `iss` and stamp WHEN, the first time it closes; a re-close keeps a fresh stamp.

    WHY THE TIME (2026-11-10). The ledger recorded `state` and no time, so `bin/replay-seating`
    could only rebuild what a past Stop carried from TODAY's states: an issue closed after the
    Stop read as never carried, and a whole-session replay of mutze `30e77777` showed Stop 2007
    fall from "seated touch [carried i1]" to none with no code change behind it."""
    if iss.get("state") != "closed":
        iss["closed_at"] = utc_now()
    iss["state"] = "closed"


def item_key(item):
    """The key an item's done time is filed under: a digest of its words, never the words,
    so the ledger holds each ask once (`stamp_item`)."""
    return hashlib.sha256(str((item or {}).get("ask") or "")[:CARRY_ASK].encode("utf-8")
                          ).hexdigest()[:16]


def stamp_item(iss, item):
    """Record WHEN an item was done, on its issue's `done_at` map keyed by `item_key`;
    an open item loses its entry. The item's half of `close_issue`'s record, so a replay can
    tell what a past Stop still carried (an issue's close time bounds its items, it does not
    date them). On the ISSUE, after every other key, so an item keeps the `{ask, status}`
    shape every reader and fixture spells."""
    key = item_key(item)
    times = iss.get("done_at") if isinstance(iss.get("done_at"), dict) else {}
    if item_done(item):
        if key not in times:
            times[key] = utc_now()
    else:
        times.pop(key, None)
    if times:
        iss["done_at"] = times
    else:
        iss.pop("done_at", None)


def mark_item(iss, item, status):
    """Set an item's status and record its done time (`stamp_item`)."""
    item["status"] = status
    stamp_item(iss, item)


def reopen_issue(iss, state="open"):
    """Reopen `iss`: its close time no longer says anything. `state=None` drops the key, which
    `open_issues` reads as open (the fold-undo spelling)."""
    iss.pop("closed_at", None)
    if state is None:
        iss.pop("state", None)
    else:
        iss["state"] = state


def open_issues(led):
    """Every issue not yet closed, oldest first. An issue with no `state` is open."""
    return [i for i in led.get("issues", [])
            if isinstance(i, dict) and i.get("state") != "closed"]


def current_issue(led):
    """The issue a newly spawned agent belongs to: the NEWEST open one.

    NEWEST, because an agent is dispatched by the turn that is running now, and that turn
    is working the issue its own message opened. Oldest-first would link a coder to work
    the user raised yesterday. When nothing is open there is no issue to link to, and
    `link_agent` records nothing rather than inventing one.
    """
    opened = open_issues(led)
    return opened[-1] if opened else None


def add_issue(payload, led):
    """Append an issue for THIS user message and return it, or None when the message opens
    no work.

    THE GATE IS `start_checklist`'S, deliberately the same one: injected text is not the
    user's ask, and under a dozen words a message is almost always one ask and not a new
    issue ("commit it", "yes"). A slash command the user typed opens one at any length
    (`SLASH_COMMAND`). Reusing the gate means a message either opens an issue AND a
    checklist or neither, so the two can never disagree about whether work started.

    EARLIER OPEN ISSUES STAY. That is the whole point of the file.
    """
    prompt = payload.get("prompt") or ""
    if not opens_issue(prompt):
        return None
    n = 1
    for iss in led.get("issues", []):
        if isinstance(iss, dict) and isinstance(iss.get("id"), str):
            try:
                n = max(n, int(str(iss["id"]).lstrip("i") or 0) + 1)
            except ValueError:
                pass
    # THE MESSAGE IS ITS OWN FIRST ITEM FROM THE MOMENT IT IS SENT (`fallback_item`), because
    # this is the one event every user message reaches. See `track_message` for what was
    # measured when the item waited for the Stop.
    fallback = fallback_item(prompt, peer=payload.get("peer"))
    iss = {"id": "i%d" % n, "prompt": prompt[:2000], "state": "open",
           "items": [fallback] if fallback else [], "agents": [], "opened_at": utc_now()}
    # A PEER SESSION'S REQUEST NAMES ITS SENDER (`peer_request`), so a reader of the ledger
    # or the index can tell it from a message the user typed here.
    if isinstance(payload.get("peer"), dict):
        iss["peer"] = payload["peer"]
    led.setdefault("issues", []).append(iss)
    return iss


def fallback_item(prompt, status="open", peer=None):
    """The user's message as the hook's own item on its issue, or None for an empty one.

    Flattened to one line and cut to `CARRY_ASK`, the cut a carried row gets, so the session
    can mark it through the carry like any item it wrote. `fallback: true` keeps it out of
    `session_items`, so no verdict that can reach the user as a failure ever reads it. A peer's
    pointer is its label (`ask_text`), never the pointer's own sentence.
    """
    text = ask_text(prompt, peer)[:CARRY_ASK]
    return {"ask": text, "status": status, "fallback": True} if text else None


# ONE PEER MESSAGE DELIVERED SEVERAL TIMES IS ONE ISSUE. MEASURED 2026-11-11 in this
# repository's session `f9318dba`: codex-dev's notice was typed into the pane three times in
# 0.8 s and a reworded follow-up 0.7 s later (ids ...170148, ...170149 twice, ...170150, all
# from agent-say process 1117998), and they opened i16 to i19; ...161049 and ...161050 opened i14 and i15 the same way.
#
# WHAT SEPARATES A REPEAT FROM A SECOND MESSAGE, MEASURED the same day over this machine's 457
# transcripts (347 peer deliveries), each delivery compared with its sender's previous one by
# the body in agent-say's mailbox. Same body: 0.7, 0.8, 1.4 and 2.2 s apart from the same
# agent-say process, and once 5.3 s apart from another process. Different message: 234 pairs,
# the nearest 0.7 s from the same process (...170149 then ...170150, reworded) and 6.1 s from
# different processes; ra-root's relay kept one process for hours and sent six different
# messages from it, the nearest two 51 s apart. No envelope field separates all of them, so
# the rule takes the cheaper error each way: a pointer folds only from the SAME process within
# the window, a typed message only with the SAME words, never on sender and time alone. The
# 5.3 s resend from another process stays an issue of its own; the 0.7 s second message from
# one process is folded, and loses nothing, because the fold below records its id. Matching
# the id's last digit would miss ...161049 / ...161050, so the ids' own times are compared.
#
# The hook sees the pointer, never the message behind it, so a fold has to lose nothing: each
# repeat is recorded on the issue under `repeats`, and the session is told to read every id
# there. A message typed in whole carries no id, so for one the same sender's same words
# within the window are the repeat.
REPEAT_WINDOW = 10
# HOW MANY OF THE NEWEST ISSUES A DELIVERY IS COMPARED WITH, and how many repeats one issue
# keeps. A burst is a handful; the bound keeps a long-lived ledger from growing a list.
REPEAT_SCAN = 8
REPEATS_MAX = 10


def _iso_seconds(text):
    """The epoch second of a `utc_now` stamp, or None."""
    try:
        return calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ"))
    except (TypeError, ValueError):
        return None


def issue_repeats(iss):
    """The `repeats` an issue records, objects only, oldest first."""
    rows = iss.get("repeats") if isinstance(iss, dict) else None
    return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []


def repeat_of(led, payload, now=None):
    """The issue this peer delivery repeats (`REPEAT_WINDOW`), or None.

    The same sender, and either a pointer from the same agent-say process whose id is within
    the window of a delivery already on that issue, or a message typed in whole with the same
    words within the window of the last time that issue was delivered. A message the user
    typed is never a repeat: only a peer's delivery (`peer`) is compared.
    """
    peer = payload.get("peer")
    if not isinstance(peer, dict):
        return None
    who = peer_sender(peer)
    body = " ".join(str(payload.get("prompt") or "").split())
    if not who or not body:
        return None
    ptr = pointer_id(body)
    now = time.time() if now is None else now
    for iss in reversed([i for i in led.get("issues", []) if isinstance(i, dict)][-REPEAT_SCAN:]):
        if not isinstance(iss.get("peer"), dict) or peer_sender(iss["peer"]) != who:
            continue
        reps = issue_repeats(iss)
        if ptr is not None:
            seen = [pointer_id(iss.get("prompt"))] + [delivery_id(r.get("id")) for r in reps]
            if any(d and d[1] == ptr[1] and abs(d[0] - ptr[0]) <= REPEAT_WINDOW for d in seen):
                return iss
        elif body == " ".join(str(iss.get("prompt") or "").split()):
            last = [t for t in [_iso_seconds(iss.get("opened_at"))]
                    + [_iso_seconds(r.get("at")) for r in reps] if t is not None]
            if last and now - max(last) <= REPEAT_WINDOW:
                return iss
    return None


def note_repeat(iss, payload):
    """Record this delivery on the issue it repeats, newest last, at most `REPEATS_MAX`."""
    ptr = pointer_id(payload.get("prompt"))
    row = {"at": utc_now(), **({"id": ptr[2]} if ptr else {})}
    iss["repeats"] = (issue_repeats(iss) + [row])[-REPEATS_MAX:]


def stale_empty(iss):
    """Whether an issue is open with no item and no agent: the shape no issue opened by
    `add_issue` can have, since it is seeded, and the shape older releases left behind."""
    return (isinstance(iss, dict) and iss.get("state") != "closed"
            and not issue_items(iss) and not issue_agents(iss))


def stale_notice(iss):
    """Whether an issue is open, was opened by injected text, and holds nothing but that text:
    no agent, and every item either the hook's fallback or an ask `INJECTED` itself matches.

    THE CLASSIFIER IS `INJECTED`, the one `opens_issue` refuses an issue with, so an issue is
    healed for exactly the reason no issue is opened now. An older release's `INJECTED` missed
    `[Cross-session idle notice]`, and an issue it opened was seeded with the notice as its
    fallback, which is not `stale_empty` and is carried into every later turn as an open ask.

    ANY OTHER ITEM KEEPS IT OPEN: a session that wrote a real ask under a notice did work there.
    MEASURED 2026-10-29 over the 144 ledgers under `~` (fixtures and worktrees
    excluded): 14 issues have a prompt `INJECTED` matches, all idle notices. None holds an item
    the session wrote or an agent. 11 were closed by their sessions, 2 are open on their
    fallback alone (`efwnow.com` `00f55692` i2, `university` `bcf48e2e` i3), and 1 is open with
    no item (`university` `c978bd75` i25, already `stale_empty`).

    `prune_dead_rows` asks this of ANOTHER session's file, so a prompt that is not a string is
    read as one rather than raising.

    AN ISSUE A PEER'S REQUEST OPENED (`peer`) IS NEVER ONE: its prompt is the request's body,
    out of the tag (`peer_request`), and `opens_issue` opened it only because `INJECTED`
    does not match that body.
    """
    return (isinstance(iss, dict) and iss.get("state") != "closed"
            and bool(INJECTED.search(str(iss.get("prompt") or ""))) and not issue_agents(iss)
            and all(i.get("fallback") is True or INJECTED.search(i["ask"])
                    for i in issue_items(iss)))


def stale(iss):
    """Whether an open issue holds nothing to finish: `stale_empty` or `stale_notice`."""
    return stale_empty(iss) or stale_notice(iss)


def over_when_dead(iss):
    """Whether an open issue of a session that is NOT RUNNING holds nothing left to finish:
    what `judge_issue` makes of it with every `running` agent counted as over, read off a
    copy so the other session's record is never changed.

    `closed` IS THE VERDICT THAT DROPS, so the handoff rule is `judge_issue`'s own: an agent
    cut at its turn cap keeps the issue listed while a written item is open or none was
    written, and does not once every written item is finished. A written item still open
    (`kickback`) keeps it listed, since that is unfinished work on record.

    `tracked` DROPS TOO. It is a message the session never itemized, held only by the hook's
    fallback, which is never evidence of undone work, and which `track_message` retires at
    the next user message's Stop. A session that is not running has no next message; if it is
    resumed, its own save lists the issue again from its file.
    """
    over = dict(iss, agents=[dict(a, state="returned") if a.get("state") == "running" else a
                             for a in issue_agents(iss)])
    return judge_issue(over)[0] in ("closed", "tracked")


def heal_empty(led):
    """Close every open issue that is `stale`, its open items `superseded`. How many.

    WHAT IT HEALS, MEASURED 2026-10-29 in `~/Work`: four issues an older release
    left open with `items: []`, listed in `index.json` with `items_open: 0`, which nothing
    would ever close — no item to mark done and no agent to come back. An audit is not what
    reaches them, so the next message does. Each is given the user's message as its fallback
    item, already `superseded` (a later message has arrived, which is what that status
    means at `track_message`), and closed, which is what `judge_issue` would make of it.

    CALLED AT THE SUBMIT ONLY, AFTER THE OUTGOING LIST IS ABSORBED, so an issue whose items
    are still in the checklist file gets them first and is not healed. Never on a load that
    only consults the ledger (`wf-turn-budget._ledger_read`, which saves nothing).

    AN ISSUE INJECTED TEXT OPENED (`stale_notice`) is closed the same way. Its items are the
    notice and nothing else, so each one still open is marked `superseded` in place.
    """
    healed = 0
    for iss in open_issues(led):
        if stale_empty(iss):
            item = fallback_item(iss.get("prompt"), "superseded", iss.get("peer"))
            iss["items"] = [item] if item else []
        elif stale_notice(iss):
            for item in issue_items(iss):
                if not item_done(item):
                    mark_item(iss, item, "superseded")
        else:
            continue
        close_issue(iss)
        healed += 1
    return healed


def absorb_items(led, issue_id, items, title=""):
    """Copy a finished checklist's items onto their issue, replacing what is there.

    THIS IS WHAT MAKES THE WIPE SAFE. `start_checklist` removes the checklist file on every
    message, which is right for a per-turn artifact; absorbing first means the items the
    session wrote survive on the issue and the next message cannot erase them. Replacing
    rather than appending is correct because the checklist is the live view of that one
    issue's items, statuses included: a merge would resurrect an item the session struck.

    AN EMPTY LIST DOES NOT ERASE THE HOOK'S FALLBACK (`track_message`). A session that wrote
    no items has no live view to replace it with, and erasing it here would make the turn
    after `/agenda today` forget what that turn was working on. Items the session DID write
    replace it, because they say the same thing better.
    """
    if not issue_id:
        return
    own = next((i for i in led.get("issues", [])
                if isinstance(i, dict) and i.get("id") == issue_id), None)
    if own is None:
        return
    # A CONTINUATION STAYS WHERE IT WAS ASKED AND NAMES THE ISSUE IT CONTINUES. An item the
    # session tagged `"issue": "<earlier id>"` is this message's item, kept on this issue with
    # `"continues": "<that id>"`. The session decides what continues what; nothing here infers
    # it, and nothing here moves it.
    #
    # IT USED TO MOVE, and the move is the defect. Through 1.88.0 the item was appended to the
    # earlier issue and a message whose every item moved was folded (`merged`, `items: []`).
    # MEASURED 2026-11-11 in this repository's session `f9318dba`: codex-dev's messages i26
    # and i28 were folded empty, i25 held four near-identical items, and i27, folded over a
    # running coder, kept only the hook's fallback, the peer's pointer sentence, which the
    # next message carried back as open over the `answered` the session had written. The
    # user wants every ask visible where it was asked, so an issue whose own list held items
    # now holds those items. A context-only message's one `"answered"` item closes its own
    # issue at the Stop, which is what the fold was for; an unfinished continuation keeps its
    # own issue open rather than reopening the earlier one. A `merged` issue an older release
    # folded is unfolded when its message's list is absorbed again.
    known = {i.get("id") for i in led.get("issues", []) if isinstance(i, dict) and i is not own}
    mine = []
    for it in items:
        row = {"ask": it["ask"],
               "status": it["status"] if isinstance(it.get("status"), str) else "open"}
        link = it.get("issue")
        if isinstance(link, str) and link != issue_id and link in known:
            row["continues"] = link
        mine.append(row)
        stamp_item(own, row)
    if title:
        own["title"] = title
    if mine and own.pop("merged", None):
        reopen_issue(own, None)
    if not mine and any(i.get("fallback") is True for i in issue_items(own)):
        return
    # AN EMPTY LIST NEVER ERASES ITEMS THE SESSION WROTE. MEASURED 2026-10-28, mutze session
    # `6caae2f5`: i22's one written item was gone by the session's end, `items: []`. Both
    # ways here end in that write: a list holding nothing for this issue (another turn's
    # file, or a carry-only one), and a fold refused over a running agent (the fold was
    # removed after 1.88.0). A withdrawn ask is marked "dropped", never deleted, so nothing
    # legitimate is lost.
    if not mine and session_items(own):
        return
    own["items"] = mine


def carry_forward(led, skip=None):
    """The still-open items of this session's EARLIER open issues, newest issue first, as the
    rows this turn's checklist carries.

    THE DEFECT THIS CLOSES, measured 2026-10-13 in odyssey-alive's session `37f162e1`: an item
    could only be updated during the turn that wrote it. `start_checklist` replaces the
    per-turn checklist on every message and `absorb_items` copies the outgoing list onto ITS
    OWN issue alone, so once a turn ended its open items were frozen — there was no path by
    which the session could mark an earlier issue's item done, and the pile could only grow.
    Six issues were reported open on every Stop with several of them plainly handled.

    SO THE TURN IS GIVEN THEM AGAIN, tagged with the issue each one belongs to, in a field of
    their own. They are not this message's asks and never become them: `checklist_items` reads
    `items` and nothing here, so the widening agent still grades the turn against the message
    it was given.

    `skip` IS THIS MESSAGE'S OWN ISSUE, which has no items yet and would be carrying itself.
    An id that is not one bare name is dropped rather than carried, because the write-back
    takes it back as the name of the issue to touch.
    """
    rows = []
    for iss in reversed(open_issues(led)):
        iid = iss.get("id")
        if not bare_name(iid) or iid == skip:
            continue
        for item in issue_items(iss):
            if item_done(item):
                continue
            st = item.get("status")
            rows.append({"issue": iid, "ask": item["ask"][:CARRY_ASK],
                         "status": st.strip()[:40] if isinstance(st, str) and st.strip()
                         else "open"})
            if len(rows) >= MAX_CARRIED:
                return rows
    return rows


def untitled_issues(led, skip=None):
    """The ids of this session's open issues that have no title yet, oldest first.

    THE DEFECT THIS CLOSES, measured 2026-10-14 in odyssey-alive's session `a609a11d`: i9 was
    opened before titles shipped, and only the message that opens an issue was ever asked
    for a title, so i9 printed as an excerpt on every Stop with no way to get one. `skip` is
    this message's own issue, which its `"title"` field already covers.

    ONLY AN ISSUE THE ISSUES LINE KEEPS SHOWING. One judged `open` (nothing recorded against
    it) is never printed, and one judged `closed` closes at the next Stop. One judged
    `tracked` holds only the hook's fallback, which `track_message` retires at the next user
    message's Stop. MEASURED 2026-10-29 in mutze-studio `29c3e592`: "No title yet on i2, i3"
    was on every message for two queued follow-ups in that state. Asking any of the three
    for a title is noise.
    """
    return [i.get("id") for i in open_issues(led)
            if bare_name(i.get("id")) and i.get("id") != skip
            and not plain_text(i.get("title"), TITLE_MAX)
            and judge_issue(i)[0] not in ("open", "closed", "tracked")]


def absorb_titles(led, titles):
    """Set each title from `checklist_titles` on the OPEN, UNTITLED issue it names. How many
    landed.

    Open issues only, so a closed issue is never rewritten; untitled only, so a title the
    session already gave is never replaced by a later map; an id the ledger does not hold
    changes nothing. A missing title is never an error: the ISSUES line falls back to
    the excerpt of the user's words, as it always did.
    """
    landed = 0
    for iss in open_issues(led):
        title = titles.get(iss.get("id"))
        if title and not plain_text(iss.get("title"), TITLE_MAX):
            iss["title"] = title
            landed += 1
    return landed


def carried_items(cl):
    """The carried rows on a checklist: objects naming an `issue`, an `ask` and a `status`.
    `checklist_items`' rule for the other list, with the issue id validated as the one name
    it will be used as. A `carried` that is not a list carries nothing.

    CAPPED ON THE WAY IN AS WELL AS ON THE WAY OUT. The hook writes at most `MAX_CARRIED`
    rows, but the file is the SESSION's to rewrite and the read is a plain `json.load`, so a
    list this reader trusts is a list whose length somebody else chose — and every row costs
    a walk of the ledger's issues and their items, on every message and every Stop. Reading
    the same number back that `carry_forward` wrote is the bound, and it drops nothing the
    hook put there.
    """
    rows = cl.get("carried") if isinstance(cl, dict) else None
    if not isinstance(rows, list):
        return []
    return [r for r in rows[:MAX_CARRIED]
            if isinstance(r, dict) and bare_name(r.get("issue"))
            and isinstance(r.get("ask"), str) and r["ask"].strip()]


def absorb_carried(led, rows):
    """Write each carried row's STATUS back onto the issue it names. How many landed.

    STATUS ONLY, AND ONLY ONTO AN ITEM ALREADY THERE. This write reaches an issue other than
    the one this turn opened, as `absorb_items` does for an item the session tagged with
    `"issue"`, so it could corrupt another issue's record — and the three things it must
    never do are the three things it cannot do here. It never appends (the item is found, or the row is dropped), never
    reorders (each item is edited in place), and never resurrects (a row naming an issue that
    has closed is ignored, and `open_issues` is what decides that).

    An item is found by the ask CUT TO `CARRY_ASK`, the same cut `carry_forward` made on the
    way out, so the two ends agree on long asks. A row carrying no status, or one naming an
    item nobody can find, changes nothing.

    AND A FINISHED ITEM IS NEVER REOPENED BY A ROW. `carry_forward` hands out open items only,
    so a carried row saying "open" against a finished item is a row older than the mark that
    finished it — another message's list closing it late (`late_marks`), or rows the hook put
    back (`restore_carried`). Moves among unfinished statuses still land.
    """
    landed = 0
    for row in rows:
        st = row.get("status")
        if not isinstance(st, str) or not st.strip():
            continue
        for iss in open_issues(led):
            if iss.get("id") != row["issue"]:
                continue
            want = st.strip()[:40]
            for item in issue_items(iss):
                # A ROW THE SESSION LEFT ALONE IS NOT A WRITE. The count is what decides
                # whether the ledger is saved, so counting an unchanged status would save
                # the file on every message that carries anything.
                if (item["ask"][:CARRY_ASK] == row["ask"] and item.get("status") != want
                        and (item_done({"status": want}) or not item_done(item))):
                    mark_item(iss, item, want)
                    landed += 1
            break
    return landed


# THE MOST PER-MESSAGE LISTS ONE STOP RE-READS for marks written after their own turn ended,
# newest message first (`late_marks`). The scratchpad keeps a list until a later submit
# removes it, and one whose record aged out of the tag (`EARLIER_MAX`) is never removed, so
# the directory's count is not this hook's to trust. Each list read costs a walk of the
# ledger's open items.
LATE_MAX = 32


def late_marks(payload, led):
    """Copy every FORWARD move the session wrote into this session's per-message lists onto
    the ledger: an item open there and finished in a list. How many landed.

    THE DEFECT THIS CLOSES, MEASURED 2026-11-07 in tmux-revive `ca202cd9`: the session finished
    i31's and i33's asks by setting "done" in `wf-asks.<sid>.i31.json` and `.i33.json`, the
    lists of the messages that opened them, after those messages' Stops had absorbed them.
    Nothing reads a list again after its own turn, so the ledger kept both issues open while
    the work was done and committed. Telling the session to use the carried rows instead is
    the rule it already ignored; reading where it did write is the fix.

    FORWARD ONLY, AND ONLY ONTO WHAT IS THERE, which is `absorb_carried`'s contract with one
    more rule. An item already finished is never touched, so a stale list cannot reopen it; a
    status that is not finished is ignored, so a list cannot hold an item open either. Nothing
    is appended, and a closed issue is never written (`open_issues`). Each item lands on the
    issue `absorb_items` put it on, the message's own, which the file's key names, whatever
    issue it `"continues"`. Carried rows name their issue themselves.

    IT ALSO RUNS BEFORE ANY CARRIED ROW IS BUILT (`start_checklist`, `restore_carried`,
    `open_elsewhere`), because a row built from a ledger that has not read a list's newer
    mark hands a finished item back as open. MEASURED 2026-11-10 in this repository's
    session `f9318dba`, 17:33: i2's ask was marked `answered` in i2's list while i3 was
    queued, and i3's display restored it as an open carried row.

    THE SESSION'S FILES ONLY. The name must be exactly `checklist_path`'s for a keyed record
    of this session (`wf-asks.<state component>.i<N>.json`, or the bare one), in the
    directory `checklist_path` uses, and every read is `read_json_nofollow`: no link, and a
    regular file this account owns. `open_elsewhere` reads queued lists by the same rules.

    AND A NAME IS CHECKED AS A REGULAR FILE OF THIS ACCOUNT BEFORE IT IS OPENED, because this
    is the one reader here that takes its names from a listing. `read_json_nofollow` cannot
    refuse a FIFO (its `os.open` blocks first), and with no scratchpad the directory is
    `TMPDIR` or `/tmp`, where another account can make a FIFO under any name it lists: one
    planted name would hang every Stop. A sticky directory stops that account replacing a
    file of ours after the check.
    """
    issues = {i.get("id"): i for i in open_issues(led)}
    if not issues:
        return 0
    bare = checklist_path(payload)
    d, lead = os.path.dirname(bare), os.path.basename(bare)[:-len(".json")] + "."
    uid = getattr(os, "getuid", lambda: None)()
    keys = []
    try:
        with os.scandir(d) as entries:
            for e in entries:
                k = e.name[len(lead):-len(".json")]
                if (e.name.startswith(lead) and e.name.endswith(".json")
                        and CHECKLIST_KEY.fullmatch(k) and e.is_file(follow_symlinks=False)
                        and (uid is None or e.stat(follow_symlinks=False).st_uid == uid)):
                    keys.append(int(k[1:]))
    except OSError:
        return 0
    keys.sort(reverse=True)
    landed = 0
    for key in [f"i{k}" for k in keys[:LATE_MAX]] + [None]:
        cl = read_json_nofollow(os.path.join(d, f"{lead}{key}.json") if key else bare)
        marks = [(r["issue"], r) for r in carried_items(cl)]
        marks += [(key, it) for it in (checklist_items(cl) if key else ())]
        for iid, row in marks:
            iss = issues.get(iid)
            if iss is None or not item_done(row):
                continue
            want = row["status"].strip()[:40]
            for item in issue_items(iss):
                if item["ask"][:CARRY_ASK] == row["ask"][:CARRY_ASK] and not item_done(item):
                    mark_item(iss, item, want)
                    landed += 1
    return landed


def track_message(led, issue_id, written):
    """At the Stop ending a USER message's turn: retire earlier fallbacks, and record this
    message as one fallback item when the session itemized nothing.

    THE GAP, MEASURED 2026-10-14 in odyssey-alive's session `a609a11d`: a session that never
    writes its checklist leaves an issue with no items, `judge_issue` calls that `open`, and
    `wf-widen` prints nothing — two hours of work on `/agenda today` showed no ISSUES at all.
    The user: *"it gives transparency on what is being worked on."* So the message itself
    becomes the item, `{"ask": <the message>, "status": "open", "fallback": true}`, ONLY when
    the issue has no items and no agents and the session's own checklist (`written`) is empty.
    The text is the message flattened to one line and cut to `CARRY_ASK`, the cut a carried
    row gets, so the session can mark it through the carry like any other item.

    IT IS NEVER A KICKBACK. The session did not write it, and the ledger never infers an
    undone item, so `judge_issue` reads `session_items` for every failing verdict and gives a
    fallback its own: `tracked`.

    HOW LONG AN UNMARKED ONE LIVES: until the NEXT user message's turn ends. That is the
    checklist's own precedent — a per-turn record is replaced by the next message
    (`start_checklist`) — held one turn longer so the carry can reach it: that next turn is
    handed the fallback as a carried row and can mark it `done`, `answered` or `dropped`, and
    whatever it leaves unmarked is `superseded` here, which `DONE_STATUSES` already reads as
    finished. Injected turns (a hand-back, a notification) are not user messages and supersede
    nothing, so the line stays up while dispatched work comes back. ISSUES therefore shows at
    most one fallback, the newest message's, and never a pile of stale one-liners.

    THE ITEM IS NOW WRITTEN AT THE SUBMIT (`add_issue`), and only the supersede is this
    Stop's. MEASURED 2026-10-29 in `~/Work`, three issues stayed `items: []`
    because the Stop never had the right issue to give one to: `e7dcb602` i1's session ended
    six seconds after its submit and no Stop ran, and in `b6047346` and `3ca2e8f7` the NEXT
    message's submit fired at ENQUEUE, mid-turn (17:21:55 against a 17:21:59 Stop), so the
    tag's one record named the newer issue — that Stop printed `i2 TRACKED` and i1 kept
    nothing. The add below remains for an issue an older release opened unseeded.

    ONLY ISSUES OPENED BEFORE THIS ONE ARE SUPERSEDED. A queued message's issue is opened at
    its enqueue, before the running turn's Stop (`earlier_records`), and that Stop now tracks
    the earlier message's issue. Superseding every other issue would close the queued one
    before its own turn began; it is the later message, so nothing has replaced it yet.

    A PEER SESSION'S REQUEST (`peer`) SUPERSEDES NOTHING EITHER. It opens an issue like a
    user's message, but another session speaking is not the user moving on: in odyssey-alive
    `de3efe49` (2026-10-30) wf-dev's two replies would each have retired the user's tracked
    issue. Its own fallback is retired by the next message the user sends, as any is.
    """
    target = None
    peer = any(issue_id and iss.get("id") == issue_id and isinstance(iss.get("peer"), dict)
               for iss in open_issues(led))
    for iss in open_issues(led):
        if issue_id and iss.get("id") == issue_id:
            target = iss
            continue
        if target is not None or peer:
            continue
        for item in issue_items(iss):
            if item.get("fallback") is True and not item_done(item):
                mark_item(iss, item, "superseded")
    if target is None or written or issue_items(target) or issue_agents(target):
        return
    item = fallback_item(target.get("prompt"), peer=target.get("peer"))
    if item:
        target["items"] = [item]


def _note_key(text):
    """One intention's identity for merging: case, spacing and trailing punctuation aside."""
    return " ".join(text.lower().split()).rstrip(".,;:!")


def note_intentions(led, issue_id, texts):
    """Record what a reply SAID it would do next on the issue being worked, under `noted`.
    `(issue id, the wordings newly noted)`, or `(None, [])` when nothing landed.

    WHAT IT REPLACES. `wf-commitments` kept these in a per-project list that no turn could
    close and that filled with fragments; the user retired it on 2026-10-14 ("Retire it,
    fold in"). The issue they belong to is where they are worth reading.

    A FIELD OF ITS OWN, AND NOTHING THAT JUDGES READS IT. `judge_issue`, `carry_forward`,
    `unmet_asks` and both absorbs read `items`, never `noted`, so a noted intention can
    never become a KICKBACK, a HANDOFF, a carried row or a reason an issue stays open. The
    ledger never infers an undone item, and a regex reading the reply is inference. The
    session may PROMOTE one by writing it into its checklist, which makes it an item the
    session authored, judged like any other.

    WHICH ISSUE: this message's own (`issue_id`) while it is open, else the newest open
    issue (`current_issue`, the rule an agent is linked by), which is where a hand-back
    turn's "I'll merge it" belongs. With no open issue there is nowhere to note it.

    DUPLICATES MERGE. The same words, or one wording contained in the other, are one
    intention; the longer wording is kept, so a turn restating its plan adds nothing.
    """
    target = None
    for iss in open_issues(led):
        if issue_id and iss.get("id") == issue_id:
            target = iss
    target = target or current_issue(led)
    if target is None:
        return None, []
    noted = target.get("noted")
    noted = ([n for n in noted if isinstance(n, str) and n.strip()]
             if isinstance(noted, list) else [])
    before = list(noted)
    for t in texts:
        k = _note_key(t) if isinstance(t, str) else ""
        if not k:
            continue
        keys = [_note_key(n) for n in noted]
        if any(k in o for o in keys):
            continue
        shorter = [i for i, o in enumerate(keys) if o in k]
        if shorter:
            noted[shorter[0]] = t
            noted = [n for i, n in enumerate(noted) if i not in shorter[1:]]
        else:
            noted.append(t)
    fresh = [n for n in noted if n not in before]
    if not fresh:
        return None, []
    target["noted"] = noted[-MAX_NOTED:]
    return target.get("id"), [n for n in fresh if n in target["noted"]]


ISSUE_ID = re.compile(r"(?<![\w-])(i\d{1,4})(?![\w-])")
TITLE_MAX = 60
TASK_MAX = 200
# THE EXCERPT THAT STANDS IN FOR A MISSING TITLE on a Work row. It is the user's or a peer's
# words, so it is several paragraphs as often as not: flattened to one line before it is cut,
# or the row breaks across the screen and the cut counts blank lines as words.
EXCERPT_MAX = 120


def plain_text(value, limit):
    """Session- or agent-written text made safe for one status line: one line, no control
    characters, cut to `limit`. "" for anything that is not a non-empty string."""
    if not isinstance(value, str):
        return ""
    one = " ".join("".join(c if c.isprintable() else " " for c in value).split())
    return one[:limit]


def agent_meta(payload, aid):
    """The harness's own record of an agent, as a dict, or None.

    THE HARNESS ALREADY RECORDS IT: every agent has `subagents/agent-<id>.meta.json` beside
    the session transcript, holding `agentType` and `description`. Read, never trusted as a
    path: `aid` is checked as one bare component before it is joined, and the file is read
    without following a link."""
    if not bare_name(aid):
        return None
    tp = payload.get("transcript_path")
    sid = payload.get("session_id")
    if not isinstance(tp, str) or not tp:
        return None
    base = os.path.dirname(tp)
    names = [os.path.join(base, "subagents", f"agent-{aid}.meta.json")]
    if bare_name(sid):
        names.insert(0, os.path.join(base, sid, "subagents", f"agent-{aid}.meta.json"))
    for path in names:
        meta = read_json_nofollow(path)
        if isinstance(meta, dict):
            return meta
    return None


def agent_task(payload, aid):
    """The task description the session gave an agent when it started it, or ""."""
    return plain_text((agent_meta(payload, aid) or {}).get("description"), TASK_MAX)


def issue_named(led, text):
    """The open issue a piece of text names by id (`i11`, `[i11]`), or None. The first id
    that is an OPEN issue wins; an id that names nothing open is ignored, never invented."""
    if not isinstance(text, str):
        return None
    opened = {i.get("id"): i for i in open_issues(led)}
    for m in ISSUE_ID.finditer(text):
        if m.group(1) in opened:
            return opened[m.group(1)]
    return None


def agents_stopped(led, transcript_path):
    """Mark `stopped` every running agent the main transcript says was stopped. The count.

    A STOPPED AGENT FIRES NO `SubagentStop`, so without this its entry reads `running`
    forever and its issue holds on an agent that is gone (measured 2026-10-14: three issues
    held for hours on coders stopped with TaskStop). The harness writes a
    `<task-notification>` naming the task id and `<status>killed</status>` into the main
    transcript; that row, not an inference, is what this reads."""
    if not isinstance(transcript_path, str) or not transcript_path:
        return 0
    running = {}
    for iss in open_issues(led):
        for a in issue_agents(iss):
            if a.get("state") == "running":
                running[a["agent_id"]] = a
    if not running:
        return 0
    try:
        with open(transcript_path, "rb") as fh:
            raw = fh.read().decode("utf-8", "replace")
    except OSError:
        return 0
    n = 0
    for m in STOPPED_NOTICE.finditer(raw):
        a = running.get(m.group(1))
        if a is not None and a.get("state") == "running":
            a["state"] = "stopped"
            n += 1
    return n


STOPPED_NOTICE = re.compile(
    r"<task-id>([\w-]{1,64})</task-id>(?:(?!</task-notification>).){0,600}?"
    r"<status>(?:killed|stopped|cancell?ed)</status>", re.S)


def agents_finished(led, payload):
    """Mark `returned` every `running` entry that is not a live round. The count.

    A RESUMED AGENT IS LINKED AGAIN, so one id can sit on several issues. MEASURED
    2026-10-28, mutze session `6caae2f5`: `af88605b6ba45d04d` was `running` on six issues
    after it had finished, and those issues held forever. One agent runs one round at a
    time, so every `running` entry older than the id's newest one is over. The newest is
    over when the harness's meta file says `"finished": true`; that key is harness state,
    MEASURED on this host on 2026-10-28 (absent on the five agents still writing, `true` on
    every stopped one). Anything else leaves it `running`, the recoverable direction.
    """
    entries = {}
    for iss in led.get("issues", []):
        for a in issue_agents(iss):
            entries.setdefault(a["agent_id"], []).append(a)
    n = 0
    for aid, seen in entries.items():
        stale = [a for a in seen[:-1] if a.get("state") == "running"]
        newest = seen[-1]
        if newest.get("state") == "running" and (
                agent_meta(payload, aid) or {}).get("finished") is True:
            stale.append(newest)
        for a in stale:
            a["state"] = "returned"
        n += len(stale)
    return n


def newest_entry(led, aid):
    """`(issue, entry)` for the NEWEST entry carrying `aid`, or `(None, None)`.

    NEWEST, because a resumed agent is linked again on the issue current at the resume
    (`agents_finished`), and its stop belongs to that round. Oldest-first sent every later
    stop to the first issue and left the newer entries `running` forever."""
    for iss in reversed(led.get("issues", [])):
        for a in reversed(issue_agents(iss)):
            if a.get("agent_id") == aid:
                return iss, a
    return None, None


def link_agent(payload, led):
    """Link the starting agent to the issue being worked, as `running`. The issue id, or None.

    `issue → agent_ids` with a state, which is K2c's shape. NEVER WITHOUT AN `agent_id`:
    that is the only field that tells an agent apart from the session that spawned it
    (fact 22b), so without one there is nothing to key an entry by and a guessed key would
    attach one agent's result to another's name.
    """
    aid = agent_component(payload)
    if not aid:
        return None
    task = agent_task(payload, aid)
    # THE ISSUE THE TASK NAMES, when it names an open one, and only then the newest: an agent
    # started for i11 while the user is already on i23 belongs to i11 (measured 2026-10-14).
    iss = issue_named(led, task) or current_issue(led)
    if iss is None:
        return None
    for a in issue_agents(iss):
        if a.get("agent_id") == aid:
            a["state"] = "running"
            return iss.get("id")
    iss.setdefault("agents", []).append(
        {"agent_id": aid, "agent_type": str(payload.get("agent_type") or ""),
         "state": "running", "judgment": None})
    return iss.get("id")


def agent_returned(payload, led, judgment, delivered=False, cut=True):
    """Record the stopping agent's judgment ON ITS OWN ISSUE, and settle its state.

    THE ISSUE IS FOUND BY THE AGENT'S ID, never by which issue is newest. That is the
    no-cross-talk rule: two issues are open, each has two agents, and the hand-backs
    interleave, so "the current issue" is the wrong answer for every stop but the luckiest.
    Of that id's entries it takes the NEWEST (`newest_entry`): a resume links it again.
    An agent whose id appears on no issue is an agent this session never linked, and
    nothing is recorded for it — a stop with no `agent_id` is NOT KEYABLE and is never
    given a guessed one.

    A STOP DOES NOT UNDO A `handoff`, AND THAT IS THE DEFECT A REAL END-TO-END RUN FOUND
    (2026-10-13, session `68b82f98`). A `maxTurns: 10` IC was cut at its cap three times
    and finished on the third. `wf-turn-budget` marked it `handoff` at every cut — and this
    function, called from `wf-widen`'s `SubagentStop` moments later, overwrote the mark
    with `returned` every time. The main `Stop` therefore judged the issue as "all agents
    back, items open" and printed a KICKBACK; the one line the whole K8 mechanism exists to
    print — resume THIS agent with `SendMessage` — never appeared in that session at all.
    The harness's own cut notice is what got the run resumed, which is luck, not a product.

    So the state a cut agent stops in is the state it keeps, and TWO THINGS RETIRE THE
    MARK HERE. `delivered` says this stop left the report its order asked for with nothing
    still UNMET in it (`wf-widen.report_delivered`). `cut` says this stop ended a round at
    or past its turn budget; `cut=False` is an agent that CAME BACK ON ITS OWN, and an
    agent that came back is finished with the round a previous cut marked it for, report or
    no report. The second half was missing until 2026-10-13: in session `83ab658c` a filer
    cut in rounds 1 and 2 returned normally in round 3, and the mark from round 2 survived
    its return, so the issue stayed `handoff` and the next main `Stop` would have demanded
    a resume of an agent that had finished. The third retirement is the issue closing
    (`judge_ledger`), which is the half that holds when the cut lands before this event
    fires at all.

    THE DEFAULTS ARE THE RECOVERABLE DIRECTION, which is why they are not symmetrical:
    `delivered=False` and `cut=True` both KEEP the mark, because a `handoff` kept one stop
    too long asks for one resume too many, where a `handoff` dropped once is a run nobody
    is ever told to continue. A caller that cannot tell whether the stop was a cut — a
    counter it could not verify — passes nothing and keeps the mark.

    A RESUMED AGENT IS PUT BACK TO `running` BY `agent_resumed`, at its next tool call, so
    the round logic downstream still sees `running` → `handoff` → `running` and never a
    `handoff` agent that is secretly working.

    Returns the issue id it landed on, or None.
    """
    aid = agent_component(payload)
    iss, a = newest_entry(led, aid) if aid else (None, None)
    if a is None:
        return None
    a["judgment"] = str(judgment or "")[:500]
    if a.get("state") != "handoff" or delivered or not cut:
        a["state"] = "returned"
    return iss.get("id")


def agent_resumed(payload, led):
    """Put a RESUMED agent back to `running` on its own issue. Issue id, or None.

    `wf-turn-budget` calls this on the first tool call after a cut, so an entry never sits
    at `handoff` while the agent is working and `judge_issue` never asks the user to resume
    an agent that is already resumed. A resume DOES fire `SubagentStart` for a background
    agent — MEASURED 2026-10-28, mutze session `6caae2f5`, seven `link_agent` entries for
    one id — so `link_agent` may already have put it back to `running` on the current
    issue. The `handoff` it left on the older issue is that round's mark, and it is
    retired to `returned` here: left alone, `held_by` refuses this role's spawns and the
    old issue asks for a resume of an agent that is running.

    ONLY FROM `handoff`, and None otherwise, so the caller writes nothing on an ordinary
    call. An agent already `running` is the common case and must cost no ledger write.
    """
    aid = agent_component(payload)
    iss, a = newest_entry(led, aid) if aid else (None, None)
    if a is None:
        return None
    moved = None
    for old in led.get("issues", []):
        for b in issue_agents(old):
            if b is not a and b.get("agent_id") == aid and b.get("state") == "handoff":
                b["state"] = "returned"
                moved = old.get("id")
    if a.get("state") == "handoff":
        a["state"] = "running"
        moved = iss.get("id")
    return moved


# ── and the guard's reader: who is still holding work of this role ──────────
# THE WRONG ACTION HAS A NAME NOW. MEASURED 2026-10-13, session `bb8a3e53` (trial e2e3): a
# `maxTurns: 10` filer was cut, and in the SAME main turn the session spawned a SECOND
# filer with the `Agent` tool ("Filer continues notes 09-20") and then a THIRD. Both cut
# agents sat at `handoff` in the ledger for the rest of the session and neither was ever
# resumed. The K8 kickback that names the resume lives on the main `Stop`, and that
# session never stopped between the three dispatches, so the one line that would have
# corrected it had no event to fire on. Reading the hand-off wording as "start a fresh run
# from the brief" is the measured failure, and it is a wrong ACTION, which means it can be
# refused where it is taken rather than argued with afterwards.
#
# WHY THE AGE AND NOT ONLY THE STATE. This list denies a tool call. A `handoff` mark that
# outlives its agent would deny that call forever, and a session with no way to spawn is
# worse than one that spawns the wrong thing. So the mark expires: `agent_handoff` stamps
# `handoff_at`, and a mark with no stamp — every mark written by a release before this one
# — reads as stale and refuses nothing. The window is wider than any measured gap by three
# orders of magnitude (the whole of trial e2e3, all three filers, ran 194 s) and short
# enough that a session picked up the next day is never held by it.
HANDOFF_STALE_AFTER = 1800


def held_by(led, agent_type):
    """The ids of `agent_type` agents this session cut and has NOT resumed yet.

    Empty is the answer for every question this guard should not answer: a session with
    no ledger, a cut agent on any issue but the current one (a different order), an agent
    of a different role, a mark an
    `agent_resumed` has already retired, and a mark too old to be about a live agent. A
    caller that gets `[]` allows the spawn.

    NO INJECTABLE CLOCK AND NO INJECTABLE WINDOW. The one caller passes neither, and a
    parameter nothing passes is a second way for this to answer that nothing tests. The
    fixture moves the LEDGER's stamp instead (`script-conformance`'s `${NOW}`), which is
    the same question asked of the real clock.
    """
    if not isinstance(led, dict) or not isinstance(agent_type, str) or not agent_type:
        return []
    # ONLY THE CURRENT ISSUE HOLDS A ROLE. A spawn is linked to the newest open issue
    # (`current_issue`), so a cut agent on an OLDER issue is holding different work, and a
    # fresh agent of its role now is a new order, not a replacement. The measured defect
    # (trial e2e3) re-spawned in the same turn, on the same issue, and is still refused.
    # The older issue's cut agent is still named for resume by the main `Stop`.
    now = time.time()
    held = []
    cur = current_issue(led)
    for iss in [cur] if isinstance(cur, dict) else []:
        for a in issue_agents(iss):
            if a.get("state") != "handoff" or a.get("agent_type") != agent_type:
                continue
            at = a.get("handoff_at")
            if not isinstance(at, int) or not 0 <= now - at <= HANDOFF_STALE_AFTER:
                continue
            aid = a.get("agent_id")
            if isinstance(aid, str) and aid and aid not in held:
                held.append(aid)
    return held


# ── and the one action both of this mechanism's hooks name ──────────────────
# ONE SENTENCE, TWO HOOKS. `wf-widen` says it to the session at the main `Stop`; the
# `PreToolUse` deny in `wf-turn-budget` says it in the turn the wrong spawn is attempted.
# Until 2026-10-13 each hook spelled it out in its own file, and the two had already
# drifted: the deny argued the rung inline and dropped the kept-context clause, the stop
# carried the clause and put the rung at the end. One mechanism, two differently-argued
# versions of its single action — and an edit to either leaves the other saying the old
# thing. It lives here because this is the module both hooks already load, and because the
# ledger this sentence is about is this module's.
#
# THE WORDS ARE CHOSEN, NOT ARRANGED: "successor", "re-dispatch" and "spawn" are absent on
# purpose, because the measured failure (session `bb8a3e53`) was a hand-off read as a
# brief for a fresh run.
def name_agents(ids):
    """The ids safe to say out loud, as one string — or a phrase naming none of them.

    THE VALIDATION LIVES WITH THE NAMING, which is the whole reason this is a function
    and not a `", ".join` at each call site. These ids come off a JSON file in the
    repository — a file a person, another tool or a bad merge can edit — and the
    sentences built from them land in `permissionDecisionReason` and in the stop's
    `systemMessage`: the model's context and the user's channel. A caller that joins
    first and validates second is a caller that can forget the second half, and one did:
    421a89c validated the deny and left the `Stop` quoting whatever the ledger said
    (fixture `widen-handoff-a-planted-agent-id-is-never-quoted`).

    AN UNNAMEABLE ID IS DROPPED, NOT ESCAPED. `bare_name` is an allowlist, so there is no
    argument about which spellings a stripper misses. With nothing nameable left the
    sentence still reads correctly and simply names no one — the instruction is the
    valuable part, and reading the planted string out loud is the injection.
    """
    return ", ".join(a for a in ids if bare_name(a)) or "the agent on this issue"


def name_labelled(agents, key, unknown="?"):
    """`name_agents` for the STATUS lines, which say `id (type)` or `id (state)`.

    The same refusal, applied to BOTH halves: an agent nobody can name is dropped, and a
    qualifier nobody can name is replaced by `unknown` rather than printed. The status
    line travels with the action line into the same `systemMessage`, so validating one
    and not the other would leave the door open by exactly one string.
    """
    out = []
    for a in agents:
        aid = a.get("agent_id")
        if not bare_name(aid):
            continue
        tag = a.get(key)
        out.append("%s (%s)" % (aid, tag if bare_name(tag) else unknown))
    return ", ".join(out) or "the agent on this issue"


def resume_action(ids):
    """The one action a cut agent's issue takes, naming the ids it can name.

    IT TAKES THE LIST, NOT FINISHED TEXT, so no caller can hand this formatter an id
    nobody validated: `name_agents` is applied here, inside the one definition both
    hooks read. `wf-turn-budget` keeps a `bare` filter of its own as well, because there
    it decides WHETHER to deny at all rather than merely what to quote.
    """
    return ("→ RESUME {who} with SendMessage: tell it to continue from its own "
            "HANDOFF.md, at the exit criteria still UNMET. If that HANDOFF.md names a "
            "running job's log and done-line, first arm ONE watcher on that line "
            "(Monitor, or a timeout-capped background wait) and resume when it fires. "
            "Its context is already loaded and a resume gives it a fresh turn "
            "allowance (org.md rung 12b). "
            "Do not start this work over with anyone else.").format(who=name_agents(ids))


def unmet_asks(iss):
    """ONE issue's UNMET set — the asks the session itself has not marked done."""
    return [i["ask"] for i in session_items(iss) if not item_done(i)]


def unmet_digest(iss):
    """A fingerprint of ONE issue's UNMET set — what is still open, in the session's words.

    EQUAL DIGESTS AT TWO HAND-OFFS MEANS NOTHING MOVED BETWEEN THEM, which is HALF of the
    loop guard: the guard is progress, never a count of resumes, because a count would
    escalate an agent that is finishing something large and let a stuck one be resumed
    twice first. The other half is the agent's own writes — see `agent_handoff`, and see
    why this one cannot carry the case alone.

    THE ITEM STATUSES ARE THE EVIDENCE THIS FILE HOLDS. The plan words the test as
    "OUTPUT.md unchanged"; that path is named in a HANDBOOK and reaches no hook — the hook
    is told an `agent_id`, not a deliverable path — so hashing the file would mean guessing
    where it is. The asks the session has not marked done are the same evidence
    `judge_issue` already kicks back on, and the only kind this project acts on.

    AN EMPTY UNMET SET DIGESTS TO sha256("") AND IS NOT EVIDENCE OF ANYTHING. Every issue
    whose checklist the session has not written yet produces that same value, which is how
    the measured false stall happened: see `agent_handoff`.
    """
    return hashlib.sha256("\n".join(unmet_asks(iss)).encode("utf-8")).hexdigest()[:16]


def agent_handoff(payload, led, writes=None):
    """Mark the agent that hit its TURN CAP `handoff` ON ITS OWN ISSUE. Issue id, or None.

    `wf-turn-budget` calls this at its final threshold, which is the moment the run is
    about to end with work left. THE ISSUE IS FOUND BY THE AGENT'S ID, for
    `agent_returned`'s reason: two issues' agents interleave, so "the newest issue" is the
    wrong answer for every mark but the luckiest. An agent whose id appears on no issue is
    one this session never linked, and nothing is recorded rather than guessed.

    THE SECOND MARK IS THE ONE THAT MATTERS, AND STALLED IS NOW MEASURED FROM TWO THINGS.
    `handoff_digest` is the issue's UNMET set and `handoff_writes` is how many files the
    agent had written or edited, counted from its own transcript by the caller. A mark is
    `handoff_stalled` only when ALL THREE hold:

      * there IS an unmet set — a session that has not written its checklist yet digests
        to sha256(""), and two of those in a row say nothing about the agent;
      * that set is the one the previous mark left, so nothing the session tracks moved;
      * and the agent wrote NOTHING new in the round it just spent.

    MEASURED 2026-10-13, which is why the third test exists. In session `68b82f98` a
    `maxTurns: 10` IC wrote eight files in its first round and eight more in its second,
    and was flagged `handoff_stalled` at the second cut — because the issue had no items
    recorded yet, so both marks carried the digest of the empty set, and the agent's actual
    output was measured by nothing. An absent report is not an unchanged one, and an issue
    with no checklist is not a stalled issue. `writes=None` means the caller could not
    count (no readable transcript), and then the digest decides alone, which is the
    behaviour that shipped before — never worse than it, and gated on a non-empty set.
    """
    aid = agent_component(payload)
    iss, a = newest_entry(led, aid) if aid else (None, None)
    if a is None:
        return None
    digest = unmet_digest(iss)
    measured = isinstance(writes, int) and writes >= 0
    # THE STORED COUNT IS VALIDATED WHERE IT IS READ, which is this file's rule
    # for everything that comes off the ledger: the file lives in a repository
    # and a string or null on this key would make the comparison below raise
    # inside the hook's own try/except — and a mark that silently does not get
    # written is the whole silence this mechanism exists to remove.
    prev = a.get("handoff_writes")
    prev = prev if isinstance(prev, int) and prev >= 0 else 0
    moved = measured and writes > prev
    if (measured and unmet_asks(iss) and not moved
            and a.get("handoff_digest") == digest):
        a["handoff_stalled"] = True
    a["state"] = "handoff"
    # WHEN, BECAUSE A MARK WITH NO AGE CANNOT BE REFUSED. `held_by` is the
    # spawn guard's reader and it DENIES a tool call, so the one thing it
    # must never do is wedge a session against an agent that is long gone.
    # The stamp is what makes the refusal expire by itself; a mark written
    # by a release that did not record one reads as stale and blocks nothing.
    a["handoff_at"] = int(time.time())
    a["handoff_digest"] = digest
    if writes is not None:
        a["handoff_writes"] = writes
    return iss.get("id")


def judge_issue(iss):
    """One issue's verdict at the main `Stop`, as one of:
    ("hold"|"handoff"|"escalate"|"kickback"|"closed"|"open", why).

    IN THE ORDER THEY ARE DECIDED:

      hold      an agent is still RUNNING. Not a failure and never a kickback: the work is
                in flight, and judging it unfinished would be judging an agent that has not
                spoken.
      handoff   nothing is running, an agent STOPPED AT ITS TURN CAP (`handoff`, written by
                `wf-turn-budget`) and items are still open. The issue is not finished and
                the one action is to RESUME that agent — its context is already paid for.
                This was a `hold` until K8, because nothing set the state; holding on it now
                would wait forever for a run the harness has already ended, which is the
                silence the whole turn-budget line of work exists to remove.
      escalate  that agent was marked `handoff` a SECOND time with the same unmet set AND
                nothing newly written (`handoff_stalled`), so resuming it again is not
                progress. The user decides.
      kickback  every agent is back and ITEMS THE SESSION ITSELF RECORDED ARE STILL OPEN.
      closed    every item done. A `handoff` agent does not block this: an agent that
                stopped at a cap having finished the work has nothing left to be resumed
                for, and `judge_ledger` flips it to `returned` as the issue closes. AN
                ISSUE WITH NO ITEMS AT ALL IS NOT CLOSED OVER A CUT AGENT (2026-10-13):
                see the `handoff` row above.
      tracked   no item the session wrote and no agent, but the hook recorded the user's
                message itself as a fallback item (`track_message`) and nothing has marked
                it finished. A status, never a failure: it says what is being worked on.
      open      an issue with no recorded items and no agent is nothing to judge. It is the
                shape a one-line message leaves behind, and a hook that kicked back on it
                would fire on almost every turn.

    IT NEVER INFERS AN UNDONE ITEM. The only evidence it will act on is an item the session
    wrote with a status it did not mark done — this project's rule that a blocking surface
    ships with no known wrong fire, applied to the verdicts that can reach the user. So every
    verdict above `tracked` reads `session_items`, and the fallback can reach none of them.
    An issue's `noted` intentions (`note_intentions`) are read by nothing here at all.
    """
    agents = issue_agents(iss)
    waiting = [a for a in agents if a.get("state") == "running"]
    if waiting:
        return "hold", ("1 agent working" if len(waiting) == 1
                        else "%d agents working" % len(waiting))
    items = session_items(iss)
    undone = [i for i in items if not item_done(i)]
    cut = [a for a in agents if a.get("state") == "handoff"]
    # AN ISSUE WITH NO ITEMS AT ALL AND A CUT AGENT IS NOT A FINISHED ISSUE, and that is
    # the second half of the defect the 2026-10-13 run measured. The session had written
    # no checklist when its IC was cut, so `undone` was empty, so this fell through to
    # `closed` — and `judge_ledger` then retired the `handoff` mark as it closed. An issue
    # closed on no recorded items is a completion nobody observed; the agent stopping at
    # its cap is itself the evidence that work is left, which is what the mark MEANS.
    if cut and (undone or not items):
        stalled = [a for a in cut if a.get("handoff_stalled")]
        who = name_labelled(stalled or cut, "agent_type")
        asks = "; ".join(i["ask"][:80] for i in undone)
        if stalled:
            return "escalate", "%s stopped at its turn cap twice with the same unmet " \
                               "set — %d of %d items still open: %s" % (
                                   who, len(undone), len(items), asks)
        if not items:
            return "handoff", "%s stopped at its turn cap and this issue records no " \
                              "items, so nothing here says its work is done" % who
        return "handoff", "%s stopped at its turn cap with %d of %d items still open: " \
                          "%s" % (who, len(undone), len(items), asks)
    if undone:
        return "kickback", "%d of %d items unaddressed: %s" % (
            len(undone), len(items), "; ".join(i["ask"][:80] for i in undone))
    if items or agents:
        return "closed", "%d items done, %d agents returned" % (len(items), len(agents))
    fallback = issue_items(iss)
    if any(not item_done(i) for i in fallback):
        return "tracked", "not itemized by the session"
    if fallback:
        # THE STATUS IS NAMED, so a fallback the next message `superseded` is never read as
        # one the session finished.
        return "closed", "the message itself is %s" % " ".join(
            fallback[0]["status"].split())[:40]
    return "open", "nothing recorded against it"


def close_finished(iss):
    """Close an issue `judge_issue` calls closed, and retire its `handoff` marks
    (`judge_ledger` says why)."""
    close_issue(iss)
    for a in issue_agents(iss):
        if a.get("state") == "handoff":
            a["state"] = "returned"


def judge_ledger(payload, led):
    """Judge EVERY open issue, close the finished ones, and return the verdict rows.

    EVERY OPEN ISSUE, NOT JUST THIS MESSAGE'S, which is K2c's correction: an agent
    dispatched three messages ago hands back after that turn ended, so the only Stop that
    can judge its issue is one that looks at all of them.

    A CLOSING ISSUE RETIRES ITS `handoff` MARKS. An agent that stopped at a cap with
    everything MET has nothing left to be resumed for, so it is `returned` like any other
    hand-back — and leaving the mark behind would make the NEXT message's Stop ask for a
    resume of an agent whose work is done. `SubagentStop` does this too, through
    `agent_returned` AND ONLY WHEN THAT STOP DELIVERED; this is the half that holds when a
    cap stops the run before that event fires, which is unmeasured on this host, and the
    half that holds when the agent stopped with the work still unfinished.

    THE ISSUE ITSELF RIDES ALONG IN THE ROW, so `wf-widen` can name the agents a verdict
    is about without parsing them back out of the sentence it was given.
    """
    rows = []
    for iss in open_issues(led):
        verdict, why = judge_issue(iss)
        if verdict == "closed":
            close_finished(iss)
        rows.append((iss.get("id"), verdict, why,
                     plain_text(ask_text(iss.get("prompt"), iss.get("peer")), EXCERPT_MAX), iss))
    return rows


# THE ASKS CHECKLIST. `count_asks` stays regex-only and numbered-only, for the reason given
# above it: splitting free prose into requests is a judgment task. So the split is not done
# here. The operating session is already a model reading the message, and it writes the
# asks into this file itself, before it starts, then updates each item as the work goes.
# At the end of the turn `wf-widen` hands the list and the reply to the widening agent, which
# checks both against the message, so a bad split is caught by a reader that did not write it.
#
# WHY NOT A MODEL CALL HERE. MEASURED 2026-09-12: a headless Haiku split through `claude -p`
# was accurate on real messages and took 9.6-11.7s per call, a wait in front of every
# message before the turn even starts. The session reading the message costs nothing.
#
# Under a dozen words a message is almost always one ask, and a checklist for "commit it"
# or "yes" is a chore the reader pays for on every short reply. Over 1,012 real prompts on
# this machine, 275 are under eight words.
CHECKLIST_MIN_WORDS = 12

# A SLASH COMMAND THE USER TYPED IS A NEW PIECE OF WORK HOWEVER SHORT IT IS. The word gate
# above exists for the continuation reply ("commit it", "yes"); `/agenda today` is two words
# and invokes a whole procedure. MEASURED 2026-10-14 in odyssey-alive's session `a609a11d`:
# the user's first message was `/agenda today`, it opened no issue because it was under the
# gate, and ISSUES printed nothing for two hours of work on it. The hook sees the command as
# typed — that session's ledger records the later one as "/org for now, could you …" — so
# the command's name and its arguments ARE the prompt. One component after the slash, then
# whitespace or the end, so a path like "/home/user/x is broken" is not a command.
SLASH_COMMAND = re.compile(r"\A\s*/[A-Za-z][\w:.-]*(?=\s|\Z)")


def opens_issue(prompt):
    """Whether this message opens an issue AND a checklist. The ONE gate both use, so the two
    can never disagree about whether work started (`add_issue`). Injected text never does: it
    is not the user's ask."""
    prompt = prompt or ""
    if INJECTED.search(prompt):
        return False
    return len(prompt.split()) >= CHECKLIST_MIN_WORDS or bool(SLASH_COMMAND.match(prompt))


# THE TWO SENTENCES WITH TWO READERS, EACH WRITTEN ONCE. A turn that opens no asks of its
# own still names the same file and the same carried rows (`carry_only_checklist`), so both
# sentences are now said in two places — and a second COPY of either one in this file is the
# copy that drifts. (`bin/check`'s grep for the carried words was the pin on them; it was
# retired on 2026-10-14, and nothing pins them now.)
# THE KEY SET NAMES `"titles"` WHEN THE TITLES LINE IS SAID (`checklist_head`). MEASURED
# 2026-10-29 in mutze-studio `29c3e592`: with the head listing three keys, the session read
# `"titles"` as outside the file's schema and never wrote it.
CHECKLIST_HEAD = ("Asks checklist for this message: %s. It holds "
                  "{\"prompt\", \"items\", \"carried\"%s}")
# THE CARRIED LIST IS ONE SENTENCE HOWEVER LONG IT IS: the rows live in the file, so the
# prompt pays for the pointer and not for the items.
CARRIED_LINE = ("\"carried\" holds %d still-open item(s) from this session's earlier "
                "issues, each naming its own issue id. Mark one \"done\", \"answered\" or "
                "\"dropped\" when this turn finishes or withdraws it and leave the rest as "
                "they are; only a carried row's status is read back, onto the issue it "
                "names, and that issue closes once its items are all finished.")
# SEVERAL OPEN ITEMS ARE PARTITIONED, NOT QUEUED. MEASURED 2026-11-02 in runpod-claude-gateway
# `89bbc493`: the user sent about twelve asks while a turn ran (installers, README and images,
# Docker packaging, setup and update commands), they touched disjoint files, and the session
# worked them one at a time in the main thread. i1 to i10 hold `agents: 0`; only i11 has
# agents, opened by the user asking "you're taking on each one of these items individually and
# stacking them instead of actually sectioning them off into different agents". That project
# has no org chart, so `DISPATCH_LINE` was never said, and nothing said anything about the
# BACKLOG: `CARRIED_LINE` asks only that statuses be updated.
#
# THE COUNT IS THE CARRIED ROWS, because they are the open items this hook knows at submit
# time; this message's own asks are not written yet, so the display says it once they are
# (`PARTITION_SAID`), unless this submit already did (the record's `partition`). Said with or
# without an org, on both checklist variants (`earlier_lines`), so the hand-back turn that
# frees the session hears it too. Who each subagent is stays the dispatch line's to say:
# `DISPATCH_LINE` where there is an org, `DISPATCH_NO_ORG` where there is none.
# ADVISORY, NEVER A GATE, for the reason the checklist display gives (ef16aca).
PARTITION_MIN = 3
PARTITION_LINE = ("With this many items open they are partitioned rather than worked one "
                  "after another: grouped by the files or areas they touch, the groups that "
                  "share no file go to parallel background subagents now, each told which "
                  "files it owns and to stay out of the rest, or each in its own worktree when "
                  "they edit the same checkout; only groups that overlap wait, one small item "
                  "can be done inline, and an item an agent already holds stays with it.")
# THE LAST TURN IGNORED THE PARTITION LINE, said back to the model at the next submit, ahead
# of the line itself. `wf-widen.worked_inline` decides it at Stop and leaves the mark under
# `INLINE_KEY` on the ledger; the Stop after this one rewrites or clears it. MEASURED
# 2026-11-07 in tmux-revive `ca202cd9`: the line alone was ignored on eight messages.
INLINE_KEY = "inline"
INLINE_LINE = ("The last turn worked %d open items across %s in this thread and spawned no "
               "subagent, which is what the next sentence rules out.")
# EVERY VARIANT NAMES THE OPEN ISSUES WITH NO TITLE (user, 2026-10-14: "so I noticed that
# the titles aren't in the issues tracker yet..."), in one sentence, until each has one.
TITLES_LINE = ("No title yet on %s: give each a few words in "
               "\"titles\": {\"<id>\": \"<title>\"}.")
# A PEER SESSION'S REQUEST NAMES ITS SENDER, AND SAYS WHAT A NOTICE THAT ASKS NOTHING GETS.
# MEASURED on 1.82.0 in odyssey-alive `de3efe49`, once a peer's message opened i8: the line
# never said who sent it, though the issue records `peer`. And a pure FYI from a peer opens an
# issue too, deliberately, since a hook cannot tell an FYI from a request without classifying
# free text; so the session is told how to close one. Said on a peer's message only.
# A REPEAT DELIVERY IS SAID TO BE ONE (`repeat_of`), with where its id went, because the hook
# folds on the envelope and only the session can read what the message behind it says.
REPEAT_LINE = (" This message from \"%s\" repeats the peer message already on issue %s: the "
               "same sender's messenger delivered it again within seconds, so it opens no "
               "issue of its own and its delivery is recorded on %s under \"repeats\". Read "
               "it, and put anything new in it on that issue.")
PEER_LINE = (" This message came from the peer session \"%s\", not from the user. "
             "A peer message that asks for nothing gets one item stating what it said, with "
             "\"status\": \"answered\", and the issue closes.")


# THE PER-MESSAGE PART OF A CHECKLIST'S NAME: the issue id its record pairs it with.
CHECKLIST_KEY = re.compile(r"i[0-9]{1,9}")


def checklist_path(payload, record=None):
    """Where a message's asks checklist lives. Keyed exactly like the tag, so a concurrent
    agent's stop can never read or rewrite the main session's list.

    AND KEYED BY THE MESSAGE, through the `key` its record carries. A queued message's
    submit fires before the running turn's Stop (`earlier_records`), and with one file per
    session it rewrote the list the running turn had been told to write: a late write for
    turn 1 then replaced message 2's fresh list, and message 2's Stop absorbed turn 1's
    items onto message 2's issue. Each message is told its own path, so each turn writes
    its own file, and each Stop reads the file of the record it picked. A record with no
    `key` (a carry-only list, or one an older release wrote) names the bare file, as before.
    `wf-widen.checklist` composes the same two names.
    """
    d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
    sid = state_component(payload)
    key = record.get("key") if isinstance(record, dict) else None
    if isinstance(key, str) and CHECKLIST_KEY.fullmatch(key):
        return os.path.join(d, f"{CHECKLIST_PREFIX}{sid}.{key}.json")
    return os.path.join(d, f"{CHECKLIST_PREFIX}{sid}.json")


# THE NAME EVERY ASKS CHECKLIST STARTS WITH. `wf-turn-budget` tests a tool call for it before
# loading this file (`checklist_shown` there), so it is the one literal that hook restates.
CHECKLIST_PREFIX = "wf-asks."
# THE MOST ITEMS ONE DISPLAY LISTS. A turn's real list is a handful; the file is the
# session's to write, so its length is not this hook's to trust.
DISPLAY_MAX = 20
# WHERE THE LAST DISPLAY OF EACH LIST IS REMEMBERED, beside the tag in the same directory.
SHOWN_NAME = "wf-asks-shown.%s.json"
CHECKLIST_NAMED = re.compile(r"(/[^\s'\"`<>|;&()]*/)?(wf-asks\.[A-Za-z0-9_.-]{1,140}?\.json)\b")


# THE ONE INSTRUCTION THE DISPLAY CARRIES, ahead of the list. The list reaches the session's
# context, not the screen (platform.md fact 28), so the session is what puts it in front of
# the user, in the reply it is about to write and before it does anything else.
SHOW_LIST = ("Show the user this work list now, as the first text of your reply and before "
             "your next tool call:\n")
# THE MEMO KEY THAT HOLDS WHICH LISTS THE DISPLAY HAS ALREADY LED WITH `PARTITION_LINE`.
# MEASURED 2026-11-02 in runpod-claude-gateway `89bbc493`: i1 was ONE message carrying 16 asks,
# with nothing carried at its submit, so the submit's count was zero and `earlier_lines` said
# nothing. The display is the first moment the asks are on disk, and it fires before the work,
# so it says the line there. Not a list name (those start `wf-asks.`), so it cannot collide.
# A list whose submit already said it is skipped through the record's `partition`, and a list
# shown again after a status change is skipped through this key: once per message either way.
PARTITION_SAID = "partition_said"


def checklist_display(payload):
    """`SHOW_LIST` and the list, for a PostToolUse to hand the session when this call wrote
    this session's asks checklist with items that differ from the last ones shown, or "".
    Led once per message by `PARTITION_LINE` when the list's open items reach the count
    (`PARTITION_SAID`).

    THE LIST IS SHOWN BEFORE THE WORK, which nothing did. MEASURED 2026-10-29 in
    mutze-studio `29c3e592`: the only display of a list was the WORK block at Stop, after
    the work it listed. The checklist line asks for the list in a tool call of its own,
    first (`start_checklist`), and this is what that call shows. NEVER A GATE: the blocking
    checklist that shipped once was removed (ef16aca) because nearly every follow-up defect
    came from it. This reads, and says.

    THE PATH IS TAKEN FROM THE CALL, and then confirmed. A `PostToolUse` payload carries no
    `scratchpad_dir` (platform.md fact 22b, measured on 2.1.296), so the directory the submit
    used cannot be recomputed here. The call's own `file_path`, or an absolute path in a
    Bash `command`, names the file; it counts only when its directory holds this session's
    tag and the name is the `checklist_path` of a record that tag carries, the newest one or
    a queued message's predecessor in `earlier`. A list written through a relative path or a
    variable is not shown, the quiet direction.

    IT RIDES `additionalContext`, NOT `systemMessage`. MEASURED 2026-10-29 on Claude Code
    2.1.312 (platform.md fact 28): the `systemMessage` this display first used was recorded in
    the transcript as a `hook_system_message` and never seen on the user's screen, in two
    sessions. The dedupe below is over the list alone, so the instruction never re-shows it.
    """
    tool_input = payload.get("tool_input")
    if not isinstance(tool_input, dict):
        return ""
    sid = state_component(payload)
    for field in ("file_path", "command"):
        text = tool_input.get(field)
        if not isinstance(text, str):
            continue
        for m in CHECKLIST_NAMED.finditer(text):
            d = (m.group(1) or "").rstrip("/")
            if not d or not os.path.isabs(d):
                continue
            shown = _show_checklist(payload, d, m.group(2), sid)
            if shown:
                return shown
    return ""


def _show_checklist(payload, d, name, sid):
    """`checklist_display` for one named file in directory `d`, or "": `SHOW_LIST` and the
    list, led by `PARTITION_LINE` when the list is the one that first reaches the count."""
    at = dict(payload, scratchpad_dir=d)
    tag = read_json_nofollow(tag_path(at))
    if not isinstance(tag, dict):
        return ""
    records = [r.get("checklist") for r in [tag] + earlier_records(tag)[1:]
               if isinstance(r, dict)]
    rec = next((r for r in records if isinstance(r, dict)
                and os.path.basename(checklist_path(at, r)) == name), None)
    if rec is None:
        return ""
    cl = read_json_nofollow(os.path.join(d, name))
    restored = restore_carried(at, os.path.join(d, name), rec, cl)
    items = checklist_items(cl)[:DISPLAY_MAX]
    if not items:
        return RESTORED % restored if restored else ""
    iid = rec.get("issue") if bare_name(rec.get("issue")) else ""
    title = checklist_title(cl)
    lines = ["WORK LIST  " + "  ".join(x for x in (iid, title) if x)]
    for it in items:
        st = plain_text(it.get("status"), 40) or "open"
        lines.append(f"  {st}  {plain_text(it['ask'], CARRY_ASK)}")
    others = open_elsewhere(at, d, rec, cl, records)
    if others:
        lines.append(ALSO_OPEN)
    for oid, otitle, rows in others:
        lines.append("  " + "  ".join(x for x in (oid, otitle) if x))
        lines += [f"    {st}  {ask}" for st, ask in rows]
    text = "\n".join(lines)
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
    memo_path = os.path.join(d, SHOWN_NAME % sid)
    memo = read_json_nofollow(memo_path) or {}
    said_restore = RESTORED % restored if restored else ""
    if memo.get(name) == digest:
        return said_restore
    # ONE ENTRY PER LIST THE TAG STILL CARRIES, so the memo never outgrows the records.
    names = {os.path.basename(checklist_path(at, r)) for r in records if isinstance(r, dict)}
    said = memo.get(PARTITION_SAID)
    said = ([n for n in said if isinstance(n, str) and n in names]
            if isinstance(said, list) else [])
    memo = {k: v for k, v in memo.items() if k in names and isinstance(v, str)}
    memo[name] = digest
    # `PARTITION_LINE` ONCE PER LIST, AND NOT AT ALL WHEN THE SUBMIT ALREADY SAID IT. The open
    # count is this list's items plus every other open item shown under it, so the one
    # message that carries many asks of its own is covered too (`PARTITION_SAID`).
    lead = ""
    if (not rec.get("partition") and name not in said
            and sum(not item_done(r) for r in items) + sum(len(r) for _, _, r in others)
            >= PARTITION_MIN):
        said.append(name)
        lead = PARTITION_LINE + " "
    if said:
        memo[PARTITION_SAID] = said
    write_json_atomic(memo_path, memo)
    return (said_restore + "\n" if said_restore else "") + lead + SHOW_LIST + text


# WHAT THE SESSION IS TOLD WHEN ITS WRITE DROPPED CARRIED ROWS AND THE HOOK PUT THEM BACK.
RESTORED = ("This list's \"carried\" rows were missing, and %d are back in the file: an "
            "earlier issue's item is finished by marking its carried row, never by removing it.")


def restore_carried(at, path, rec, cl):
    """Put back every carried row the session's write dropped from the list at `path`. How
    many went back.

    THE DEFECT THIS CLOSES, MEASURED 2026-11-07 in tmux-revive `ca202cd9`: on every message the
    session rewrote its list whole with `"carried": []`, so the rows the hook had put there
    were gone and nothing could close i26's, i31's, i33's or i35's open items. An emptied list
    never closed anything (`absorb_carried` writes only rows that exist); it only lost the
    one place a later turn can finish them. So the rows come back while the turn can use them.

    THE ROWS ARE `carry_forward`'s, built from the ledger NOW, and only an issue OLDER than the
    list's own message: a newer message's items are on its own list, not this one. A row the
    session kept, with whatever status it gave it, stays as written; only a missing row is
    added, so nothing here changes a mark. Written through `write_json_atomic` onto the name
    `_show_checklist` already confirmed is this session's.
    """
    if not isinstance(cl, dict):
        return 0
    own = rec.get("issue") if bare_name(rec.get("issue")) else None
    led = load_ledger(at)
    late_marks(at, led)
    kept = carried_items(cl)
    have = {(r["issue"], r["ask"][:CARRY_ASK]) for r in kept}
    back = [r for r in carry_forward(led, skip=own)
            if (r["issue"], r["ask"][:CARRY_ASK]) not in have
            and (own is None or issue_number(r["issue"]) < issue_number(own))]
    back = back[:max(0, MAX_CARRIED - len(kept))]
    if not back:
        return 0
    cl["carried"] = kept + back
    return len(back) if write_json_atomic(path, cl) else 0


def issue_number(iid):
    """The number in an issue id (`i31` is 31), or -1 for an id `add_issue` never makes."""
    return int(iid[1:]) if isinstance(iid, str) and CHECKLIST_KEY.fullmatch(iid) else -1


# THE REST OF THE SESSION'S OPEN WORK, SHOWN UNDER THE LIST JUST WRITTEN. MEASURED 2026-11-07
# in tmux-revive `ca202cd9`: i31, i32 and i33 were sent while i31's turn ran, all three were
# open, and each display listed its own message alone. The user: "I'm also not seeing a list
# of work items to denote that you are tracking each of these asks separately."
ALSO_OPEN = "STILL OPEN FROM EARLIER MESSAGES"


def open_elsewhere(at, d, rec, cl, records):
    """The session's open items outside the list `rec` names, grouped by issue in issue
    order: `[(id, title, [(status, ask)])]`, at most `DISPLAY_MAX` items in all.

    THE LEDGER IS THE SOURCE, NOT THE FILE'S `carried` ROWS. The session rewrites the file,
    and in `ca202cd9` it wrote `"carried": []` into every list, so the rows the hook had put
    there were gone before anything showed them. The file's carried statuses still win over
    the ledger's, because they are this turn's marks and land at its Stop; with no ledger,
    the file's rows are all there is. A queued message's own list, still on disk under a
    record the tag carries, stands in for its issue, whose ledger item is only the hook's
    fallback until that turn's Stop absorbs the list."""
    own = rec.get("issue")
    led = load_ledger(at)
    late_marks(at, led)
    titles = {i.get("id"): plain_text(i.get("title"), TITLE_MAX) for i in open_issues(led)}
    marks = {(r["issue"], r["ask"][:CARRY_ASK]): r.get("status") for r in carried_items(cl)}
    live = {}
    for r in records:
        rid = r.get("issue") if isinstance(r, dict) and r is not rec else None
        if not bare_name(rid) or rid == own:
            continue
        other = read_json_nofollow(os.path.join(d, os.path.basename(checklist_path(at, r))))
        its = checklist_items(other)
        if its:
            live[rid] = its
            titles[rid] = titles.get(rid) or checklist_title(other)
    rows = [(r["issue"], marks.get((r["issue"], r["ask"][:CARRY_ASK])) or r.get("status"),
             r["ask"])
            for r in (carry_forward(led, skip=own) if open_issues(led) else carried_items(cl))
            if r["issue"] not in live]
    rows += [(rid, it.get("status"), it["ask"]) for rid, its in live.items() for it in its]
    groups, seen, n = {}, set(), 0
    for gid, st, ask in rows:
        st = plain_text(st, 40) or "open"
        key = (gid, ask[:CARRY_ASK])
        if item_done({"status": st}) or key in seen or n >= DISPLAY_MAX:
            continue
        seen.add(key)
        n += 1
        groups.setdefault(gid, []).append((st, plain_text(ask, CARRY_ASK)))
    order = sorted(groups, key=lambda g: (len(g), g))
    return [(g, titles.get(g) or "", groups[g]) for g in order]


def previous_checklist(payload, tag=None):
    """The checklist record the last tag carried, or None. The record is this hook's, kept in
    the tag file, because the checklist file is the session's to rewrite and cannot be trusted
    to hold the user's prompt or whether a `Stop` has ended the turn it belongs to."""
    if tag is None:
        tag = read_json_nofollow(tag_path(payload))
    rec = tag.get("checklist") if isinstance(tag, dict) else None
    return rec if isinstance(rec, dict) else None


# HOW MANY EARLIER MESSAGES' RECORDS THE TAG KEEPS BESIDE THE NEWEST ONE.
EARLIER_MAX = 3


def earlier_records(tag):
    """The records the tag being replaced held, newest first, for the new tag's `earlier`.

    A QUEUED MESSAGE'S SUBMIT FIRES BEFORE THE RUNNING TURN'S STOP. MEASURED 2026-10-29 in
    `~/Work` `b6047346`: the next message was enqueued at 17:21:55 and its
    `UserPromptSubmit` fired then, mid-turn; turn 1's `Stop` came at 17:21:59. With one
    record per slot that Stop read message 2's record, so the jury was handed "please reach
    out to @mutze-dev…" as turn 1's ask and the WORK line tracked i2. `3ca2e8f7` shows the
    same order with the queued message delivered INTO the running turn instead.

    SO THE REPLACED RECORD IS KEPT, and the Stop picks the one its turn answered
    (`wf-widen.answered_record`, which matches the transcript's last user row). The top-level
    fields stay the NEWEST record, so every reader that never picks — the next submit's
    `previous_checklist`, a `SubagentStop` slot — reads exactly what it read before.

    A record from an older release has no `earlier` key and is kept like any other, which is
    the whole heal. Capped at `EARLIER_MAX`: one queued message needs one, and an unmatched
    record ages out instead of growing the file.

    A REPEAT DELIVERY'S RECORD IS NEVER KEPT (`repeat_of`). It opened nothing and its list is
    the repeated issue's, whose own record is kept; in `f9318dba` one burst was four
    deliveries, and keeping each would push the first one's record out of the cap.
    """
    if not isinstance(tag, dict) or not isinstance(tag.get("prompt"), str):
        return []
    top = {k: v for k, v in tag.items() if k != "earlier"}
    older = tag.get("earlier")
    older = [r for r in older if isinstance(r, dict)] if isinstance(older, list) else []
    return [r for r in [top] + older if not r.get("repeat_of")][:EARLIER_MAX]


def start_checklist(payload, prev=None, earlier=(), notes=None):
    """Replace last turn's checklist with an empty one for this ask. Returns the context line
    naming it ("" when this message gets none) and the record the tag carries (None when none).

    Last turn's file is removed first, so a short reply never inherits a list of asks it was
    never given. A TURN STILL RUNNING KEEPS ITS FILE: a keyed record no `Stop` has ended is a
    queued message's predecessor, whose session may still write the path it was told
    (`checklist_path`). Its file goes at a later submit, once a `Stop` has ended it.

    A MESSAGE THAT OPENS NO LIST OF ITS OWN STILL CARRIES this session's earlier open items,
    through `carry_only_checklist`, and gets no file at all when there are none.

    A REPEAT DELIVERY OF A PEER'S MESSAGE OPENS NOTHING (`repeat_of`). Its turn keeps the list
    of the issue it repeats while that list's turn is running, the way a notification mid-turn
    does, so the repeat never writes over the first delivery's file; otherwise it gets the
    carry-only list. `notes`, when given, is told `repeat_of`, which `main` records on the tag
    so `earlier_records` never spends a slot on it.
    """
    prompt = payload.get("prompt") or ""
    p = checklist_path(payload, prev)
    # A NOTIFICATION MID-TURN LEAVES THE CHECKLIST ALONE. MEASURED 2026-09-13: a background task
    # finished mid-turn, its notification fired this event, and the remove below erased the
    # checklist for the user's real message.
    #
    # BOTH CONDITIONS, and each closes a measured stale case. The prefix is NOTIFICATION, not
    # INJECTED, so a real message that starts "Stop hook feedback:" gets a clean slate. The
    # list's turn must not have ended: once a `Stop` has ended it, a notification that opens a
    # NEW turn afterwards must not keep the list, or the widening agent is handed it twice.
    if (NOTIFICATION.search(prompt) and prev is not None and not prev.get("ended")
            and os.path.exists(p)):
        return "", prev
    # THE LEDGER TURN, AND IT HAPPENS BEFORE THE REMOVE BELOW (K2c). The outgoing list's
    # items are absorbed onto their issue first, so the wipe forgets nothing, and then this
    # message's own issue is opened. It is one block in one place because it is gated on the
    # SAME condition as the wipe: a second copy of that condition is the copy that drifts.
    #
    # THE ABSORB RUNS EVEN WHEN THIS MESSAGE OPENS NO ISSUE. "yes" after a long turn is
    # short and injected text is not an ask, so neither opens one — but both end the turn
    # whose items are still on disk, and losing them there is the defect this replaces.
    #
    # AND THE CARRIED ROWS COME HOME FIRST. The outgoing list holds this session's EARLIER
    # issues' open items (`carry_forward` below), and whatever status the turn gave them is
    # written back onto THEIR issue by id — the only way an item can be finished after the
    # turn that wrote it has ended. `wf-widen`'s Stop does this too, one event earlier, so an
    # issue finished during a turn closes on that turn's Stop; this is the half that holds
    # when no Stop fired.
    issue_id, repeat = None, None
    carried, untitled, inline = [], [], None
    try:
        led = load_ledger(payload)
        inline = led.get(INLINE_KEY)
        cl = read_json_nofollow(p) or {}
        landed = absorb_carried(led, carried_items(cl))
        landed += absorb_titles(led, checklist_titles(cl))
        if prev is not None:
            absorb_items(led, prev.get("issue"), checklist_items(cl), checklist_title(cl))
            # AND A LIST THAT FINISHED ITS ISSUE CLOSES IT HERE, the verdict the next Stop would
            # reach, so `index.json` is right at once. A context-only message's one `answered`
            # item closed its issue at this submit while the fold existed; it still does.
            done = next((i for i in open_issues(led) if i.get("id") == prev.get("issue")), None)
            if done is not None and judge_issue(done)[0] == "closed":
                close_finished(done)
                landed += 1
        # AFTER THE ABSORB AND BEFORE THIS MESSAGE'S ISSUE, so what is healed is only what an
        # older release left empty (`heal_empty`).
        landed += heal_empty(led)
        # EVERY LIST'S NEWER MARKS BEFORE ANY ROW IS BUILT, and before the remove below takes
        # the ended lists away for good (`late_marks`).
        landed += late_marks(payload, led)
        repeat = repeat_of(led, payload)
        if repeat is not None:
            note_repeat(repeat, payload)
            landed += 1
        iss = add_issue(payload, led) if repeat is None else None
        issue_id = iss.get("id") if iss else None
        if iss is not None or prev is not None or landed:
            save_ledger(payload, led)
        # BUILT AFTER THE ABSORB AND AFTER THIS MESSAGE'S ISSUE EXISTS, so it reflects what
        # is open NOW: an item the last turn finished is not handed back to this one, and
        # this message's own issue is skipped rather than carrying itself. A repeat skips the
        # issue it repeats, whose items are on that issue's own list.
        skip = issue_id or (repeat.get("id") if repeat is not None else None)
        carried = carry_forward(led, skip=skip)
        untitled = untitled_issues(led, skip=skip)
    except OSError:
        pass
    bare = checklist_path(payload)
    running = isinstance(prev, dict) and p != bare and not prev.get("ended")
    gone = [] if running else [p]
    gone += [bare] + [checklist_path(payload, r.get("checklist")) for r in earlier
                      if isinstance(r, dict) and isinstance(r.get("checklist"), dict)
                      and r["checklist"].get("ended")]
    for old in set(gone):
        try:
            os.remove(old)
        except OSError:
            pass
    if repeat is not None:
        rid = repeat.get("id")
        if isinstance(notes, dict):
            notes["repeat_of"] = rid
        said = REPEAT_LINE % (peer_sender(payload["peer"]), rid, rid)
        live = next((r for r in [prev] + [e.get("checklist") for e in earlier
                                          if isinstance(e, dict)]
                     if isinstance(r, dict) and r.get("issue") == rid and not r.get("ended")
                     and os.path.exists(checklist_path(payload, r))), None)
        if live is not None:
            return said.strip(), live
        line, record = carry_only_checklist(bare, carried, untitled, inline)
        return (said.strip() + (" " + line if line else "")), record
    # Injected text opens no list of its own: it is not the user's ask. IT STILL CARRIES,
    # when this session has earlier open items — see `carry_only_checklist`, which is where
    # the measured hand-back case is written down.
    if not opens_issue(prompt):
        return carry_only_checklist(bare, carried, untitled, inline)
    # `issue` PAIRS THE LIST WITH THE ISSUE IT BELONGS TO, and it is what the next
    # message's absorb reads. Without it the items would have no issue to land on. `key`
    # names this message's own file (`checklist_path`).
    record = {"prompt": prompt[:2000], "ended": False, "issue": issue_id}
    if issue_id:
        record["key"] = issue_id
    if isinstance(payload.get("peer"), dict):
        record["peer"] = payload["peer"]
    # THE SUBMIT SAID `PARTITION_LINE` (`earlier_lines`), so the display does not say it again.
    if len(carried) >= PARTITION_MIN:
        record["partition"] = True
    p = checklist_path(payload, record)
    if not write_json_atomic(p, {"prompt": prompt[:2000], "items": [],
                                 "carried": carried}):
        return "", None
    # Stated as facts about the file, never as an out-of-band command (see the note above
    # the injection in `main`).
    #
    # THE LIST IS WRITTEN IN A TOOL CALL OF ITS OWN, FIRST, because that write is what hands
    # it back to the session to show (`checklist_display`). MEASURED 2026-10-29 in
    # mutze-studio `29c3e592`: the session wrote i1's four items in the same Bash call as its
    # first real work, and the only display was the WORK block at Stop, after the work. A
    # queued message is told the same sentence for its own file, since every submit's line
    # is built here.
    return (checklist_head(p, untitled)
            + " and its \"items\" start empty. Each separate "
            "ask is one item, {\"ask\": <in the user's words>, "
            "\"status\": \"open\"}, written in a tool call of its own before any other tool "
            "call, and the session then shows the list in its reply before working; statuses "
            "are updated as the work goes, and an ask found along the way is added. A finished ask is \"done\", or "
            "\"answered\" when the work was answering it; one the user withdrew or sent by "
            "mistake is \"dropped\". Give the issue a short \"title\" of a few words; an item "
            "that continues an earlier issue, open or closed, carries \"issue\": <its id> and "
            "stays on this message's list, where it was asked. A message that only adds context "
            "to an earlier issue gets one item "
            "stating that context, with \"issue\": <that id> and \"status\": \"answered\", "
            "so its own issue closes with it. The reply gives each item its "
            "own section. At Stop the widening agent checks the list and the reply against the "
            "message."
            + (PEER_LINE % peer_sender(payload["peer"])
               if isinstance(payload.get("peer"), dict) else "")
            + (f" These items belong to issue {issue_id} in this project's issue ledger, "
               "which keeps them after this turn ends and keeps every earlier open issue "
               "beside them; an agent spawned now is linked to that issue and its result is "
               "recorded there." if issue_id else "")
            + earlier_lines(carried, untitled, inline)
            + (dispatch_line(payload, issue_id) if issue_id else "")), record


# THE DEFAULT DISPATCH, SAID ON EVERY MESSAGE THAT OPENS AN ISSUE IN A PROJECT WITH AN ORG.
# The user, relayed from mutze-studio on 2026-10-29: "The whole idea is that when we have
# jobs done, agents go do them and workforce manages them. this allows for multiple issues to
# be worked on at one time. I should[n't] have to run audit or invoke the org skill to make
# that work out of the box." MEASURED the same day in `29c3e592`: i1 to i6 were all worked
# inline, `agents: []` on every one, in a project with 27 employees. Nothing routed an issue
# to an employee unless `/org` was invoked, and `/org` is a per-project copy only an audit
# rewrites. ADVISORY, NEVER A GATE, for the reason the checklist display gives (ef16aca).
#
# NO ROSTER: the harness already lists every agent type with its description to the main
# session. THE RULE IS RUNG 3 OF `references/procedures/org.md` in its own terms, the lowest
# node whose scope covers the job, and the Lead half is said only when the chart names one.
#
# A PROJECT WITH NO ORG GETS THE DISPATCH TOO, as `DISPATCH_NO_ORG`, because the line was
# never about the org. MEASURED 2026-11-08 in tmux-revive `2dca2a45`, a project that never
# ran audit: i1 was diagnosed, edited, tested and installed in the main thread, 18 tool calls
# besides the checklist's own two, and holds `agents: []`. There is no chart there, so this
# function returned "" and nothing in the turn said a job could go to a subagent at all; the
# partition line was no help either, since one ask never reaches `PARTITION_MIN`. The user,
# in the message that opened i2 of that session: "How workforce is suppose to work, is when
# you ask something, it queues it up under the WORK subheading. Then it assigns agents, as
# necessary, even if the current project hasn't ran audit yet. This allows you to take on
# multiple tasks at a time without losing footing when being interrupted." Without an org
# there is no employee to name, so the job goes to the harness's own `general-purpose`
# agent; everything else the line says is the org variant's, the inline clause word for word
# (`DISPATCH_INLINE`). ADVISORY, NEVER A GATE, for the same reason.
ORG_CHART = os.path.join(".claude", "workforce", "org-chart.md")
ORG_MARKER = b"AUTO-GENERATED by /workforce org index"
ORG_LEAD = re.compile(rb"^\s*- [^\n]*\(T2\b", re.M)
DISPATCH_INLINE = (" Work inline only when the answer is already in hand or the job is a few "
                   "tool calls: data in hand that answers the question is itself the answer.")
DISPATCH_LINE = (" This project has a workforce org. A job in this message goes to the "
                 "employee whose description fits, spawned as a background plain subagent so "
                 "this session stays free for the next message; the spawn is linked to issue "
                 "%s and the Work list tracks it until it hands back." + DISPATCH_INLINE)
DISPATCH_NO_ORG = (" This project has no workforce org, which changes who takes a job and not "
                   "whether one is handed off. A job in this message goes to a background "
                   "plain `general-purpose` subagent, spawned so this session stays free for "
                   "the next message; the spawn is linked to issue %s and the Work list "
                   "tracks it until it hands back." + DISPATCH_INLINE)
DISPATCH_LEADS = (" The chain of command in %s names Leads, so the job goes to the lowest "
                  "node whose scope covers it: the one IC whose scope does, or that "
                  "department's Lead when it spans the department's ICs or has to be "
                  "sequenced inside it.")


def dispatch_line(payload, issue_id):
    """`DISPATCH_LINE` (and `DISPATCH_LEADS` when the chart names a Lead), `DISPATCH_NO_ORG`
    when the project has no org, or "" when the hook was given no project at all.

    AN ORG IS THE CHART WORKFORCE WRITES, carrying the marker `org index` writes into it.
    `.claude/agents/*.md` alone is not one: a third-party plugin or a hand-made agent puts
    files there with no chain of command and no handbook this distribution governs, so such
    a project hears the no-org line. The chart is read only on a message that opened an
    issue, never through a link, and at most `MAX_HANDBOOK_BYTES` of it.
    """
    root = project_root(payload)
    if not root:
        return ""
    body = _read_capped(os.path.join(root, ORG_CHART), MAX_HANDBOOK_BYTES)
    if body is None or ORG_MARKER not in body[:1024]:
        return DISPATCH_NO_ORG % issue_id
    return (DISPATCH_LINE % issue_id
            + (DISPATCH_LEADS % ORG_CHART if ORG_LEAD.search(body) else ""))


def checklist_head(p, untitled):
    """`CHECKLIST_HEAD` for the file at `p`, its key set naming `"titles"` exactly when
    `earlier_lines` will say the titles line. One builder for both checklist variants."""
    return CHECKLIST_HEAD % (p, ", \"titles\"" if untitled else "")


def earlier_lines(carried, untitled, inline=None):
    """The sentences about this session's EARLIER issues, each said only when it has something
    to name, and each with its leading space. One builder for both checklist variants.
    `inline` is the ledger's `INLINE_KEY` mark, said only ahead of the partition line."""
    said = len(carried) >= PARTITION_MIN
    return ((" " + CARRIED_LINE % len(carried) if carried else "")
            + (" " + inline_line(inline) if said and inline_line(inline) else "")
            + (" " + PARTITION_LINE if said else "")
            + (" " + TITLES_LINE % ", ".join(untitled) if untitled else ""))


def inline_line(mark):
    """`INLINE_LINE` for a ledger mark `wf-widen` wrote, or "" for anything else: the ledger
    is a file in the project, so its shape is checked before a word of it is said."""
    n = mark.get("items") if isinstance(mark, dict) else None
    if type(n) is not int or not 0 < n <= MAX_ISSUES * MAX_CARRIED:
        return ""
    ids = [i for i in mark.get("issues") or [] if bare_name(i)][:MAX_CARRIED]
    return INLINE_LINE % (mark["items"], ", ".join(ids)) if ids else ""


def carry_only_checklist(p, carried, untitled, inline=None):
    """The file and the line a message that opens no asks of its own still gets, when this
    session has earlier issues with open items or no title. `("", None)` when it has neither.

    THE TURN A DISPATCHED ITEM IS FINISHED ON IS AN INJECTED TURN, which is the half of the
    carry 1.77.4 could not reach. MEASURED 2026-10-13 in odyssey-alive's session `629732ff`:
    turn 1 was the user's ask, the session wrote its one item, dispatched a background agent
    and replied "handed off", and the `Stop` ended that turn with the item correctly open.
    TURN 2 WAS THE HAND-BACK — "Another Claude session sent a message", which `INJECTED`
    matches — so it opened no checklist, was handed no carried rows, and the file had just
    been removed: the session's own `sed` to mark the item done answered "No such file or
    directory". The `Stop` then found no record, absorbed nothing, and printed `i1 KICKBACK
    1 of 1 items unaddressed` about work that was finished. An issue whose work completes
    asynchronously could never close, because the only turn that could close it is this one.

    SO THE ROWS RIDE ON IT TOO, and nothing else about the turn changes. `"items"` stays
    empty and the line asks for no ask-splitting, because the message made no asks. The
    record is marked `carry_only`, which is what keeps `wf-widen` from handing the widening
    jury a checklist for this turn: an injected hand-back is not the user's ask and must not
    be graded as one. AND IT NAMES NO ISSUE, deliberately — the next message's `absorb_items`
    would otherwise copy this empty `items` list over that issue's real items.

    AN OPEN ISSUE WITH NO TITLE ALSO GETS THE FILE, so the session can write its `"titles"`.
    It is named on every message until the session titles it, and never after.

    A TURN WITH NO CARRIED ROWS AND NO UNTITLED ISSUE IS UNCHANGED: no file, no line, no
    record. A short reply to a session holding nothing open is the common case, and it stays
    free.
    """
    if not carried and not untitled:
        return "", None
    # THE PROMPT FIELD IS EMPTY RATHER THAN THE INJECTED TEXT. The field exists for the
    # user's ask, this message is not one, and the record's prompt is what `wf-widen` would
    # put in front of a juror — so harness text has no reason to be in either copy.
    if not write_json_atomic(p, {"prompt": "", "items": [], "carried": carried}):
        return "", None
    return (checklist_head(p, untitled)
            + " and its \"items\" stay empty, because this message makes no asks of its "
            "own." + earlier_lines(carried, untitled, inline),
            {"prompt": "", "ended": False, "issue": None, "carry_only": True})


# ─────────────────────────────────────────────────────────────────────────────────
# AN INJECTED TURN IS JUDGED ON THE USER'S WORDS FOR THE WORK IT SERVES.
#
# A hand-back or a task notification is not the user's ask, and `classify` keeps refusing
# it (`INJECTED`). But the turn it opens is where the work lands and where the result is
# reported, and MEASURED 2026-11-09 on mutze-studio: 584 of 912 Stops (64%) were opened by
# one, so 64% of turns could never seat a juror. Both unchecked "done" claims in `30e77777`
# (rows 1399 and 1576) were written in turns a background job's notification opened.
#
# THE DOCKET COMES FROM THE ISSUE THE WORK WAS STARTED FOR, never from whichever issue is
# newest now: a hand-back for i1 that lands while the user is on i4 is still i1's result.
#   · an agent: its id is the `<task-id>` of its notification and the `from` of its
#     hand-back, and the ledger links it to its issue at `SubagentStart` (`newest_entry`).
#   · anything else the session started — a background shell is the measured case
#     (`boi0hn2x3`, `b0mtvnqof`) — is followed through its `<tool-use-id>` to the turn that
#     issued the call, and that turn's opener decides: the user's typed message, or, when
#     an injected row opened that turn too, the same question asked of it, at most
#     `SERVE_DEPTH` times.
# Nothing found means no docket. A guess would put somebody else's ask on the turn.
SERVE_DEPTH = 4
TASK_ID_TAG = re.compile(r"<task-id>([A-Za-z0-9_-]{1,64})</task-id>")
TOOL_USE_TAG = re.compile(r"<tool-use-id>([A-Za-z0-9_-]{1,128})</tool-use-id>")
HANDBACK_FROM = re.compile(r'<agent-message\s+from="([A-Za-z0-9_-]{1,64})"')


def _row_text(row):
    """A user row's text, or None for a tool result or a row with none."""
    msg = row.get("message") if isinstance(row, dict) else None
    c = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(c, str):
        return c
    if not isinstance(c, list) or any(
            isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
        return None
    return "\n".join(b["text"] for b in c if isinstance(b, dict) and b.get("type") == "text"
                     and isinstance(b.get("text"), str)) or None


def opener_of_call(lines, tool_use_id):
    """The text that opened the turn which issued `tool_use_id`, or None.

    Back from the issuing row to the turn's start: the typed user row that opened it, or,
    for a turn a hand-back opened (an `isMeta` row), the oldest user row after the last
    turn-end row. A system reminder is never an opener. Rows are matched by parsing, never
    by their spacing; the substring test only skips rows that cannot match."""
    at = None
    for i in range(len(lines) - 1, -1, -1):
        if tool_use_id not in lines[i] or "tool_use" not in lines[i]:
            continue
        try:
            row = json.loads(lines[i])
        except ValueError:
            continue
        c = (row.get("message") or {}).get("content") if isinstance(row, dict) else None
        if row.get("type") == "assistant" and isinstance(c, list) and any(
                isinstance(b, dict) and b.get("type") == "tool_use"
                and b.get("id") == tool_use_id for b in c):
            at = i
            break
    if at is None:
        return None
    oldest = None
    for line in reversed(lines[:at]):
        if "system" not in line and "user" not in line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        if row.get("type") == "system" and row.get("subtype") in ("stop_hook_summary",
                                                                  "turn_duration"):
            break
        if row.get("type") != "user":
            continue
        text = _row_text(row)
        if not text or text.lstrip().startswith("<system-reminder>"):
            continue
        oldest = text
        if not row.get("isMeta"):
            break
    return oldest


def served_ask(payload, led, text, lines=None, depth=0):
    """`{"issue", "prompt", "via"}` for the user ask an injected `text` serves, or None.

    `lines` is the session transcript, read once by the caller that needs it."""
    if depth > SERVE_DEPTH or not isinstance(text, str):
        return None
    m = HANDBACK_FROM.search(text[:400]) or TASK_ID_TAG.search(text[:400])
    aid = m.group(1) if m else None
    if aid:
        iss = newest_entry(led, aid)[0]
        if isinstance(iss, dict) and isinstance(iss.get("prompt"), str) and iss["prompt"]:
            return {"issue": _issue_id(iss), "prompt": iss["prompt"][:2000],
                    "via": "agent " + aid}
    t = TOOL_USE_TAG.search(text[:600])
    if not t:
        return None
    if lines is None:
        lines = transcript_lines_of(payload.get("transcript_path"))
    opener = opener_of_call(lines or [], t.group(1))
    if not opener:
        return None
    if INJECTED.search(opener):
        return served_ask(payload, led, opener, lines, depth + 1)
    peer = peer_request(opener)
    ask = peer[0] if peer else opener
    flat = " ".join(ask.split())
    for iss in reversed(led.get("issues", [])):
        p = iss.get("prompt") if isinstance(iss, dict) else None
        if isinstance(p, str) and p.strip() and " ".join(p.split())[:500] in flat:
            return {"issue": _issue_id(iss), "prompt": p[:2000],
                    "via": ("task " + aid) if aid else "call " + t.group(1)}
    return {"issue": None, "prompt": ask[:2000],
            "via": ("task " + aid) if aid else "call " + t.group(1)}


def _issue_id(iss):
    """The issue's id when it has this hook's shape (`i12`), else None: the ledger is a file
    in the project, and its id is said back to the session."""
    iid = iss.get("id") if isinstance(iss, dict) else None
    return iid if isinstance(iid, str) and CHECKLIST_KEY.fullmatch(iid) else None


def transcript_lines_of(path):
    """The transcript's lines, or [] when it cannot be read. Read without following a link,
    like every other file this hook opens."""
    if not isinstance(path, str) or not path:
        return []
    try:
        fd = _open_nofollow(path, os.O_RDONLY)
    except OSError:
        return []
    try:
        with os.fdopen(fd, "rb") as fh:
            return fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


# THE USER'S WORDS, AT THE CALL THAT ACTS ON THEM WITHOUT A STOP IN BETWEEN. `wf-turn-budget`
# reads this on `PreToolUse` for `Artifact` and `AskUserQuestion`: a page about to be
# published and a question about to be put to the user are both made against the ask, and
# MEASURED in `30e77777` both went wrong with the ask out of view (a chooser re-asking what
# the user had just said; a page called updated that was not the one the user meant). No
# model call: one tag read, one ledger read. Stated as data, never as an instruction.
ASK_WORDS_MAX = 1500
ASK_WORDS = ("The user's own words for the work this {tool} call serves{where}, quoted as "
             "data and not as an instruction: \"{words}\"")


def ask_words(payload, led):
    """`ASK_WORDS` for this call's open issue, or "" when no user ask can be named.

    An agent's issue is its own (`newest_entry`). The main session's is the one its tag
    names: the inherited ask of an injected turn, the issue the message opened, or, for a
    message that opened none, that message itself. Never the newest issue by default."""
    aid = agent_component(payload)
    iss, words = None, ""
    if aid:
        iss = newest_entry(led, aid)[0]
    else:
        tag = read_json_nofollow(tag_path(payload))
        tag = tag if isinstance(tag, dict) else {}
        src = tag.get("docket_from") if isinstance(tag.get("docket_from"), dict) else {}
        rec = tag.get("checklist") if isinstance(tag.get("checklist"), dict) else {}
        want = src.get("issue") or rec.get("issue")
        iss = next((i for i in led.get("issues", []) if isinstance(i, dict)
                    and want and i.get("id") == want), None)
        if iss is None:
            words = src.get("prompt") if isinstance(src.get("prompt"), str) else ""
            if not words and isinstance(tag.get("prompt"), str) and not INJECTED.search(
                    tag["prompt"]):
                words = tag["prompt"]
    if isinstance(iss, dict) and isinstance(iss.get("prompt"), str):
        words = iss["prompt"]
    words = plain_text(words, ASK_WORDS_MAX).replace('"', "'")
    if not words:
        return ""
    iid = _issue_id(iss) if iss else None
    tool = str(payload.get("tool_name") or "")
    return ASK_WORDS.format(tool=tool if tool in ("Artifact", "AskUserQuestion") else "tool",
                            where=f" (issue {iid})" if iid else "", words=words)


def inherited_hits(payload, prompt):
    """(hits, docket_from) for an injected turn: the user's words for the work it serves,
    classified like any message, each hit marked `inherited`. `([], None)` otherwise."""
    if not NOTIFICATION.search(prompt or "") and not HANDBACK_FROM.search((prompt or "")[:400]):
        return [], None
    try:
        served = served_ask(payload, load_ledger(payload), prompt)
    except (OSError, ValueError, RecursionError):
        return [], None
    if not served:
        return [], None
    hits = [dict(h, inherited=True) for h in classify(served["prompt"])]
    return hits, served


# ─────────────────────────────────────────────────────────────────────────────────
# A TURN WITH NO DOCKET OF ITS OWN IS TRIED ON THE OPEN WORK IT CARRIES.
#
# MEASURED 2026-11-09 in mutze-studio `30e77777` by `bin/replay-seating`: Stops 2007 and 2203
# were opened by a peer's message that asked for nothing, and both replies restated the
# state of the session's running work ("the third run ... is still on the pod", about a job
# that had already failed). Neither message, the message it pointed at, nor a hand-back
# named an ask, so no juror sat. The work was named all the same: the asks checklist's
# `carried` rows (`carry_forward`) are the ledger's open issues, each with its id and the
# user's own words. Those words are classified like any message, and the senses they
# summon are this turn's docket. It is the ledger the session keeps, never the
# newest-issue guess `served_ask` refuses to make.
#
# THE LAST DOCKET, NEVER THE FIRST. The turn's own words, the ask an injected turn serves,
# the message a peer's pointer names and a message delivered mid-turn all come first, and
# `wf-widen.docket_hits` reads this only when every one of them was empty. Its hits are
# marked `carried` and JURY-ONLY: the turn asked nothing, so a zero channel count is no
# fact about it, and an open `incident` issue does not seat the four incident jurors on a
# later turn that diagnosed nothing (`wf-widen.seating`). The jury is told the senses came
# from these issues (`ask.carried`) and tries the claims the turn made about that work.
#
# MEASURED over the 40 newest mutze-studio transcripts (1,322 Stops): 19.5 more seated
# juries per 100 Stops counting the issues still open in the ledger today, 34.5 counting
# every earlier issue that held an item; the live rate lies between. Of ten newly seated
# Stops read by hand, nine made a claim about the state or result of open work; one only
# asked the user a question.
CARRIED_PROMPT_MAX = 400


def carried_docket(led, skip=None):
    """`{"hits", "issues"}` for the open issues this turn carries (`carry_forward`), or None
    when none of their words summon a sense. `skip` is this message's own issue.

    Newest issue first, one hit per kind, each marked with the issue it came from.
    `issues` holds only the issues that contributed a hit, with their words cut to
    `CARRIED_PROMPT_MAX`, for the jury."""
    by_id = {i.get("id"): i for i in led.get("issues", []) if isinstance(i, dict)}
    hits, issues, seen = [], [], set()
    for iid in dict.fromkeys(r["issue"] for r in carry_forward(led, skip=skip)):
        words = (by_id.get(iid) or {}).get("prompt")
        found = classify(words) if isinstance(words, str) else []
        if not found:
            continue
        # AN ISSUE A PEER OPENED SAYS SO: its words are the peer's, never the user's.
        peer = by_id[iid].get("peer")
        issues.append({"issue": iid, "title": plain_text(by_id[iid].get("title"), TITLE_MAX),
                       "prompt": plain_text(words, CARRIED_PROMPT_MAX),
                       **({"peer": peer_sender(peer)} if isinstance(peer, dict) else {})})
        for h in found:
            if h["kind"] not in seen:
                seen.add(h["kind"])
                hits.append(dict(h, carried=iid))
    return {"hits": hits, "issues": issues} if hits else None


# ─────────────────────────────────────────────────────────────────────────────────
# THE DIRECTIVE CHECK, MOVED OFF THE AGENT AND ONTO THIS EVENT (K6).
#
# Every handbook this distribution writes makes the EMPLOYEE hash its own bound directive
# files and STOP on a mismatch (`handbook-templates.md`, `## Directives`). That is a
# correct rule paid for on every order: the agent spends calls reading a file and running
# a hash before it can begin, and it spends them again on the next order, and the answer
# is the same every time until somebody edits the file.
#
# IT ALSO FAILED IN THE DIRECTION THAT COSTS MOST. An audit wrote a WRONG sha into
# `business-analyst`'s handbook and every order that employee was given from 2026-08-06 to
# 2026-09-04 stopped on arrival — through 13 audits, because a self-check can only report
# the drift to the one agent that is already halted by it
# (`DEF-2026-09-04-business-analyst-directive-sha-drift.md`).
#
# SO THE HASH HAPPENS HERE, ONCE PER SPAWN, AND THE ANSWER IS INJECTED. `SubagentStart` is
# the only user-scope carrier that reaches an employee (a subagent runs its own system
# prompt), and it fires before the agent's first turn, so a verdict stated here arrives in
# time to save the reads rather than grade them. A drift therefore surfaces on the FIRST
# spawn in any project, in the context of whoever reads the spawn, without an audit.
#
# IT NEVER BLOCKS AND IT NEVER GUESSES. No handbook, no readable handbook, no declared
# directive, or a file too large to hash under the caps below → NOTHING is injected and the
# employee's own self-check runs exactly as it does today. That is the whole compatibility
# story for projects whose handbooks predate this: the line makes the check cheap, never
# wrong.

# THE AGENT TYPE IS HARNESS-SUPPLIED TEXT AND IT NAMES A FILE, so it is narrowed to ONE
# filename component by ALLOWLIST rather than by stripping what looks dangerous —
# `session_component`'s rule one directory over. `..`, `a/b`, `/etc/passwd` and a leading
# dot all fail to match, and a real agent type (`engineering-coder`) passes unchanged.
_AGENT_TYPE_OK = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")


def bare_name(name):
    """True when `name` is safe to join into a path as ONE component.

    `wf-turn-budget.bare`'s rule, which also takes an `agent_type` out of a hook payload
    and also builds a path from it. It is restated here rather than imported because these
    two hooks are separate programs with no import edge between them, and the one edge in
    this family (`wf-widen` importing this file) exists because the two halves share STATE.
    The `..` test is redundant against the pattern and is kept for the reason it is kept
    there: a path component is the one input where two independent refusals are cheaper
    than one subtle argument about whether the pattern covers every spelling.
    """
    return (isinstance(name, str) and ".." not in name
            and bool(_AGENT_TYPE_OK.match(name)))

# THE DECLARED FORM, as `handbook-templates.md` writes it into `## Directives`:
#
#     - `.claude/workforce/directives/<skill>.md` — sha `<64 hex>` — <N> block(s)
#
# The sha is accepted bare or `sha256:`-prefixed, because the ORG-RECORD comment carries
# the prefix and the section bullet does not. A handbook that says `(none bound)`, or the
# TEMPLATE itself with its `<directives-sha>` placeholder, matches nothing — which is the
# correct reading of both: there is no declared sha to verify.
_DECLARED_RX = re.compile(r"^-\s+`([^`\n]+)`[^`\n]*`(?:sha256:)?([0-9a-fA-F]{64})`", re.M)

# CAPS, because this runs on EVERY spawn. Only the files the handbook DECLARES are hashed,
# at most MAX_DIRECTIVES of them, and a file over its cap is not read at all rather than
# read in part — a partial read would hash to a mismatch and report a drift that is not
# there. A handbook is ~12 KB and a directive file ~2 KB; both caps are far above the real
# sizes and exist to bound the worst case, not to classify the normal one.
MAX_HANDBOOK_BYTES = 256 * 1024
MAX_DIRECTIVE_BYTES = 1024 * 1024
MAX_DIRECTIVES = 8
# AND THE DECLARED PATH IS BOUNDED BEFORE IT IS ECHOED, because the drift line quotes it
# back into the spawn context: the path is text out of a repository file, and a 10,000-
# character one would be a spawn-context flood written by editing a handbook. A real one is
# ~45 characters, and a truncated one stops resolving — which reports as a drift, the
# correct direction for a pointer nobody can follow (security review 2026-10-12).
MAX_PATH_CHARS = 200

# THE TWO LINES. `directives verified` is the literal the handbook template names, so the
# employee can match on it; keep the two in step or the template's skip clause stops
# resolving.
DIRECTIVES_VERIFIED = (
    "Your handbook's bound directive files were hashed at this spawn and every declared "
    "sha matched: directives verified — the `## Directives` self-check is already done, "
    "so skip it rather than re-reading and re-hashing those files."
)


def _read_capped(path, cap):
    """The bytes at `path`, never through a symlink, or None.

    None covers every refusal there is — absent, unreadable, a planted link, or larger
    than `cap` — because the caller treats them identically: it does not know the file's
    content, so it does not claim to. `_open_nofollow` is the ledger's helper and the
    reason a link planted AT the name is refused instead of followed (CWE-59).
    """
    try:
        fd = _open_nofollow(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(cap + 1)
    except OSError:
        return None
    return None if len(data) > cap else data


def _inside(root, path):
    """True when `path` RESOLVES inside `root`. Both sides are resolved, never compared as
    text.

    This is the half `O_NOFOLLOW` cannot do. The flag refuses a link at the final
    component; it says nothing about a link at an intermediate directory, and nothing at
    all about a handbook that spells `../../../etc/shadow` as its directive path. A
    declared directive is the HANDBOOK's text, so it is the one input here that an edit to
    a repository file can aim anywhere on the filesystem — and a hook that hashed whatever
    it was pointed at would report the contents of files outside the project through the
    sha it printed.
    """
    try:
        r = os.path.realpath(root)
        p = os.path.realpath(path)
    except OSError:
        return False
    return p == r or p.startswith(r + os.sep)


def handbook_path(root, payload):
    """`<root>/.claude/agents/<agent_type>.md`, or None when that is not one safe name.

    THE MAPPING IS THE HARNESS'S, not this file's invention: a subagent definition lives at
    `.claude/agents/<name>.md` and its frontmatter `name:` is the `agent_type` the payload
    carries, which is how `engineering-coder` resolves to
    `.claude/agents/engineering-coder.md`.
    """
    at = str(payload.get("agent_type") or "").strip()
    if not bare_name(at):
        return None
    p = os.path.join(root, ".claude", "agents", at + ".md")
    return p if _inside(root, p) else None


def declared_directives(body):
    """The `(path, declared-sha)` pairs the handbook's `## Directives` section declares.

    Scoped to that section rather than to the whole file, so a sha quoted in a procedure
    table or in a cold-read probe elsewhere in the handbook is not verified as though the
    role were bound by it.
    """
    i = body.find("\n## Directives")
    if i < 0:
        return []
    j = body.find("\n## ", i + 1)
    seg = body[i:j if j > 0 else len(body)]
    return [(p.strip()[:MAX_PATH_CHARS], s.lower())
            for p, s in _DECLARED_RX.findall(seg)][:MAX_DIRECTIVES]


def directive_line(payload):
    """ONE line for the starting employee about its bound directives, or "" for silence.

    Verified, or `DRIFT:` naming the file, the declared sha and the actual one. Silence is
    the answer whenever this event cannot KNOW — see the section note above — and silence
    leaves the employee's own self-check in charge.
    """
    root = project_root(payload)
    if not root:
        return ""
    hb = handbook_path(root, payload)
    if not hb:
        return ""
    body = _read_capped(hb, MAX_HANDBOOK_BYTES)
    if body is None:
        return ""
    declared = declared_directives(body.decode("utf-8", "replace"))
    if not declared:
        return ""

    drift = []
    for rel, want in declared:
        path = os.path.join(root, rel)
        if not _inside(root, path):
            # REFUSED, AND REPORTED AS A DRIFT RATHER THAN AS SILENCE. A handbook pointing
            # its directive outside the project is not a file this hook failed to read; it
            # is a handbook nobody should act on.
            drift.append(f"DRIFT: {rel} declared {want} actual (outside project)")
            continue
        data = _read_capped(path, MAX_DIRECTIVE_BYTES)
        if data is None:
            drift.append(f"DRIFT: {rel} declared {want} actual (missing)")
            continue
        got = hashlib.sha256(data).hexdigest()
        if got != want:
            drift.append(f"DRIFT: {rel} declared {want} actual {got}")
    if not drift:
        return DIRECTIVES_VERIFIED
    # STATED AS A FACT ABOUT THE FILES, with the STOP named as the handbook's own rule —
    # which is what makes this line work in a project whose handbooks predate it.
    return (" ".join(drift) + " — the declared sha is not what this spawn found, which is the "
            "`## Directives` STOP: report `DIRECTIVE-DRIFT: <path>` and act on no directive "
            "until the operator settles which of the two is wrong.")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return 0

    # A SPAWNED AGENT GETS THE USER-WORDS RULE AND THE CLEANUP RULE. Returned before the
    # widen flag is cleared: a subagent starting mid-turn is not the head of a turn, and
    # clearing there would drop a flag the main session's `Stop` still needs.
    #
    # NOT `CHOOSER_RULE`, and the asymmetry is deliberate: a subagent has no user to ask
    # and no `AskUserQuestion`. NOT `TERMINAL_TEXT_RULE` either, for the same reason: a
    # subagent writes to its caller, never to the user's terminal. `CLEANUP_RULE` is the
    # opposite case — the employee is exactly where the shell hangs and the missing-tool
    # workaround happen, and it is the only text that reaches it, because a subagent runs
    # its own system prompt.
    #
    # IT ALSO GETS ITS OWN SLOT, which is the one thing this event can do that no later one
    # can: see `open_agent_tag`. The main session's tag is NOT touched here — this branch
    # returns before the widen flag is cleared and before `start_checklist`, because a
    # subagent starting mid-turn is not the head of a turn.
    if payload.get("hook_event_name") == "SubagentStart":
        open_agent_tag(payload)
        # AND IT IS LINKED TO THE ISSUE BEING WORKED (K2c), under its own `agent_id`, with
        # state `running`. This is the one event that knows an agent started in this
        # session, so it is the only place the link can be made before the agent's
        # hand-back needs somewhere to land. A failure here is silent: the ledger is a
        # record, and no record is worth erasing a spawn over.
        try:
            _led = load_ledger(payload)
            if link_agent(payload, _led):
                save_ledger(payload, _led)
        except OSError:
            pass
        # AND ITS DIRECTIVES ARE HASHED HERE RATHER THAN BY THE AGENT (K6). Never fatal:
        # a raising verdict would be a hook that erases a spawn over a file it could not
        # read, and silence already means "the employee's own self-check stands".
        try:
            _dir_line = directive_line(payload)
        except OSError:
            _dir_line = ""
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "SubagentStart",
            "additionalContext": "\n\n".join(
                x for x in (USER_WORDS, CLEANUP_RULE, _dir_line) if x),
        }}))
        return 0

    # A PEER SESSION'S REQUEST IS READ AS ITS BODY FROM HERE ON (`peer_request`), so every
    # gate below — `opens_issue`, `classify`, `count_asks`, the checklist and the issue — sees
    # the ask a user's message would give it, and the sender rides along as `peer`.
    _peer = peer_request(payload.get("prompt"))
    if _peer:
        payload = dict(payload, prompt=_peer[0], peer=_peer[1])

    # CLEAR LAST TURN'S WIDEN FLAG FIRST, and do it before anything can return early.
    # The flag tells the widening agent to go open a sense; one left behind would send
    # a reader after a question the user has already moved past, and would do it on a
    # turn that raised no flag of its own — a widening nobody asked for, charged to
    # somebody's token budget. This event is the head of every turn, so it is the one
    # place a per-turn artifact can be guaranteed cleared.
    try:
        d = payload.get("scratchpad_dir") or os.environ.get("TMPDIR") or "/tmp"
        sid = session_component(payload)
        os.remove(os.path.join(d, f"wf-widen-flag.{sid}.json"))
    except OSError:
        pass

    # Read before either write below replaces the tag that holds it. ITS RECORD IS KEPT as
    # the new tag's `earlier`, because a queued message's submit lands before the running
    # turn's Stop (`earlier_records`).
    _old_tag = read_json_nofollow(tag_path(payload))
    earlier = earlier_records(_old_tag)
    _notes = {}
    checklist_line, checklist_record = start_checklist(
        payload, previous_checklist(payload, _old_tag), earlier, _notes)
    # A REPEAT DELIVERY'S TAG SAYS SO, and `earlier_records` drops it when it is replaced.
    _repeat = {"repeat_of": _notes["repeat_of"]} if _notes.get("repeat_of") else {}

    hits = classify(payload.get("prompt") or "")
    # AN INJECTED TURN CARRIES THE DOCKET OF THE ISSUE IT SERVES (`served_ask`): the hits
    # are the USER's words classified, marked `inherited`, and `docket_from` names where
    # they came from. `prompt` stays the injected text, which `wf-widen` reads to know a
    # notification opened the turn.
    docket_from = None
    if not hits:
        hits, docket_from = inherited_hits(payload, payload.get("prompt") or "")
    if not hits:
        # AN UNTAGGED TURN MUST NOT INHERIT THE LAST ONE'S TAG. Returning here without
        # clearing left the previous turn's tag file on disk, and `wf-widen` read it at
        # `Stop` as though it belonged to this turn.
        #
        # MEASURED 2026-09-09, on a message with no technical content at all — "tunnel
        # vision is never fun and it shouldn't be for you". It matched none of the four
        # kinds, inherited `behaviour` from the turn before, and was blocked for not
        # running a shell command to close a remark about tunnel vision. A guard that
        # fires on a turn carrying no claim is the 7.0% noise that retired
        # `wf-speak-guard`, arriving by a different route: not a bad detector, but a
        # correct detector reading last turn's input.
        # WRITE AN EMPTY TAG, NEVER DELETE. Removing the file solved the stale-tag bug
        # and created a worse one: `Stop` then has no record that this turn happened at
        # all, and no `prompt` — so an untagged turn can never be audited, because the
        # jury correctly refuses a case with no ask. A fresh, explicitly-empty tag fixes
        # the staleness just as well (it IS this turn's) and keeps the ask on disk for
        # the blind sample in `wf-widen` (§ THE BLIND SAMPLE).
        _n, _how = count_asks(payload.get("prompt") or "")
        # THE OPEN WORK THIS TURN CARRIES, kept for `Stop` as the last docket
        # (`carried_docket`). Never fatal: an unreadable ledger only means no fallback.
        try:
            _carried = carried_docket(load_ledger(payload),
                                      skip=(checklist_record or {}).get("issue"))
        except (OSError, ValueError):
            _carried = None
        write_json_atomic(tag_path(payload),
                          {"hits": [], "prompt": (payload.get("prompt") or "")[:2000],
                           "senses": [], "asks": _n, "asks_why": _how,
                           "checklist": checklist_record, "earlier": earlier,
                           **({"carried_docket": _carried} if _carried else {}),
                           **({"peer": _peer[1]} if _peer else {}), **_repeat})
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": "\n\n".join(
                x for x in (USER_WORDS, CHOOSER_RULE, TERMINAL_TEXT_RULE, CLEANUP_RULE,
                            checklist_line) if x),
        }}))
        return 0

    # Never fatal: the injection below still lands, and the Stop half degrades quietly.
    write_json_atomic(tag_path(payload),
                      {"hits": hits,
                       # THE ASK ITSELF, carried forward because `Stop` never gets it.
                       # The Stop payload has no `prompt` field, so the judge was
                       # comparing evidence to conclusion with NO IDEA what was asked —
                       # the measure-results directive implemented with the request
                       # missing. This event is the only one that sees it.
                       "prompt": (payload.get("prompt") or "")[:2000],
                       # THE JURY DOCKET: which senses sit on this ask.
                       "senses": sorted({h["sense"] for h in hits}),
                       # HOW MANY THINGS WERE ASKED, and the evidence for the number.
                       # A reply to a multi-ask prompt carries a heading per ask; one
                       # blended answer to three questions is how a reader loses track
                       # of which were addressed, and re-reading it later is worse.
                       "asks": count_asks(payload.get("prompt") or "")[0],
                       "asks_why": count_asks(payload.get("prompt") or "")[1],
                       # THE CHECKLIST RECORD: the user's prompt and whether a `Stop` has
                       # ended its turn. Kept here, in a file this hook writes, and never in
                       # the checklist file the session edits.
                       "checklist": checklist_record,
                       "earlier": earlier,
                       **({"docket_from": docket_from} if docket_from else {}),
                       **({"peer": _peer[1]} if _peer else {}), **_repeat})

    # STATED AS FACTS ABOUT THE ASK, NEVER AS AN INSTRUCTION. The hooks reference is
    # explicit that text framed as an out-of-band command trips the prompt-injection
    # defences and gets surfaced to the user instead of read — which would turn a tag
    # into one more thing a human has to deal with.
    #
    # TRUE IN EVERY PROJECT. This text reaches every user's session, so it says what holds of
    # the kind of ask, never what is on record in the reader's project: until 2026-11-10 it
    # said "on record in this project", which was this repository's history read out as the
    # reader's own.
    lines = [USER_WORDS, "", CHOOSER_RULE, "", TERMINAL_TEXT_RULE, "", CLEANUP_RULE, "",
             "This ask is of a kind whose wrong answers are well documented."]
    if docket_from:
        lines[-1] = ("This message is not the user's: it carries the work of the user's ask"
                     + (f" on issue {docket_from['issue']}" if docket_from.get("issue") else "")
                     + ", and that ask is of a kind whose wrong answers are well documented.")
    for h in hits:
        lines.append(f"  · {h['kind']} — closed by {h['sense'].upper()}: {h['why']}. "
                     f"In practice: {SENSE_HOW[h['sense']]}.")
    if os.path.isfile(SENSES_DOC):
        lines.append(f"Senses are described at `{SENSES_DOC}`.")
    if checklist_line:
        lines += ["", checklist_line]

    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": "\n".join(lines),
    }}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
